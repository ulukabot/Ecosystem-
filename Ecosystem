void GuardianAngel(int magic, double emergencyDDPercent,
                   CTrade &tradeObj, string telegramChatId, string tgApi)
{
   if(MQLInfoInteger(MQL_TESTER)) return;

   // ─── FIX 1: Skip if no open positions with this magic number ───
   bool hasPosition = false;
   for(int i = 0; i < PositionsTotal(); i++)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket))
      {
         if(PositionGetInteger(POSITION_MAGIC) == magic)
         {
            hasPosition = true;
            break;
         }
      }
   }

   if(!hasPosition)
   {
      // If no open positions, we can also reset the lock flag if it was set
      if(G_FloatingDD_Lock)
      {
         G_FloatingDD_Lock = false;
         if(G_DebugMode) Print("👼 Guardian Angel: No open positions – lock released.");
      }
      return;
   }

   // ─── FIX 2: Cooldown to prevent spam ───
   static datetime lastTriggerTime = 0;
   if(TimeCurrent() - lastTriggerTime < 60) // at least 60 seconds between triggers
   {
      if(G_DebugMode) Print("👼 Guardian Angel: Cooldown active – skipping.");
      return;
   }

   double equity  = AccountInfoDouble(ACCOUNT_EQUITY);
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   if(balance <= 0) return;

   double ddFromBalance = (balance - equity) / balance * 100.0;

   // Emergency shutdown: total DD from balance > emergency threshold
   if(ddFromBalance >= emergencyDDPercent)
   {
      Print("🚨 GUARDIAN ANGEL: Emergency DD triggered! DD: ",
            DoubleToString(ddFromBalance, 2), "% | Threshold: ",
            DoubleToString(emergencyDDPercent, 2), "%");

      // Close all EA positions
      CloseAllEAOrders(tradeObj, magic);

      // Lock trading
      G_FloatingDD_Lock = true;

      // Record trigger time to prevent repeated triggers
      lastTriggerTime = TimeCurrent();

      // Alert via Telegram
      if(telegramChatId != "" && tgApi != "")
      {
         string msg = "👼 <b>GUARDIAN ANGEL ALERT</b>\n\n"
                    + "⚠ Emergency DD triggered!\n"
                    + "DD: " + DoubleToString(ddFromBalance, 2) + "%\n"
