void OnChartEvent(const int id, const long &lparam, const double &dparam, const string &sparam)
{
   // ---- Exit Button ----
   if(id == CHARTEVENT_OBJECT_CLICK && sparam == UI_P + "ExitBtn")
   {
      Print("🔴 Client: Exit button clicked!");   // <-- Debug line
      CloseAllEAOrders(trade, Magic_Number);
      ObjectSetInteger(0, UI_P + "ExitBtn", OBJPROP_STATE, false);
      Alert("🦉 CLIENT: All positions closed.");
   }

   // ---- Sound Toggle Button ----
   if(id == CHARTEVENT_OBJECT_CLICK && sparam == UI_P + "SoundBtn")
   {
      // Toggle state
      g_sound_enabled = !g_sound_enabled;

      // Save to file
      int sfh = FileOpen("Uluka_SoundState.dat", FILE_WRITE|FILE_BIN|FILE_COMMON);
      if(sfh != INVALID_HANDLE)
      {
         FileWriteInteger(sfh, (int)g_sound_enabled);
         FileClose(sfh);
      }

      // Update button text & colour
      string sndBtn = UI_P + "SoundBtn";
      if(ObjectFind(0, sndBtn) >= 0)
      {
         ObjectSetString(0, sndBtn, OBJPROP_TEXT, g_sound_enabled ? "🔊 Sound ON" : "🔇 Sound OFF");
         ObjectSetInteger(0, sndBtn, OBJPROP_BGCOLOR, g_sound_enabled ? C'0,80,0' : C'80,0,0');
      }

      ObjectSetInteger(0, sndBtn, OBJPROP_STATE, false);
      Alert("🦉 Sound is now " + (g_sound_enabled ? "ON" : "OFF"));
      UpdateDashboard();
   }
}

