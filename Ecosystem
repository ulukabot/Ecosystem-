void RecordDNAComboTrade(string comboName, double profit)
{
   if(comboName == "" || comboName == "NONE") return;
   int idx = ComboFindOrAdd(comboName);
   if(idx < 0) return;
   bool isWin = (profit > 0.01);
   if(isWin) { G_ComboWins[idx]++; G_ComboProfit[idx] += profit; }
   else      { G_ComboLosses[idx]++; G_ComboLoss[idx] += MathAbs(profit); }
   G_ComboTotal[idx]++;
}

//+------------------------------------------------------------------+
//| Get combo win rate (0-100)                                       |
//+------------------------------------------------------------------+
double GetComboWinRate(string comboName)
{
   int idx = ComboFindOrAdd(comboName);
   if(idx < 0 || G_ComboTotal[idx] < COMBO_MIN_TRADES) return 0.0;
   return (G_ComboTotal[idx] > 0) ? (double)G_ComboWins[idx] / G_ComboTotal[idx] * 100.0 : 0.0;
}

//+------------------------------------------------------------------+
//| Get combo profit factor (gross profit / gross loss)              |
//+------------------------------------------------------------------+
double GetComboProfitFactor(string comboName)
{
   int idx = ComboFindOrAdd(comboName);
   if(idx < 0 || G_ComboTotal[idx] < COMBO_MIN_TRADES) return 0.0;
   if(G_ComboLoss[idx] <= 0) return 99.0;
   return G_ComboProfit[idx] / G_ComboLoss[idx];
}

//+------------------------------------------------------------------+
//| Get combo risk multiplier (0.5 – 1.2)                            |
//+------------------------------------------------------------------+
double GetComboRiskMultiplier(string comboName)
{
   int idx = ComboFindOrAdd(comboName);
   if(idx < 0 || G_ComboTotal[idx] < COMBO_MIN_TRADES) return 1.0;
   double wr = GetComboWinRate(comboName);
   double pf = GetComboProfitFactor(comboName);
   if(wr > 70.0 && pf > 1.8) return 1.2;
   if(wr > 60.0 && pf > 1.5) return 1.1;
   if(wr < 35.0 && pf < 0.8) return 0.5;
   if(wr < 45.0 && pf < 1.0) return 0.7;
   return 1.0;
}

//+------------------------------------------------------------------+
//| Check if combo should be blocked                                 |
//+------------------------------------------------------------------+
bool ShouldBlockCombo(string comboName)
{
   int idx = ComboFindOrAdd(comboName);
   if(idx < 0 || G_ComboTotal[idx] < COMBO_MIN_TRADES) return false;
   double wr = GetComboWinRate(comboName);
   double pf = GetComboProfitFactor(comboName);
   return (wr < 35.0 && pf < 0.8);
}

//+------------------------------------------------------------------+
//| Get confidence bonus from combo performance (+/-15)              |
//+------------------------------------------------------------------+
int GetComboConfidenceBonus(string comboName)
{
   int idx = ComboFindOrAdd(comboName);
   if(idx < 0 || G_ComboTotal[idx] < COMBO_MIN_TRADES) return 0;
   double wr = GetComboWinRate(comboName);
   double pf = GetComboProfitFactor(comboName);
   if(wr > 70.0 && pf > 1.8) return 15;
   if(wr > 60.0 && pf > 1.5) return 10;
   if(wr > 50.0 && pf > 1.2) return 5;
   if(wr < 30.0 && pf < 0.7) return -15;
   if(wr < 40.0 && pf < 0.9) return -10;
   return 0;
}

//+------------------------------------------------------------------+
//| Build combo name from voting flags                               |
//+------------------------------------------------------------------+
string BuildComboName(ScoreSignalResult &signal, ENUM_ORDER_TYPE tradeType)
{
   string parts = "";
   if(tradeType == ORDER_TYPE_BUY)
   {
      if(signal.obBuy)       parts += "OB ";
      if(signal.fvgBuy)      parts += "FVG ";
      if(signal.bosBuy)      parts += "BOS ";
      if(signal.chochBuy)    parts += "CHoCH ";
      if(signal.farsightBuy) parts += "Farsight ";
      if(signal.visionBuy)   parts += "Vision ";
      if(signal.brBuy)       parts += "BR ";
   }
   else // SELL
   {
      if(signal.obSell)      parts += "OB ";
      if(signal.fvgSell)     parts += "FVG ";
      if(signal.bosSell)     parts += "BOS ";
      if(signal.chochSell)   parts += "CHoCH ";
      if(signal.farsightSell) parts += "Farsight ";
      if(signal.visionSell)  parts += "Vision ";
      if(signal.brSell)      parts += "BR ";
   }
   if(parts == "") return "NONE";
   StringTrimRight(parts);
   return parts;
}

//+------------------------------------------------------------------+
//| Check if a name is a combo (has spaces and multiple strategies) |
//+------------------------------------------------------------------+
bool IsComboName(string name)
{
   if(name == "" || name == "NONE") return false;
   // Known single strategies (these are NOT combos)
   string singles[] = {"Order Block","Fair Value Gap","Break of Structure","Change of Character","Farsight","Close Vision","Liquidity Sweep","Vote-Count","Stay Out"};
   for(int i=0; i<ArraySize(singles); i++)
      if(StringFind(name, singles[i]) >= 0) return false;
   // If it has spaces and is not a single, it's likely a combo
   return (StringFind(name, " ") >= 0);
}

