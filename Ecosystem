// The core Compliance Check
bool CheckTierCompliance()
{
   double current_equity = AccountInfoDouble(ACCOUNT_EQUITY);
   double saved_peak = LoadPeakEquity();
   
   // Update peak if equity grows (Hidden Deposit/Scaling protection)
   if(current_equity > saved_peak)
   {
      saved_peak = current_equity;
      SavePeakEquity(saved_peak);
   }

   // Cross-check: Did they outgrow their Licensed_Tier?
   double allowed_max = GetTierCeiling(Licensed_Tier); 
   
   if(saved_peak > allowed_max)
   {
      if(!g_tier_breach_alerted)
      {
         string msg = "🦉 SECURITY: Account outgrown " + EnumToString(Licensed_Tier) +
                      " (Peak: $" + DoubleToString(saved_peak, 2) + "). Upgrade required!";
         Alert(msg);
         Print(msg);
         Custom_Alert("TIER_BREACH", msg);
         g_tier_breach_alerted = true;
      }
      return false; // ← block all trades
   }

   // Current equity check (live deposit detection)
   if(current_equity > allowed_max)
   {
      if(!g_tier_breach_alerted)
      {
         Print("⛔ Live equity $", DoubleToString(current_equity, 2),
               " exceeds tier ceiling $", DoubleToString(allowed_max, 0));
         g_tier_breach_alerted = true;
      }
      return false; // ← block all trades
   }

   g_tier_breach_alerted = false;
   return true; // ← allow trading
}

//+------------------------------------------------------------------+
//| CUSTOM ALERT WITH COOLDOWN                                        |
//+------------------------------------------------------------------+
void Custom_Alert(string alert_key, string message)
{
   if(!Show_OnScreen_Alerts) return;

   static string   last_keys[];
   static datetime last_times[];
   static int      total_tracked = 0;

   int found = -1;
   for(int i = 0; i < total_tracked; i++)
      if(last_keys[i] == alert_key) { found = i; break; }

   if(found == -1)
   {
      total_tracked++;
      ArrayResize(last_keys,  total_tracked);
      ArrayResize(last_times, total_tracked);
      found = total_tracked - 1;
      last_keys[found]  = alert_key;
      last_times[found] = 0;
   }

   // --- COOLDOWN LOGIC BLOCK ---
   if(TimeCurrent() - last_times[found] >= Alert_Cooldown_Seconds)
   {
      Alert("🦉 Master: " + message);
      
      // ✅ Add the hoot here. It will respect the Alert_Cooldown_Seconds.
      if(g_sound_enabled) PlaySound("::Files\\hoot.wav"); 

      last_times[found] = TimeCurrent();
   }
}

