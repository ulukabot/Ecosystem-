//+------------------------------------------------------------------+
//| AMD Phase Detection (Accumulation → Manipulation → Distribution) |
//| Throttled: prints once per new bar                               |
//+------------------------------------------------------------------+
ENUM_MARKET_PHASE GetAMDPhase(string symbol, ENUM_TIMEFRAMES tf)
{
   // Get ATR values
   int atrHandle = iATR(symbol, tf, 14);
   double atr[];
   ArrayResize(atr, 50);
   ArraySetAsSeries(atr, true);
   if(CopyBuffer(atrHandle, 0, 0, 50, atr) < 50) { IndicatorRelease(atrHandle); return PHASE_UNKNOWN; }
   IndicatorRelease(atrHandle);

   // Volatility shrinking: current ATR(20) < 0.8 * ATR(50)
   double atr20 = 0, atr50 = 0;
   for(int i = 0; i < 20; i++) atr20 += atr[i];
   for(int i = 0; i < 50; i++) atr50 += atr[i];
   atr20 /= 20; atr50 /= 50;
   bool volShrink = atr20 < atr50 * 0.8;

   // Range tightness: average (high-low)/ATR over last 10 candles < 0.5
   double high[], low[];
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   if(CopyHigh(symbol, tf, 0, 20, high) < 20 || CopyLow(symbol, tf, 0, 20, low) < 20)
      return PHASE_UNKNOWN;
   double sumRatio = 0;
   for(int i = 0; i < 10; i++) {
      double range = high[i] - low[i];
      if(atr[i] > 0) sumRatio += range / atr[i];
   }
   bool tightRange = (sumRatio / 10) < 0.5;

   // ADX < 20 (no strong trend)
   int adxHandle = iADX(symbol, tf, 14);
   double adxVal[1];
   bool noTrend = true;
   if(CopyBuffer(adxHandle, 0, 0, 1, adxVal) == 1) noTrend = adxVal[0] < 20;
   IndicatorRelease(adxHandle);

   if(volShrink && tightRange && noTrend) return PHASE_ACCUMULATION;

  
   static double rangeHigh = 0, rangeLow = 0;
   static datetime lastPhaseCheck = 0;
   if(TimeCurrent() - lastPhaseCheck > 60) {
      double highest = high[ArrayMaximum(high, 10, 10)];
      double lowest  = low[ArrayMinimum(low, 10, 10)];
      rangeHigh = highest;
      rangeLow  = lowest;
      lastPhaseCheck = TimeCurrent();
   }
   double currentPrice = SymbolInfoDouble(symbol, SYMBOL_BID);
   if(rangeHigh > 0 && currentPrice > rangeHigh + 2 * atr[0]) return PHASE_DISTRIBUTION;
   if(rangeLow > 0  && currentPrice < rangeLow - 2 * atr[0]) return PHASE_DISTRIBUTION;

   ENUM_MARKET_PHASE phase = PHASE_UNKNOWN;

   // ========================
   // THROTTLED LOGGING (once per new bar)
   // ========================
   static datetime lastBarTime = 0;
   datetime currentBar = iTime(symbol, tf, 0);
   if(currentBar != lastBarTime)
   {
      string phaseStr = "";
      switch(phase)
      {
         case PHASE_ACCUMULATION: phaseStr = "ACCUMULATION"; break;
         case PHASE_MANIPULATION: phaseStr = "MANIPULATION"; break;
         case PHASE_DISTRIBUTION: phaseStr = "DISTRIBUTION"; break;
         default:                 phaseStr = "UNKNOWN";
      }
   if(G_DebugMode) Print("🔄 AMD Phase: ", phaseStr, " | Symbol: ", symbol, " | TF: ", EnumToString(tf));
      lastBarTime = currentBar;
   }

   return phase;
}

// =============================================================
// SECTION 20 — PIVOT POINTS (EXPANDED — R2/S2 added)
// =============================================================

PivotPoints GetDailyPivots(string symbol)
{
   PivotPoints p;
   double high  = iHigh(symbol,  PERIOD_D1, 1);
   double low   = iLow(symbol,   PERIOD_D1, 1);
   double close = iClose(symbol, PERIOD_D1, 1);

   p.P  = (high + low + close) / 3.0;
   p.R1 = 2.0 * p.P - low;
   p.R2 = p.P + (high - low);
   p.S1 = 2.0 * p.P - high;
   p.S2 = p.P - (high - low);

   return p;
}

