   {
      g_daily_limit_hit = true;
      Print("? Daily DD limit was hit today — trading blocked until midnight");
      Custom_Alert("DailyLoss", "Daily DD active — no new trades until midnight");
   }


   if(!g_licence_valid && !MQLInfoInteger(MQL_TESTER))
      return(INIT_FAILED);

   // 3. Cloud sync
   if(Enable_Cloud_Reporting)
      if(!MQLInfoInteger(MQL_TESTER) || !Test_Skip_Cloud)
       SyncWithCloud(RAILWAY_URL);
       SendOpenPositions();  // T-37B


   // 5. Initial deposit tracking
   string dep_file = "Uluka_InitDeposit_C_" + IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN)) + ".dat";
   int dh = FileOpen(dep_file, FILE_READ|FILE_TXT|FILE_COMMON);
   if(dh != INVALID_HANDLE)
   {
      g_initial_deposit = StringToDouble(FileReadString(dh));
      FileClose(dh);
   }
   else
   {
      g_initial_deposit = AccountInfoDouble(ACCOUNT_BALANCE);
      dh = FileOpen(dep_file, FILE_WRITE|FILE_TXT|FILE_COMMON);
      if(dh != INVALID_HANDLE)
      {
         FileWriteString(dh, DoubleToString(g_initial_deposit, 2));
         FileClose(dh);
      }
   }

   // 6. Load today's stats
   MqlDateTime ts; TimeToStruct(TimeCurrent(), ts);
   datetime today_start = StringToTime(StringFormat("%04d.%02d.%02d 00:00", ts.year, ts.mon, ts.day));
   g_current_day      = today_start;
   g_day_start_equity = AccountInfoDouble(ACCOUNT_BALANCE);

   string stats_file = "Uluka_C_DailyStats_" + TimeToString(today_start, TIME_DATE) + ".dat";
   int sh = FileOpen(stats_file, FILE_READ|FILE_BIN|FILE_COMMON);
   if(sh != INVALID_HANDLE)
   {
      g_daily_realized_pnl = FileReadDouble(sh);
      g_daily_trades_Count = FileReadInteger(sh);
      g_daily_wins         = FileReadInteger(sh);
      g_daily_losses       = FileReadInteger(sh);
      FileClose(sh);
   }
   
   g_CurrentTimeframe = GetModeTimeframe(Trade_Mode);
g_HTFTimeframe     = GetModeHTF(Trade_Mode);

   // 7. Indicators
   // 7. Indicators (FULLY AUTOMATIC — no manual input)
   int p = Speed;
   double d = Strength;
   
   ENUM_MARKET_REGIME regime = DetectMarketRegime(_Symbol, g_CurrentTimeframe);
   if(regime == REGIME_TRENDING)
   {
      p = 24;
      d = 0.9;
      Print("🦉 Auto Mode: AGGRESSIVE (Fast indicators) — Trending market");
   }
   else
   {
      p = Speed;
      d = Strength;
      Print("🦉 Auto Mode: CONSERVATIVE (Slow indicators) — Ranging/Low volatility market");
   }
   
   handle_bb  = iBands(_Symbol, g_CurrentTimeframe, p, 0, d, PRICE_CLOSE);
   handle_atr = iATR(_Symbol,  g_CurrentTimeframe, 11);
   handle_maFast = iMA(_Symbol, g_CurrentTimeframe, 10, 0, MODE_EMA, PRICE_CLOSE);
   handle_maSlow = iMA(_Symbol, g_CurrentTimeframe, Speed, 0, MODE_EMA, PRICE_CLOSE);
   if(handle_bb == INVALID_HANDLE || handle_atr == INVALID_HANDLE ||
      handle_maFast == INVALID_HANDLE || handle_maSlow == INVALID_HANDLE)
      return(INIT_FAILED);

   // ─── DYNAMIC FALLBACK STRATEGY ──────────────────────────────
   // ✅ ADD THIS ENTIRE BLOCK RIGHT HERE
   g_last_trade_strategy = GetRecommendedStrategy(_Symbol, ORDER_TYPE_BUY, g_CurrentTimeframe);
   if(g_last_trade_strategy == STRATEGY_STAY_OUT)
      g_last_trade_strategy = STRATEGY_FARSIGHT;
   Print("🦉 Fallback strategy initialized to: ", GetStrategyName(g_last_trade_strategy));

   // 8. Trade settings
   trade.SetExpertMagicNumber(Magic_Number);
   int slippagePoints = Max_Slippage * GetPipMultiplier(_Symbol);
trade.SetDeviationInPoints(slippagePoints);
   // 9. Load stealth levels
   int slh = FileOpen("stealth_levels_C.dat", FILE_READ|FILE_BIN|FILE_COMMON);
   if(slh != INVALID_HANDLE) { FileReadArray(slh, stealth_levels); FileClose(slh); }

   // 10. Prop firm log
   if(Prop_Firm_Mode != PROP_NONE)
   {
      PropFirmLimits lim = GetPropFirmLimits(Prop_Firm_Mode);
      Print("🏆 PROP FIRM MODE: ", GetPropFirmName(Prop_Firm_Mode));
      Print("⛔ Daily Loss Limit: ", lim.maxDailyLossPercent, "%");
      Print("🔻 Max Total DD: ",     lim.maxTotalDrawdownPercent, "%");
      Print("📅 Min Trading Days: ", lim.minTradingDays);
   }

   // 11. Timer + dashboard
   EventSetTimer(300);

   // 11b. Activation alert to cloud
   if(g_licence_valid && !MQLInfoInteger(MQL_TESTER) && !Test_Skip_Cloud
      && Enable_Cloud_Reporting)
   {
      string payload = "{";
      payload += "\"type\":\"ActivationAlert\",";
      payload += "\"source\":\"CLIENT\",";
      payload += "\"client\":\"" + g_client_name + "\",";
      payload += "\"account\":\"" + IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN)) + "\",";
      payload += "\"broker\":\"" + AccountInfoString(ACCOUNT_COMPANY) + "\",";
      payload += "\"balance\":\"" + DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2) + "\",";
      payload += "\"equity\":\"" + DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY), 2) + "\",";
      payload += "\"symbol\":\"" + _Symbol + "\",";
      payload += "\"prop\":\"" + GetPropFirmName(Prop_Firm_Mode) + "\",";
      payload += "\"personal_chat_id\":\"" + Personal_Chat_ID + "\",";
      payload += "\"instance\":\"" + g_instance_id + "\",";
      payload += "\"time\":\"" + TimeToString(TimeCurrent(), TIME_MINUTES) + "\",";
      payload += "\"text\":\"🦉 " + g_client_name + " activated on " + _Symbol + " | "
            + AccountInfoString(ACCOUNT_COMPANY) + " | $"
            + DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2) + "\"";
   payload += "}";

      char data[], result[]; string res_headers;
      int len = StringToCharArray(payload, data, 0, WHOLE_ARRAY, CP_UTF8);
      if(len > 0) ArrayResize(data, len - 1);
      WebRequest("POST", RAILWAY_URL, "Content-Type: application/json\r\n",
                 10000, data, result, res_headers);
   }

   
Print("🦉 Uluka Ultra Pro Client ONLINE | 🧠 SMC Engine: ", Enable_SMC_Strategies ? "ACTIVE" : "OFF");

// Line 2: Mode & Timing Rules
Print("🏆 Prop Mode: ", GetPropFirmName(Prop_Firm_Mode), " | 🕐 Session Filter: ", Enable_Session_Filter ? "ACTIVE" : "OFF");


// Line 4: Account Protection & Sweeps (UPDATED)
Print("👼 Guardian Angel: ", Enable_Guardian_Angel ? "ACTIVE" : "OFF");

// Line 5: Trade Management & Scanning
Print("📐 Break-Even: ", Enable_BreakEven ? "ACTIVE" : "OFF", " | 📈 SL Auto-Shift: ", Enable_ATR_Trailing ? "ACTIVE" : "OFF", " | 📡 Scanner: ", Enable_Multi_Pair_Scanner ? "ACTIVE" : "OFF");


   // v18.10: Restore stealth SL/TP from last session
   if(Use_Stealth_SLTP) LoadStealthLevels(stealth_levels, Magic_Number);
   
   CheckTierCompliance();
   
    g_max_lot_cap = Max_Lot_Cap;
    G_Tp1Ratio = TP1_RR_Ratio;
G_Tp2Ratio = TP2_RR_Ratio;
G_DebugMode = Debug_Logs;
    
       // --- Load sound state from file ---
   int sfh = FileOpen("Uluka_SoundState.dat", FILE_READ|FILE_BIN|FILE_COMMON);
   if(sfh != INVALID_HANDLE)
   {
      g_sound_enabled = (bool)FileReadInteger(sfh);
      FileClose(sfh);
      Print("🔊 Sound state loaded: ", g_sound_enabled ? "ON" : "OFF");
   }
   else
   {
      // Fallback to input value
      g_sound_enabled = Enable_Sound_Notifications;
      Print("🔊 Sound state using input: ", g_sound_enabled ? "ON" : "OFF");
   }
   
   // ─── RECOVER ON RESTART: If news is active, convert existing positions ───
if(Use_Stealth_SLTP && IsNewsWindowActive())
{
   Print("📰 News active on EA start – ensuring physical SL for all open positions.");
   g_converted_count = 0;
   for(int i = 0; i < ArraySize(stealth_levels); i++)
   {
      ulong ticket = stealth_levels[i].ticket;
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      
      double sl = stealth_levels[i].sl;
      if(sl > 0 && PositionGetDouble(POSITION_SL) <= 0)
      {
         trade.PositionModify(ticket, sl, 0);
         if(g_converted_count < 50)
         {
            g_converted_tickets[g_converted_count] = ticket;
            g_converted_count++;
         }
         Print("🛡️ Recovered conversion for #", ticket);
      }
