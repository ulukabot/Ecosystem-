int ComboFindOrAdd(string comboName)
{
   if(comboName == "" || comboName == "NONE") return -1;
   for(int i=0; i<G_ComboCount; i++)
      if(G_ComboName[i] == comboName) return i;
   if(G_ComboCount >= COMBO_MAX) return -1;
   G_ComboName[G_ComboCount] = comboName;
   G_ComboWins[G_ComboCount] = 0;
   G_ComboLosses[G_ComboCount] = 0;
   G_ComboProfit[G_ComboCount] = 0.0;
   G_ComboLoss[G_ComboCount] = 0.0;
   G_ComboTotal[G_ComboCount] = 0;
   return G_ComboCount++;
}

