               if(g_sound_enabled) PlaySound("::Files\\hoot.wav");
         alertedDaily = true; // Lock the alert
      }
      return false;
   }
   else 
   {
      alertedDaily = false; // Reset flag when equity recovers safely below 80%
   }

   // --- Total Drawdown Logic ---
   if(totalDDPercent >= limits.maxTotalDrawdownPercent * 0.8)
   {
      if(!alertedTotal)
