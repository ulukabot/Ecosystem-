//| MANAGE INTERNAL LEVELS — BE + ATR Trailing + Stealth + Partial   |
//+------------------------------------------------------------------+
void ManageInternalLevels()
{
   // Step 1 — Break-Even, Trailing, Partial Close
   string _managedSyms[];
   for(int _mi = PositionsTotal()-1; _mi >= 0; _mi--)
   {
      ulong _mtk = PositionGetTicket(_mi);
      if(!PositionSelectByTicket(_mtk)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      string _ms = PositionGetString(POSITION_SYMBOL);
      bool _mseen = false;
      for(int _mx=0; _mx<ArraySize(_managedSyms); _mx++)
         if(_managedSyms[_mx] == _ms) { _mseen = true; break; }
      if(!_mseen)
      {
         int _msz = ArraySize(_managedSyms);
         ArrayResize(_managedSyms, _msz + 1);
         _managedSyms[_msz] = _ms;

         // Get position details for this symbol (needed for BE points)
         for(int pos = PositionsTotal()-1; pos >= 0; pos--)
         {
            ulong tkt = PositionGetTicket(pos);
            if(!PositionSelectByTicket(tkt)) continue;
            if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
            if(PositionGetString(POSITION_SYMBOL) != _ms) continue;

            double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
            double openSL    = PositionGetDouble(POSITION_SL);
            double point     = SymbolInfoDouble(_ms, SYMBOL_POINT);
            double sl_dist_points = MathAbs(openPrice - openSL) / point;

            // 1) Break‑Even (convert percentage to points)
            if(Enable_BreakEven)
            {
               double bePointsDouble = (BreakEven_Percent / 100.0) * sl_dist_points;
               int bePoints = (int)MathMax(1, bePointsDouble);
               ManageBreakEven(_ms, Magic_Number, bePoints, trade, stealth_levels, Enable_ATR_Trailing, Use_Stealth_SLTP);
            }

            // 2) ATR Trailing (single call – removed duplicate)
            if(Enable_ATR_Trailing)
            {
               int _trailPts = GetPointsFromPercent(_ms, Trailing_Start_Percent);
               ManageAdaptiveTrailing(_ms, Magic_Number, ATR_Trail_Multiplier, _trailPts, trade, stealth_levels, Use_Stealth_SLTP);
            }

            // 3) Partial Close
            if(Enable_Partial_Close)
            {
               ManagePartialClose(_ms, Magic_Number, trade, TP1_RR_Ratio, TP2_RR_Ratio, Profit_Ratio, stealth_levels, Use_Stealth_SLTP);
            }

            break; // only need one position per symbol to get SL distance
         }
      }
   }

   // ─── 🔥 NEW: Delayed TP2 Lock (20% buffer after TP2) ───
   static ulong tp2_locked_tickets[100];
   static int   tp2_locked_count = 0;

   for(int i = PositionsTotal()-1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;

      // Check if already locked
      bool alreadyLocked = false;
      for(int l=0; l<tp2_locked_count; l++)
         if(tp2_locked_tickets[l] == ticket) { alreadyLocked = true; break; }
      if(alreadyLocked) continue;

      string sym = PositionGetString(POSITION_SYMBOL);
      double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      double currentSL = PositionGetDouble(POSITION_SL);
      
      // Handle stealth mode
      if(Use_Stealth_SLTP && currentSL == 0)
      {
         for(int s=0; s<ArraySize(stealth_levels); s++)
            if(stealth_levels[s].ticket == ticket)
               { currentSL = stealth_levels[s].sl; break; }
      }
      if(currentSL == 0) continue;

      int posType = (int)PositionGetInteger(POSITION_TYPE);
      double point = SymbolInfoDouble(sym, SYMBOL_POINT);
      double slDist = MathAbs(openPrice - currentSL);
      if(slDist <= 0) continue;

      // Compute TP1 and TP2 prices from current SL distance (using globals set from EA inputs)
      double tp1Dist = slDist * G_Tp1Ratio;
      double tp2Dist = slDist * G_Tp2Ratio;
      
      double tp1Price, tp2Price;
      if(posType == POSITION_TYPE_BUY)
      {
         tp1Price = openPrice + tp1Dist;
         tp2Price = openPrice + tp2Dist;
      }
      else
      {
         tp1Price = openPrice - tp1Dist;
         tp2Price = openPrice - tp2Dist;
      }

      // Check if SL is at TP1 level (meaning TP2 has already been hit)
      if(MathAbs(currentSL - tp1Price) > point * 10) continue;

      // Now check if price has exceeded TP2 by 20% buffer
      double bid = SymbolInfoDouble(sym, SYMBOL_BID);
      double ask = SymbolInfoDouble(sym, SYMBOL_ASK);
      double bufferPct = 0.20;
      double threshold;
      if(posType == POSITION_TYPE_BUY)
         threshold = tp2Price + (tp2Price - openPrice) * bufferPct;
      else
         threshold = tp2Price - (openPrice - tp2Price) * bufferPct;

      bool conditionMet = (posType == POSITION_TYPE_BUY) ? (bid >= threshold) : (ask <= threshold);

      if(conditionMet)
      {
         Print("🔒 Delayed TP2 lock | #", ticket, 
               " | Moving SL from TP1 to TP2: ", DoubleToString(tp2Price, _Digits));
         if(Use_Stealth_SLTP)
            UpdateStealthSL(ticket, tp2Price, stealth_levels);
         else
            trade.PositionModify(ticket, tp2Price, PositionGetDouble(POSITION_TP));
         
         if(tp2_locked_count < 100)
         {
            tp2_locked_tickets[tp2_locked_count] = ticket;
            tp2_locked_count++;
         }
      }
   }

   // Step 2 — Sync stealth_levels[] with actual broker SL after BE/trailing
   if(Use_Stealth_SLTP)
   {
      bool changed = false;
      for(int i = 0; i < ArraySize(stealth_levels); i++)
      {
         if(!PositionSelectByTicket(stealth_levels[i].ticket)) continue;
         if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
         double broker_sl = PositionGetDouble(POSITION_SL);
         double _stealthPoint = SymbolInfoDouble(PositionGetString(POSITION_SYMBOL), SYMBOL_POINT);
         if(broker_sl > 0 && MathAbs(broker_sl - stealth_levels[i].sl) > _stealthPoint)
         {
            string updateType = (broker_sl > stealth_levels[i].sl) ? "BE_SET" : "TRAIL_SL";

            // Get symbol and calculate pip size for 25-pip throttling (keep your existing logic)
            string pos_symbol = PositionGetString(POSITION_SYMBOL);
            double point = SymbolInfoDouble(pos_symbol, SYMBOL_POINT);
            double pipSize;
            if(StringFind(pos_symbol, "XAU") >= 0 || StringFind(pos_symbol, "GOLD") >= 0)
               pipSize = 0.01;
            else if(StringFind(pos_symbol, "XAG") >= 0)
               pipSize = 0.001;
            else if(StringFind(pos_symbol, "JPY") >= 0)
               pipSize = 0.01;
            else
               pipSize = point * 10;

            double entry_price = PositionGetDouble(POSITION_PRICE_OPEN);
            double current_stealth_sl = stealth_levels[i].sl;
            double pips_from_entry = MathAbs(current_stealth_sl - entry_price) / pipSize;
            int current_25pip_level = (int)(pips_from_entry / 25);

            // Find tracking index (use your existing arrays g_last_alert_*)
            int alert_idx = -1;
            for(int a = 0; a < g_last_alert_count; a++)
               if(g_last_alert_ticket[a] == stealth_levels[i].ticket) { alert_idx = a; break; }

            if(alert_idx == -1)
            {
               alert_idx = g_last_alert_count;
               if(alert_idx >= 50)
               {
                  for(int a = 0; a < 49; a++)
                  {
                     g_last_alert_ticket[a] = g_last_alert_ticket[a+1];
                     g_last_alert_sl_price[a] = g_last_alert_sl_price[a+1];
                     g_last_alert_pips_level[a] = g_last_alert_pips_level[a+1];
                  }
                  alert_idx = 49;
                  g_last_alert_count = 50;
               }
               else g_last_alert_count++;
               g_last_alert_ticket[alert_idx] = stealth_levels[i].ticket;
               g_last_alert_sl_price[alert_idx] = 0;
               g_last_alert_pips_level[alert_idx] = -1;
            }

            if(alert_idx >= 0 && alert_idx < 50 && alert_idx < g_last_alert_count)
            {
               bool shouldSendAlert = (current_25pip_level != g_last_alert_pips_level[alert_idx]);

               // Throttle print every 100 pips
               static datetime last_print_time[100];
               static ulong last_print_ticket[100];
               static int last_print_pips_level[100];
               static int print_count = 0;
               int print_idx = -1;
               for(int p = 0; p < print_count; p++)
                  if(last_print_ticket[p] == stealth_levels[i].ticket) { print_idx = p; break; }
               if(print_idx == -1)
               {
                  print_idx = print_count;
                  if(print_count < 100) print_count++;
                  last_print_ticket[print_idx] = stealth_levels[i].ticket;
                  last_print_pips_level[print_idx] = -1;
               }
               int current_level = (int)(pips_from_entry / 100);
               if(current_level != last_print_pips_level[print_idx])
               {
                  Print("📡 Stealth SL synced #", stealth_levels[i].ticket,
                        " [", updateType, "]",
                        " | Old:", DoubleToString(stealth_levels[i].sl, _Digits),
                        " → New:", DoubleToString(broker_sl, _Digits),
                        " | Pips: ", DoubleToString(pips_from_entry, 1));
                  last_print_pips_level[print_idx] = current_level;
               }

               stealth_levels[i].sl = broker_sl;
               trade.PositionModify(stealth_levels[i].ticket, 0, stealth_levels[i].tp);

               if(shouldSendAlert && ShouldSendPositionUpdate(stealth_levels[i].ticket))
               {
                  Print("🔔 25-pip alert sent (Level: ", current_25pip_level, ")");
                  SendPositionUpdate(updateType, stealth_levels[i].ticket,
                                    broker_sl, stealth_levels[i].tp,
                                    PositionGetDouble(POSITION_VOLUME));
                  g_last_alert_sl_price[alert_idx] = broker_sl;
                  g_last_alert_pips_level[alert_idx] = current_25pip_level;
               }
            }
            else
            {
               stealth_levels[i].sl = broker_sl;
               trade.PositionModify(stealth_levels[i].ticket, 0, stealth_levels[i].tp);
               if(ShouldSendPositionUpdate(stealth_levels[i].ticket))
                  SendPositionUpdate(updateType, stealth_levels[i].ticket,
                                    broker_sl, stealth_levels[i].tp,
                                    PositionGetDouble(POSITION_VOLUME));
            }
            changed = true;
         }
      }
      if(changed) MarkStealthDirty();
   }

   // Step 3 — Stealth SL/TP enforcement (close trades when levels hit)
   if(!Use_Stealth_SLTP) return;

   for(int i = ArraySize(stealth_levels) - 1; i >= 0; i--)
   {
      ulong ticket = stealth_levels[i].ticket;
      if(!PositionSelectByTicket(ticket))
      {
         ArrayRemove(stealth_levels, i, 1);
         continue;
      }
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;

      string pos_symbol = PositionGetString(POSITION_SYMBOL);
      double bid = SymbolInfoDouble(pos_symbol, SYMBOL_BID);
      double ask = SymbolInfoDouble(pos_symbol, SYMBOL_ASK);
      int pos_type = (int)PositionGetInteger(POSITION_TYPE);
      double curr_sl = stealth_levels[i].sl;
      double curr_tp = stealth_levels[i].tp;

      if(pos_type == POSITION_TYPE_BUY)
      {
         if(bid <= curr_sl || bid >= curr_tp)
         {
            Print("🦉 Stealth Close BUY #", ticket, " | SL:", curr_sl, " TP:", curr_tp);
            trade.PositionClose(ticket);
            ArrayRemove(stealth_levels, i, 1);
         }
      }
      else if(pos_type == POSITION_TYPE_SELL)
      {
         if(ask >= curr_sl || ask <= curr_tp)
         {
            Print("🦉 Stealth Close SELL #", ticket, " | SL:", curr_sl, " TP:", curr_tp);
            trade.PositionClose(ticket);
            ArrayRemove(stealth_levels, i, 1);
         }
      }
   }
}

