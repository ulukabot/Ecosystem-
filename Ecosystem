//+--------------------+
//| MULTI-PAIR SCANNER |
//+--------------------+
void ScanAllPairs()
{
   if(!Enable_Multi_Pair_Scanner) return;
   if(StringLen(Scanner_Symbol_List) == 0) return;
   if(!g_licence_valid) return;
   if(MQLInfoInteger(MQL_TESTER) && Test_Skip_Cloud) return;

   if(TimeCurrent() - g_scanner_last_run < (datetime)(Scanner_Interval_Mins * 60 - 10)) return;
   g_scanner_last_run = TimeCurrent();

   string symbols[];
   int count = StringSplit(Scanner_Symbol_List, ',', symbols);
   if(count == 0) return;

   if(G_DebugMode) Print("📡 Multi-Pair Scanner: checking ", count, " symbols");

   for(int s = 0; s < count; s++)
   {
      string sym = symbols[s];
      StringTrimLeft(sym);
      StringTrimRight(sym);
      if(StringLen(sym) == 0) continue;

      if(!SymbolSelect(sym, true)) { if(G_DebugMode) Print("📡 Scanner: unavailable — ", sym); continue; }

      if(Enable_Session_Filter && !IsSessionAllowed()) { if(G_DebugMode) Print("📡 Scanner: session closed"); break; }

      int pipMultiplier = GetPipMultiplier(sym);
long spreadPts = SymbolInfoInteger(sym, SYMBOL_SPREAD);
int maxSpreadPts = MaxSpread * pipMultiplier;
if(spreadPts > maxSpreadPts)
{
   if(G_DebugMode) Print("📡 Scanner: spread unsafe — ", sym, " spread: ", spreadPts, " pts (", 
                         DoubleToString((double)spreadPts / pipMultiplier, 1), " pips) > limit: ", 
                         MaxSpread, " pips");
   continue;
}

      ENUM_MARKET_REGIME regime = DetectMarketRegime(sym, g_CurrentTimeframe);
      if(regime == REGIME_CHAOTIC || regime == REGIME_LOW_VOL)
      { if(G_DebugMode) Print("📡 Scanner: unfavourable regime — ", sym); continue; }

      int conf = CalculateConfidence(sym, DNA_Boost_Confidence);
int target_scanner_conf = MathMax(Min_Confidence_Score, GetAdaptiveMinConfidence());
if(conf < target_scanner_conf)
{ if(G_DebugMode) Print("📡 Scanner: low confidence ", conf, "% | Target: ", target_scanner_conf, "% — ", sym); continue; }
      ENUM_TREND_BIAS htf = GetHTFBias(sym);
      ENUM_ORDER_TYPE sigType;
      if(htf == BIAS_BULLISH)       sigType = ORDER_TYPE_BUY;
      else if(htf == BIAS_BEARISH)  sigType = ORDER_TYPE_SELL;
      else { if(G_DebugMode) Print("📡 Scanner: HTF neutral — ", sym); continue; }

      if(IsCorrelatedPositionOpen(sym, sigType, Magic_Number))
      { if(G_DebugMode) Print("📡 Scanner: correlation block — ", sym); continue; }

      if(PositionsTotalByMagic(sym, Magic_Number) >= Max_Open_Trades)
      { if(G_DebugMode) Print("📡 Scanner: max positions — ", sym); continue; }

      if(Enable_SMC_Strategies)
      {
         ENUM_STRATEGY strat = GetRecommendedStrategy(sym, sigType);
         if(strat == STRATEGY_STAY_OUT)
         { if(G_DebugMode) Print("📡 Scanner: SMC STAY_OUT — ", sym); continue; }
      }

     if(Enable_AI_Brain && !MQLInfoInteger(MQL_TESTER))
{
   string stratName = Enable_SMC_Strategies ?
                      GetStrategyName(GetRecommendedStrategy(sym, sigType)) : "Uluka Scanner";
   bool aiAllow = ShouldAITrade(sigType, stratName, conf, sym);
         if(Enable_AI_Shadow_Mode)
            Print("SHADOW 🔎 ", sym, ": ", g_last_ai_decision, " | ", g_last_ai_reason);
         else if(!aiAllow)
         { Print("🚫 Claude BLOCKED scanner — ", sym, ": ", g_last_ai_reason); continue; }
      }

      int    h = iATR(sym, g_CurrentTimeframe, 11);
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(h == INVALID_HANDLE || CopyBuffer(h, 0, 0, 1, atrBuf) < 1)
      { IndicatorRelease(h); continue; }
      double atrVal = atrBuf[0];
      IndicatorRelease(h);

      if(G_DebugMode) Print("📡 Scanner SIGNAL: ", sym, " ", EnumToString(sigType), " conf=", conf, "%");
         ScoreSignalResult signal = GetScoreSignal(sym, PERIOD_CURRENT,
                                             SymbolInfoDouble(sym, SYMBOL_BID),
                                             SymbolInfoDouble(sym, SYMBOL_ASK),
                                             handle_bb, handle_maFast, handle_maSlow);
      string scanStrat = Enable_SMC_Strategies ?
                         GetStrategyName(GetRecommendedStrategy(sym, sigType)) :
                         "Farsight (Trend)";
      ExecuteTradeOnSymbol(sym, sigType, atrVal, scanStrat);
   }
}

void ExecuteTradeOnSymbol(string sym, ENUM_ORDER_TYPE type, double atr_v,
                          string stratName = "Uluka Scanner")
{
   // v18.10: Paused gate — scanner respects cloud pause command
   if(g_ea_paused) { Print("📡 Scanner blocked — EA paused"); return; }
   
   if(TimeCurrent() - g_last_trade_time < GetTradeTimeBuffer(g_CurrentTimeframe, Buffer_Time_Multiplier)) return;

   double ask      = SymbolInfoDouble(sym, SYMBOL_ASK);
   double bid      = SymbolInfoDouble(sym, SYMBOL_BID);
   double price    = (type == ORDER_TYPE_BUY) ? ask : bid;
   
   // ======================================================================
   // ✅ ADVANCED ADAPTIVE SL/TP ENGINE (Scanner version – 0.75 to 1.5)
   // ======================================================================

   // --- 1. Base distances ---
   double sl_dist  = atr_v * Risk_Ratio;
   double tp_dist  = sl_dist * Profit_Ratio;

   // --- 2. Session adjustment ---
   double sessionMult = 1.0;
   switch(GetCurrentSession())
   {
      case SESSION_ASIAN:    sessionMult = 0.75; break;
      case SESSION_LONDON:   sessionMult = 0.95; break;
      case SESSION_NEW_YORK: sessionMult = 1.05; break;
      case SESSION_OVERLAP:  sessionMult = 1.20; break;
      default:               sessionMult = 1.00; break;
   }

   // --- 3. Volatility adjustment (ATR ratio) ---
   double atrRatio = GetVolatilityATRMultiplier(sym, PERIOD_H1);
   double adaptiveVolMult = MathMax(0.7, MathMin(1.4, atrRatio));   // Renamed variable

   // --- 4. Trend strength (ADX) ---
   double trendMult = 1.0;
   int adxHandle = iADX(sym, PERIOD_H1, 14);
   if(adxHandle != INVALID_HANDLE)
   {
      double adxVal[];
      ArraySetAsSeries(adxVal, true);
      if(CopyBuffer(adxHandle, 0, 0, 1, adxVal) == 1)
      {
         if(adxVal[0] > 40)      trendMult = 1.25;
         else if(adxVal[0] > 25) trendMult = 1.10;
         else if(adxVal[0] < 15) trendMult = 0.85;
         else                    trendMult = 1.00;
      }
      IndicatorRelease(adxHandle);
   }

   // --- 5. DNA win rate adjustment (gentle ±10%) ---
   double dnaMult = 1.0;
   if(Enable_DNA_Fingerprint)
   {
      int idx = DNA_FindSymbol(sym);
      if(idx >= 0 && G_DNA_TotalTrades[idx] >= 10)
      {
         double winRate = G_DNA_WinRate[idx];
         if(winRate > 70)      dnaMult = 1.10;
         else if(winRate < 40) dnaMult = 0.90;
      }
   }

   // --- 6. Combine and clamp (0.75 – 1.5) ---
   double combinedMultiplier = sessionMult * adaptiveVolMult * trendMult * dnaMult;
   combinedMultiplier = MathMax(0.75, MathMin(1.50, combinedMultiplier));

   // Apply to SL and TP
   sl_dist = atr_v * Risk_Ratio * combinedMultiplier;
   tp_dist = sl_dist * Profit_Ratio;   // keep RR ratio intact
   double sl = (type == ORDER_TYPE_BUY) ? price - sl_dist : price + sl_dist;
   double tp = (type == ORDER_TYPE_BUY) ? price + tp_dist : price - tp_dist;
   int    digits = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);
   sl = NormalizeDouble(sl, digits);
   tp = NormalizeDouble(tp, digits);
   
   double slDistancePoints = MathAbs(price - sl) / SymbolInfoDouble(sym, SYMBOL_POINT);
if(slDistancePoints < MINIMUM_SL_POINTS_ABSOLUTE)
{
   static datetime last_scanner_min_sl_print = 0;
   if(TimeCurrent() - last_scanner_min_sl_print >= 60)
   {
      Print("🚫 Scanner SAFETY BLOCK: SL too tight on ", sym,
            " (", DoubleToString(slDistancePoints, 1), " points < ",
            DoubleToString(MINIMUM_SL_POINTS_ABSOLUTE, 0), " points)");
      last_scanner_min_sl_print = TimeCurrent();
   }
   return;
}

   // --- 9. Throttled log (once every 5 minutes) ---
   static datetime last_scanner_adaptive_print = 0;
   if(TimeCurrent() - last_scanner_adaptive_print >= 300)
   {
      Print("🦉 Scanner Adaptive SL Mult: ", DoubleToString(combinedMultiplier, 2),
            " | SL: ", DoubleToString(sl_dist, digits),
            " | TP: ", DoubleToString(tp_dist, digits));
      last_scanner_adaptive_print = TimeCurrent();
   }

   // ======================================================================

   double tickVal  = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_VALUE);
   double tickSize = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_SIZE);
   double balance  = AccountInfoDouble(ACCOUNT_BALANCE);

   // S30: Daily risk cap check for scanner path
   double scan_daily_limit   = g_day_start_equity > 0
                               ? g_day_start_equity * Daily_Loss_Limit / 100.0
                               : balance * Daily_Loss_Limit / 100.0;
   double scan_floating_dd   = MathMax(0.0, balance - AccountInfoDouble(ACCOUNT_EQUITY));
   double scan_realized_loss = (g_daily_realized_pnl < 0) ? MathAbs(g_daily_realized_pnl) : 0.0;
   double scan_total_exposure = scan_realized_loss + scan_floating_dd;

   if(g_daily_limit_hit || scan_total_exposure >= scan_daily_limit)
   {
      Print("🚫 Scanner blocked — daily risk cap reached | Exposure: $",
            DoubleToString(scan_total_exposure, 2),
            " / Limit: $", DoubleToString(scan_daily_limit, 2));
      return;
   }
   
   // --- GLOBAL POSITION CAP (Scanner) ---
   if(Max_Total_Open_Positions > 0)
   {
      int totalPos = PositionsTotalByMagicAll(Magic_Number);
      if(totalPos >= Max_Total_Open_Positions)
      {
         static datetime last_scanner_global_cap_print = 0;
         if(TimeCurrent() - last_scanner_global_cap_print >= 60)
         {
            Print("🚫 Scanner: Global position cap reached (", Max_Total_Open_Positions,
                  "). Trade blocked on ", sym, ". Current open: ", totalPos);
            last_scanner_global_cap_print = TimeCurrent();
         }
         return;
      }
   }

      // ======================================================================
   // 🔥 HARMONIZED RISK & LOT CALCULATION (Scanner – identical to main)
   // ======================================================================
   
   // 1. Get effective risk (DNA + Governor)
   double effectiveRisk = GetEffectiveRiskPercent();
   if(Enable_DNA_Fingerprint && DNA_Adjust_Risk)
   {
      double dnaMult = GetDNARiskMultiplier(sym);
      if(DNA_Only_Reduce_Risk)
         dnaMult = MathMin(dnaMult, 1.0);
      effectiveRisk *= dnaMult;
   }
   
   // 2. Base risk and profit scaling bonus (identical to main ExecuteTrade)
   double baseRisk = balance * effectiveRisk / 100.0;
   // ─── Profit Scaling with Peak-Profit Drawdown Guard ───
double totalBonus = 0.0;
if(Profit_Scaling_Percent > 0 && G_TodayRealizedProfit > 0)
{
   // Guard: only scale if current P&L is above the retreat threshold
   bool aboveRetreatThreshold = true;
   if(g_daily_peak_profit > 0)
   {
      double retreatLevel = g_daily_peak_profit * (Profit_Scaling_Retreat_Pct / 100.0);
      if(G_TodayRealizedProfit < retreatLevel)
         aboveRetreatThreshold = false;
   }
   if(aboveRetreatThreshold)
   {
      totalBonus = G_TodayRealizedProfit * (Profit_Scaling_Percent / 100.0);
   }
   else
   {
      // Optional: log when scaling pauses (throttled)
      static datetime last_retreat_log = 0;
      if(TimeCurrent() - last_retreat_log > 300)
      {
         Print("⛔ Profit Scaling paused – P&L below ", DoubleToString(Profit_Scaling_Retreat_Pct, 0),
               "% of peak ($", DoubleToString(g_daily_peak_profit, 2), ")");
         last_retreat_log = TimeCurrent();
      }
   }
}
   int totalPairs = CountTotalActivePairs();
   int maxPerPair = MathMax(1, Max_Open_Trades);
   double profitBonus = MathMax(0.0, totalBonus / totalPairs / maxPerPair);
   if(profitBonus > baseRisk * 2.0) profitBonus = baseRisk * 2.0;
   
   // 3. Allowed risk (base + bonus)
   double allowed_risk = baseRisk + profitBonus;
   
   // 4. Apply universal Max_Risk_Multiplier cap (against original user base risk)
   double originalBaseRisk = balance * RISK_Per_Trade_Percent / 100.0;
   if(Max_Risk_Multiplier > 0)
      allowed_risk = MathMin(allowed_risk, originalBaseRisk * Max_Risk_Multiplier);
   
   // 5. Calculate lot size manually
   // Reuse existing tickVal and tickSize (do NOT redeclare with 'double')
   tickVal = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_VALUE);
   tickSize = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_SIZE);
   double point = SymbolInfoDouble(sym, SYMBOL_POINT);
   double stopPts = MathAbs(price - sl) / point;
   if(tickSize <= 0 || tickVal <= 0 || stopPts <= 0) { Print("🚫 Scanner: Invalid tick/stop for ", sym); return; }
   
   double costPerLot = (stopPts * point / tickSize) * tickVal;
   if(costPerLot <= 0) { Print("🚫 Scanner: costPerLot zero for ", sym); return; }
   
   double raw_lot = allowed_risk / costPerLot;
   
   // 6. Normalize to broker rules
   double minLot = SymbolInfoDouble(sym, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(sym, SYMBOL_VOLUME_MAX);
   double stepLot = SymbolInfoDouble(sym, SYMBOL_VOLUME_STEP);
   double final_lot = MathFloor(raw_lot / stepLot) * stepLot;
   final_lot = MathMax(minLot, MathMin(maxLot, final_lot));
   
   // 7. Apply User Max Lot Cap
   if(g_max_lot_cap > 0 && final_lot > g_max_lot_cap)
   {
      final_lot = g_max_lot_cap;
      static datetime last_cap_print = 0;
      if(TimeCurrent() - last_cap_print >= 60)
      {
         if(G_DebugMode) Print("📐 Scanner lot capped to user-defined max (final): ", DoubleToString(final_lot, 2));
         last_cap_print = TimeCurrent();
      }
   }
   
   if(final_lot <= 0.0) { Print("🛑 Scanner: Lot = 0 for ", sym); return; }

   // Margin check
   double margin_req = 0.0;
   if(!OrderCalcMargin(type, sym, final_lot, price, margin_req) ||
      margin_req > AccountInfoDouble(ACCOUNT_MARGIN_FREE))
   {
      Print("🚫 Scanner Margin: insufficient for ", sym,
            " | Lot: ", DoubleToString(final_lot, 2));
      return;
   }

   // Full risk gate — OrderCalcProfit + Adaptive Scaling
   double potential_loss = 0.0;
   if(!OrderCalcProfit(type, sym, final_lot, price, sl, potential_loss))
   {
      // Fallback for exotic symbols
      double _tv = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_VALUE);
      double _ts = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_SIZE);
      if(_ts > 0 && _tv > 0)
         potential_loss = (MathAbs(price - sl) / _ts) * _tv * final_lot;
      else { Print("🚫 Scanner: Cannot calc risk for ", sym); return; }
   }
   potential_loss = MathAbs(potential_loss);

   if(potential_loss > allowed_risk)
   {
      double factor   = allowed_risk / potential_loss;
      double adj_lot  = MathFloor(final_lot * factor / stepLot) * stepLot;
      if(adj_lot >= minLot)
      {
         Print("✅ Scanner Adaptive Scale: ", sym,
               " | ", DoubleToString(final_lot,2),
               " → ", DoubleToString(adj_lot,2));
         final_lot = adj_lot;
      }
      else
      {
         Print("🚫 Scanner Risk Block: ", sym,
               " | $", DoubleToString(potential_loss,2),
               " > allowed $", DoubleToString(allowed_risk,2));
         return;
      }
   }

   double lot = final_lot;
   
   // Hard risk gate for scanner trades
   double scan_potential_loss = 0.0;
   if(!OrderCalcProfit(type, sym, lot, price, sl, scan_potential_loss))
   {
      double _tickVal  = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_VALUE);
      double _tickSize = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_SIZE);
      double _slDist   = MathAbs(price - sl);
      if(_tickSize > 0 && _tickVal > 0)
         scan_potential_loss = (_slDist / _tickSize) * _tickVal * lot;
      else
      {
         Print("🚫 Scanner Risk: Cannot calculate for ", sym, " — blocked");
         return;
      }
   }
   scan_potential_loss = MathAbs(scan_potential_loss);

   double scan_allowed  = balance * (RISK_Per_Trade_Percent / 100.0) * 3.0;
   if(scan_potential_loss > scan_allowed)
   {
      double _factor   = scan_allowed / scan_potential_loss;
      double _adjLot   = MathFloor(lot * _factor / stepLot) * stepLot;
      if(_adjLot >= minLot)
      {
         Print("⚠️ Scanner Adaptive Scale: ", sym,
               " | ", DoubleToString(lot,2), " → ", DoubleToString(_adjLot,2),
               " | Risk: $", DoubleToString(scan_potential_loss,2),
               " → capped at $", DoubleToString(scan_allowed,2));
         lot = _adjLot;
      }
      else
      {
         Print("🚫 Scanner Risk Block: ", sym,
               " | Risk $", DoubleToString(scan_potential_loss,2),
               " too high even at min lot — trade blocked");
         return;
      }
   }

   double orderSL  = Use_Stealth_SLTP ? 0 : sl;
   double orderTP  = Use_Stealth_SLTP ? 0 : tp;
   
   g_last_trade_strategy = (ENUM_STRATEGY)StrategyNameToEnum(stratName);

   CTrade scanTrade;
   scanTrade.SetExpertMagicNumber(Magic_Number);
   scanTrade.SetDeviationInPoints(Max_Slippage);

   // Use display name for the comment
string displayName = "Uluka Ultra";   // Or keep the original stratName for non-vote scanner trades

bool ok = (type == ORDER_TYPE_BUY) ?
          scanTrade.Buy(lot, sym, price, orderSL, orderTP, displayName) :
          scanTrade.Sell(lot, sym, price, orderSL, orderTP, displayName);

   if(ok)
   {
      ulong ticket = scanTrade.ResultOrder();
      Print("📡 Scanner trade opened: ", sym, " #", ticket, " lot=", lot);
      g_last_trade_time = TimeCurrent();
      
      if(PositionSelectByTicket(ticket))
      {
         string actualComment = PositionGetString(POSITION_COMMENT);
         StoreTradeStrategy(ticket, actualComment);
      }
      else
      {
         StoreTradeStrategy(ticket, stratName);
         Print("Stored strategy from variable (fallback): '", stratName, "'");
      }

      if(Use_Stealth_SLTP)
      {
         int idx = ArraySize(stealth_levels);
         ArrayResize(stealth_levels, idx + 1);
         stealth_levels[idx].ticket = ticket;
         stealth_levels[idx].sl     = sl;
         stealth_levels[idx].tp     = tp;
         Print("📡 Stealth registered: #", ticket,
               " SL:", DoubleToString(sl, digits),
               " TP:", DoubleToString(tp, digits));
         MarkStealthDirty();
      }
   }
   else
      Print("📡 Scanner trade FAILED: ", sym, " err=", GetLastError());
}
