// =============================================================

ENUM_TREND_BIAS GetHTFBias(string symbol, ENUM_TIMEFRAMES tf = PERIOD_H4)
{
   // Use the provided timeframe for bias
   int emaFastHandle = iMA(symbol, tf, 50,  0, MODE_EMA, PRICE_CLOSE);
   int emaSlowHandle = iMA(symbol, tf, 200, 0, MODE_EMA, PRICE_CLOSE);

   if(emaFastHandle == INVALID_HANDLE || emaSlowHandle == INVALID_HANDLE)
   {
      IndicatorRelease(emaFastHandle);
      IndicatorRelease(emaSlowHandle);
      return BIAS_NEUTRAL;
   }

   double emaFast[], emaSlow[];
   ArraySetAsSeries(emaFast, true);
   ArraySetAsSeries(emaSlow, true);

   bool ok = (CopyBuffer(emaFastHandle, 0, 0, 3, emaFast) >= 3 &&
              CopyBuffer(emaSlowHandle, 0, 0, 3, emaSlow) >= 3);

   IndicatorRelease(emaFastHandle);
   IndicatorRelease(emaSlowHandle);

   if(!ok) return BIAS_NEUTRAL;

   double separation = MathAbs(emaFast[0] - emaSlow[0]);
   double point      = SymbolInfoDouble(symbol, SYMBOL_POINT);
   double minSep     = point * 20; // Minimum 20 points separation for valid bias

   if(separation < minSep) return BIAS_NEUTRAL;

   if(emaFast[0] > emaSlow[0]) return BIAS_BULLISH;
   if(emaFast[0] < emaSlow[0]) return BIAS_BEARISH;

   return BIAS_NEUTRAL;
}

