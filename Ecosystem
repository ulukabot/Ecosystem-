double GetEffectiveRiskPercent()
{
   double risk    = RISK_Per_Trade_Percent;
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);

   // Capital Growth Governor
   if(Enable_Growth_Governor)
      risk = GetGovernedRiskPercent(risk, g_initial_deposit, balance);

   // Prop Firm risk cap
   if(Prop_Firm_Mode != PROP_NONE && Prop_Override_Risk)
   {
      PropFirmLimits lim = GetPropFirmLimits(Prop_Firm_Mode);
      risk = MathMin(risk, lim.maxRiskPerTrade);
   }

   // Risk_Hard_Shield — cap risk% so dollar risk never exceeds shield amount
   if(Risk_Hard_Shield > 0 && balance > 0)
   {
      double shield_pct = (Risk_Hard_Shield / balance) * 100.0;
      risk = MathMin(risk, shield_pct);
   }

     // ─── Anti‑Martingale Win Streak ───
   double winMult = 1.0;
   
   // Check if peak guard is active (scaling is paused)
   bool peakGuardActive = false;
   if(g_daily_peak_profit > 0 && G_TodayRealizedProfit > 0)
   {
      double retreatLevel = g_daily_peak_profit * (Profit_Scaling_Retreat_Pct / 100.0);
      if(G_TodayRealizedProfit < retreatLevel)
         peakGuardActive = true;
   }

   if(G_ConsecutiveWins >= 3 && !peakGuardActive)
   {
      int extra = G_ConsecutiveWins - 2;
      winMult = 1.0 + MathMin(1.0, extra * 0.10);
   }
   risk *= winMult;

   return risk;
}

