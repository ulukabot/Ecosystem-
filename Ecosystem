for(int _i = 0; _i < scanCount; _i++)
{
string s = syms[_i];
StringTrimLeft(s); StringTrimRight(s);
if(StringLen(s) > 0 && s != _Symbol) count++;
}
return MathMax(1, count);
}

bool ShouldSendPositionUpdate(ulong ticket)
{
int found = -1;
for(int i = 0; i < ArraySize(g_last_pos_update_ticket); i++)
if(g_last_pos_update_ticket[i] == ticket) { found = i; break; }
if(found == -1)
{
int sz = ArraySize(g_last_pos_update_ticket);
ArrayResize(g_last_pos_update_ticket, sz + 1);
ArrayResize(g_last_pos_update_time,   sz + 1);
g_last_pos_update_ticket[sz] = ticket;
g_last_pos_update_time[sz]   = 0;
found = sz;
}
if(TimeCurrent() - g_last_pos_update_time[found] < 300) return false;
g_last_pos_update_time[found] = TimeCurrent();
return true;
}
