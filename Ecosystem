// Confidence bonus from session history (+/-20 max)
int GetDNASessionBonus(string symbol)
{
   int idx = DNA_FindSymbol(symbol);
   if(idx < 0) return 0;
   if(G_DNA_TotalTrades[idx] < 5) return 0;

   int sessIdx = (int)GetCurrentSession();
   int k       = idx * DNA_SESSIONS + sessIdx;
   int total   = G_DNA_SessWins[k] + G_DNA_SessLosses[k];
   if(total < 2) return 0;

   double sessWR    = DNA_CellWinRate(G_DNA_SessWins[k], G_DNA_SessLosses[k]);
   double overallWR = G_DNA_WinRate[idx];
   double diff      = sessWR - overallWR;

   if(diff >  20) return 15;
   if(diff >  10) return 8;
   if(diff >   5) return 4;
   if(diff < -20) return -15;
   if(diff < -10) return -8;
   if(diff <  -5) return -4;
   return 0;
}

// Confidence bonus from strategy history (+/-12 max)
int GetDNAStrategyBonus(string symbol, int stratIdx)
{
   int idx = DNA_FindSymbol(symbol);
   if(idx < 0) return 0;
   if(G_DNA_TotalTrades[idx] < 5) return 0;
   if(stratIdx < 0 || stratIdx >= DNA_STRATEGIES) return 0;

   int k     = idx * DNA_STRATEGIES + stratIdx;
   int total = G_DNA_StrWins[k] + G_DNA_StrLosses[k];
   if(total < 2) return 0;

   double stratWR   = DNA_CellWinRate(G_DNA_StrWins[k], G_DNA_StrLosses[k]);
   double overallWR = G_DNA_WinRate[idx];
   double diff      = stratWR - overallWR;

   if(diff >  20) return 12;
   if(diff >  10) return 6;
   if(diff < -20) return -12;
   if(diff < -10) return -6;
   return 0;
}

// Combined confidence boost — call inside CalculateConfidence()
int GetDNATotalConfidenceBonus(string symbol, int stratIdx)
{
   int total = GetDNASessionBonus(symbol) + GetDNAStrategyBonus(symbol, stratIdx);
   return MathMax(-20, MathMin(20, total));
}

// Risk multiplier based on current session vs DNA (0.5x to 1.2x)
double GetDNARiskMultiplier(string symbol)
{
   int idx = DNA_FindSymbol(symbol);
   if(idx < 0) return 1.0;
   if(G_DNA_TotalTrades[idx] < 10) return 1.0;

   int sessIdx = (int)GetCurrentSession();
   int k       = idx * DNA_SESSIONS + sessIdx;
   int total   = G_DNA_SessWins[k] + G_DNA_SessLosses[k];
   if(total < 3) return 1.0;

   double sessWR = DNA_CellWinRate(G_DNA_SessWins[k], G_DNA_SessLosses[k]);

   // Worst session
   if(sessIdx == G_DNA_WorstSession[idx])
   {
      if(sessWR < 35) return 0.5;
      if(sessWR < 45) return 0.75;
   }

   // Best session
   if(sessIdx == G_DNA_BestSession[idx] && G_DNA_TotalTrades[idx] >= 20)
   {
      if(sessWR > 70) return 1.2;
   }

   return 1.0;
}

// Block trade if current session+strategy combo historically terrible
bool ShouldDNABlockTrade(string symbol, int stratIdx)
{
   int idx = DNA_FindSymbol(symbol);
   if(idx < 0) return false;
   if(G_DNA_TotalTrades[idx] < 15) return false;

   int sessIdx  = (int)GetCurrentSession();
   int sk       = idx * DNA_SESSIONS  + sessIdx;
   int stk      = idx * DNA_STRATEGIES + stratIdx;

   int sessTotal = G_DNA_SessWins[sk]  + G_DNA_SessLosses[sk];
   int stratTotal= G_DNA_StrWins[stk]  + G_DNA_StrLosses[stk];

   if(sessTotal < 3 || stratTotal < 3) return false;

   double sessWR  = DNA_CellWinRate(G_DNA_SessWins[sk],  G_DNA_SessLosses[sk]);
   double stratWR = DNA_CellWinRate(G_DNA_StrWins[stk], G_DNA_StrLosses[stk]);

   if(sessWR < 30 && stratWR < 30)
   {
      Print("⚠ DNA BLOCK: ", symbol,
            " | Session WR: ", DoubleToString(sessWR, 0), "%",
            " | Strategy WR: ", DoubleToString(stratWR, 0), "%",
            " — historically losing combo");
      return true;
   }
   return false;
}

