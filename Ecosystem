//+------------------------------------------------------------------+
//| Get Asian Session High/Low (00:00 – 09:00 GMT)                   |
//+------------------------------------------------------------------+
bool GetAsianRange(double &asianHigh, double &asianLow)
{
    MqlDateTime dt;
    TimeToStruct(TimeCurrent(), dt);
    dt.hour = 0;
    dt.min = 0;
    dt.sec = 0;
    datetime asianStart = StructToTime(dt);
    dt.hour = 9;
    dt.min = 0;
    dt.sec = 0;
    datetime asianEnd = StructToTime(dt);
    
    if(asianEnd > TimeCurrent()) return false; // Asian session not finished yet
    
    int bars = iBarShift(_Symbol, PERIOD_H1, asianEnd) - iBarShift(_Symbol, PERIOD_H1, asianStart);
    if(bars < 1) return false;
    
    double high[], low[];
    ArraySetAsSeries(high, true);
    ArraySetAsSeries(low, true);
    
    int startIdx = iBarShift(_Symbol, PERIOD_H1, asianStart);
    if(CopyHigh(_Symbol, PERIOD_H1, startIdx, bars, high) < bars) return false;
    if(CopyLow(_Symbol, PERIOD_H1, startIdx, bars, low) < bars) return false;
    
    asianHigh = high[ArrayMaximum(high, 0, bars)];
    asianLow = low[ArrayMinimum(low, 0, bars)];
    
    return (asianHigh > 0 && asianLow > 0);
}

ScoreSignalResult GetScoreSignal(string symbol, ENUM_TIMEFRAMES tf,
                                 double bid, double ask,
                                 int bb_handle, int maFast_handle, int maSlow_handle)
{
   ScoreSignalResult result;
   // ─── Initialise everything ───
   result.buyScore  = 0;
   result.sellScore = 0;
   result.signalType = 0;
   result.riskMultiplier = 0.0;
   result.reason = "";

   // ─── Initialise flags ───
   result.obBuy = result.obSell = false;
   result.fvgBuy = result.fvgSell = false;
   result.bosBuy = result.bosSell = false;
   result.chochBuy = result.chochSell = false;
   result.farsightBuy = result.farsightSell = false;
   result.visionBuy = result.visionSell = false;

   const int WEIGHT = 17; // 6 × 17 = 102 (~100)

   // ─── 1. ORDER BLOCK ──────────────────────────────────────────
   OrderBlock obBuy  = GetNearestOrderBlock(symbol, tf, ORDER_TYPE_BUY);
   OrderBlock obSell = GetNearestOrderBlock(symbol, tf, ORDER_TYPE_SELL);
   if(obBuy.valid)  { result.buyScore += WEIGHT; result.obBuy = true; }
   if(obSell.valid) { result.sellScore += WEIGHT; result.obSell = true; }

   // ─── 2. FAIR VALUE GAP ──────────────────────────────────────
   FVGZone fvgBuy  = GetNearestFVG(symbol, tf, ORDER_TYPE_BUY);
   FVGZone fvgSell = GetNearestFVG(symbol, tf, ORDER_TYPE_SELL);
   if(fvgBuy.valid)  { result.buyScore += WEIGHT; result.fvgBuy = true; }
   if(fvgSell.valid) { result.sellScore += WEIGHT; result.fvgSell = true; }

   // ─── 3. BOS / CHoCH ──────────────────────────────────────────
   ENUM_STRATEGY smcBuy  = GetRecommendedStrategy(symbol, ORDER_TYPE_BUY);
   ENUM_STRATEGY smcSell = GetRecommendedStrategy(symbol, ORDER_TYPE_SELL);
   if(smcBuy == STRATEGY_BOS)   { result.buyScore += WEIGHT; result.bosBuy = true; }
   if(smcSell == STRATEGY_BOS)  { result.sellScore += WEIGHT; result.bosSell = true; }
   if(smcBuy == STRATEGY_CHOCH) { result.buyScore += WEIGHT; result.chochBuy = true; }
   if(smcSell == STRATEGY_CHOCH){ result.sellScore += WEIGHT; result.chochSell = true; }

   // ─── 4. FARSIGHT (Trend Following) ──────────────────────────
   ENUM_MARKET_REGIME regime = DetectMarketRegime(symbol, tf);
   if(regime == REGIME_TRENDING)
   {
      double maFast[], maSlow[];
      ArraySetAsSeries(maFast, true);
      ArraySetAsSeries(maSlow, true);
      if(CopyBuffer(maFast_handle, 0, 0, 2, maFast) >= 2 && CopyBuffer(maSlow_handle, 0, 0, 2, maSlow) >= 2)
      {
         if(maFast[0] > maSlow[0]) { result.buyScore += WEIGHT; result.farsightBuy = true; }
         if(maFast[0] < maSlow[0]) { result.sellScore += WEIGHT; result.farsightSell = true; }
      }
   }

         // ─── 5. CLOSE VISION (Mean Reversion) ──────────────────────
   if(regime == REGIME_RANGING)
   {
      double up[], lo[];
      ArraySetAsSeries(up, true);
      ArraySetAsSeries(lo, true);
      if(CopyBuffer(bb_handle, 1, 0, 3, up) >= 3 && CopyBuffer(bb_handle, 2, 0, 3, lo) >= 3)
      {
         bool bbBuy  = (bid <= lo[1] && bid > lo[2]);
         bool bbSell = (ask >= up[1] && ask < up[2]);
         if(bbBuy)  { result.buyScore += WEIGHT; result.visionBuy = true; }
         if(bbSell) { result.sellScore += WEIGHT; result.visionSell = true; }
      }
   }

     // ─── DECISION ────────────────────────────────────────────────
   if(result.buyScore > result.sellScore)
      result.signalType = 1; // BUY
   else if(result.sellScore > result.buyScore)
      result.signalType = -1; // SELL
   else
      result.signalType = 0; // TIE

   return result;
}
