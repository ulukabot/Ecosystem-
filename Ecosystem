// SECTION 38 — CAPITAL GROWTH GOVERNOR (NEW)
// =============================================================

double GetGovernedRiskPercent(double baseRisk, double initialDeposit, double currentBalance)
{
   if(initialDeposit <= 0) return baseRisk;

   double growth = (currentBalance - initialDeposit) / initialDeposit * 100.0;

   // Every 20% growth, unlock next risk tier (max +0.5% total)
   if(growth >= 60)      return MathMin(baseRisk + 0.5, 2.0);
   if(growth >= 40)      return MathMin(baseRisk + 0.3, 1.8);
   if(growth >= 20)      return MathMin(baseRisk + 0.2, 1.5);

   // Below initial deposit: reduce risk
   if(growth < -10)      return baseRisk * 0.7;
   if(growth < -5)       return baseRisk * 0.85;

   return baseRisk;
}

// ============================================================
// P10 — CORRELATION BASKET EXPOSURE CAP
// ============================================================

int GetCorrelatedExposureCount(string symbol, ENUM_ORDER_TYPE direction, int magic)
{
   string group1[] = {"EURUSD","GBPUSD","AUDUSD","NZDUSD"};  // Positive USD correlation
   string group2[] = {"USDJPY","USDCHF","USDCAD"};            // Negative USD correlation
   string xauGroup[]= {"XAUUSD","XAGUSD"};                    // Metals

   // Which group is the new symbol in?
   bool inG1 = false, inG2 = false, inXAU = false;
   string cleanSym = symbol; StringReplace(cleanSym, ".m", ""); StringReplace(cleanSym, ".c", "");

   for(int k = 0; k < 4; k++) if(cleanSym == group1[k]) { inG1 = true; break; }
   for(int k = 0; k < 3; k++) if(cleanSym == group2[k]) { inG2 = true; break; }
   for(int k = 0; k < 2; k++) if(cleanSym == xauGroup[k]){ inXAU= true; break; }

   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != magic) continue;

      string  pos = PositionGetString(POSITION_SYMBOL);
      StringReplace(pos, ".m", ""); StringReplace(pos, ".c", "");
      int     pType = (int)PositionGetInteger(POSITION_TYPE);
      bool    sameDir = ((direction == ORDER_TYPE_BUY  && pType == POSITION_TYPE_BUY) ||
                         (direction == ORDER_TYPE_SELL && pType == POSITION_TYPE_SELL));
      bool    oppDir  = !sameDir;

      bool posInG1 = false, posInG2 = false, posInXAU = false;
      for(int k = 0; k < 4; k++) if(pos == group1[k]) { posInG1 = true; break; }
      for(int k = 0; k < 3; k++) if(pos == group2[k]) { posInG2 = true; break; }
      for(int k = 0; k < 2; k++) if(pos == xauGroup[k]){ posInXAU= true; break; }

      // Same group, same direction = correlated exposure
      if((inG1 && posInG1 && sameDir) || (inG2 && posInG2 && sameDir) ||
         (inG1 && posInG2 && oppDir)  || (inG2 && posInG1 && oppDir) ||
         (inXAU && posInXAU && sameDir))
         count++;
   }
   return count;
}

// Returns true if adding this trade would exceed maxExposure correlated positions
bool IsBasketExposureExceeded(string symbol, ENUM_ORDER_TYPE direction, int magic, int maxExposure = 2)
{
   return GetCorrelatedExposureCount(symbol, direction, magic) >= maxExposure;
}



