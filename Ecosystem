   int total = HistoryDealsTotal(), count = 0;
   for(int i = total - 1; i >= 0 && count < 5; i--)
   {
      ulong tkt = HistoryDealGetTicket(i);
      if(HistoryDealGetInteger(tkt, DEAL_MAGIC) != Magic_Number) continue;
      if(HistoryDealGetInteger(tkt, DEAL_ENTRY) != DEAL_ENTRY_OUT) continue;
      double p = HistoryDealGetDouble(tkt, DEAL_PROFIT);
      if(count > 0) lastTrades += ",";
      lastTrades += "{\"result\":\"" + (p >= 0 ? "PROFIT" : "LOSS") +
                    "\",\"pnl\":"    + DoubleToString(p, 2) + "}";
      count++;
   }
   lastTrades += "]";

   string htfBias = "NEUTRAL";
   ENUM_TREND_BIAS bias = GetHTFBias(symbol);
   if(bias == BIAS_BULLISH)      htfBias = "BULLISH";
   else if(bias == BIAS_BEARISH) htfBias = "BEARISH";

   string ctx = "{";
   ctx += "\"symbol\":\""      + symbol + "\",";
   ctx += "\"action\":\""      + (type == ORDER_TYPE_BUY ? "BUY" : "SELL") + "\",";
   ctx += "\"strategy\":\""    + stratName + "\",";
   ctx += "\"session\":\""     + GetSessionName() + "\",";
   ctx += "\"htf_bias\":\""    + htfBias + "\",";
   ctx += "\"confidence\":"    + IntegerToString(confidence) + ",";
   ctx += "\"spread\":"        + IntegerToString((int)SymbolInfoInteger(symbol, SYMBOL_SPREAD)) + ",";
   ctx += "\"balance\":"       + DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2) + ",";
   ctx += "\"daily_pnl\":"     + DoubleToString(g_daily_realized_pnl, 2) + ",";
   ctx += "\"health\":"        + IntegerToString(g_health_score) + ",";
   ctx += "\"enable_cot\":"    + (Enable_COT_Filter ? "true" : "false") + ",";
   ctx += "\"last_trades\":"   + lastTrades;
   ctx += "}";
   return ctx;
}

string CallClaudeAI(string contextJson)
{
   string payload = "{\"type\":\"AI_DECISION\"," + StringSubstr(contextJson, 1);
   char   data[], result[];
   string res_headers;
   int    len = StringToCharArray(payload, data, 0, WHOLE_ARRAY, CP_UTF8);
   if(len > 0) ArrayResize(data, len - 1);

   int res = WebRequest(
      "POST", RAILWAY_URL,
      "Content-Type: application/json\r\n",
      AI_Timeout_Ms, data, result, res_headers
   );

   if(res == -1 || ArraySize(result) == 0)
   {
      Print("🤖 Claude: Timeout — fallback TAKE");
      return "{\"decision\":\"TAKE\",\"confidence_adjustment\":0,\"risk_multiplier\":1.0,"
             "\"reason\":\"timeout\",\"news_sentiment\":\"NEUTRAL\","
             "\"news_summary\":\"\",\"cot_sentiment\":\"NEUTRAL\",\"warning\":null}";
   }
   return CharArrayToString(result, 0, WHOLE_ARRAY, CP_UTF8);
}

void ParseAIResponse(string response)
{
   int s, e;

   // decision
   g_last_ai_decision = (StringFind(response, "\"decision\":\"SKIP\"") >= 0) ? "SKIP" : "TAKE";

   // reason
   s = StringFind(response, "\"reason\":\"");
   if(s >= 0) { s += 10; e = StringFind(response, "\"", s); if(e > s) g_last_ai_reason = StringSubstr(response, s, e - s); }

   // news_sentiment
   s = StringFind(response, "\"news_sentiment\":\"");
   if(s >= 0) { s += 18; e = StringFind(response, "\"", s); if(e > s) g_last_ai_news_sent = StringSubstr(response, s, e - s); }

   // news_summary
   s = StringFind(response, "\"news_summary\":\"");
   if(s >= 0) { s += 16; e = StringFind(response, "\"", s); if(e > s) g_last_ai_news_summ = StringSubstr(response, s, e - s); }

   // risk_multiplier
   s = StringFind(response, "\"risk_multiplier\":");
   if(s >= 0) { s += 18; e = StringFind(response, ",", s); if(e < 0) e = StringFind(response, "}", s); if(e > s) g_last_ai_risk_mult = MathMax(0.5, MathMin(1.5, StringToDouble(StringSubstr(response, s, e - s)))); }

   // confidence_adjustment
   s = StringFind(response, "\"confidence_adjustment\":");
   if(s >= 0) { s += 24; e = StringFind(response, ",", s); if(e < 0) e = StringFind(response, "}", s); if(e > s) g_last_ai_conf_adj = MathMax(-20, MathMin(20, (int)StringToInteger(StringSubstr(response, s, e - s)))); }
}

bool ShouldAITrade(ENUM_ORDER_TYPE type, string stratName, int confidence, string symbol = "")
{
   string ctx      = BuildMarketContext(type, stratName, confidence, symbol);
   string response = CallClaudeAI(ctx);
   ParseAIResponse(response);

   if(AI_Log_Decisions)
      Print("🤖 [MASTER] ", g_last_ai_decision,
            " | News:", g_last_ai_news_sent,
            " | COT:",  g_last_ai_cot_sent,
            " | Rx",    DoubleToString(g_last_ai_risk_mult, 2),
            " | ",      g_last_ai_reason);

   return (g_last_ai_decision == "TAKE");
}

