      if(G_CooldownSymbols[i] == symbol)
      {
         G_CooldownExpiry[i] = TimeCurrent() + cooldownMinutes * 60;
        if(G_DebugMode) Print("⏱️ Cooldown reset for ", symbol, " — ", cooldownMinutes, " mins");
         return;
      }
   }
   // Add new entry
   if(G_CooldownCount < 30)
   {
      G_CooldownSymbols[G_CooldownCount] = symbol;
      G_CooldownExpiry[G_CooldownCount]  = TimeCurrent() + cooldownMinutes * 60;
      G_CooldownCount++;
     if(G_DebugMode) Print("⏱️ Cooldown set for ", symbol, " — ", cooldownMinutes, " mins");
   }
}

bool IsSymbolOnCooldown(string symbol)
{
   for(int i = 0; i < G_CooldownCount; i++)
   {
      if(G_CooldownSymbols[i] == symbol)
      {
         if(TimeCurrent() < G_CooldownExpiry[i])
         {
            int remaining = (int)((G_CooldownExpiry[i] - TimeCurrent()) / 60);
           if(G_DebugMode) Print(" ", symbol, " on cooldown. ", remaining, " mins remaining.");
            return true;
         }
      }
   }
   return false;
}

// =============================================================
// SECTION 28 — BREAK-EVEN AUTOMATION (NEW)
// =============================================================

void ManageBreakEven(string symbol, int magic, int bePoints, CTrade &tradeObj,
                     StealthLevels &stealth_arr[], bool enable_trailing, bool useStealth)
{
   // Static arrays to track which tickets have already had BE set (ONLY ONCE)
   static ulong    be_already_set[100];
   static int      be_already_count = 0;
   
   // Static arrays for throttling prints
   static datetime last_be_print_time[100];
   static ulong    last_be_print_ticket[100];
   static int      last_be_print_count = 0;

   double point    = SymbolInfoDouble(symbol, SYMBOL_POINT);
   double beDist   = bePoints * point;
   double minStop  = (double)SymbolInfoInteger(symbol, SYMBOL_TRADE_STOPS_LEVEL) * point;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC)  != magic)   continue;
      if(PositionGetString(POSITION_SYMBOL) != symbol)  continue;
      
      // === CHECK 1: BE already applied to this ticket? ===
      bool be_already_applied = false;
      for(int b = 0; b < be_already_count; b++)
      {
         if(be_already_set[b] == ticket)
         {
            be_already_applied = true;
            break;
         }
      }
      
      if(be_already_applied) continue;

      double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      double currSL    = PositionGetDouble(POSITION_SL);
      int    posType   = (int)PositionGetInteger(POSITION_TYPE);
      
      // === Get real SL from stealth_arr if in stealth mode ===
      double realSL = currSL;
      if(currSL == 0)
      {
         for(int s = 0; s < ArraySize(stealth_arr); s++)
         {
            if(stealth_arr[s].ticket == ticket)
            {
               realSL = stealth_arr[s].sl;
               break;
            }
         }
      }

      if(posType == POSITION_TYPE_BUY)
      {
         double bid    = SymbolInfoDouble(symbol, SYMBOL_BID);
         double profit = bid - openPrice;
         double beSL   = openPrice + point;
         
         bool sl_already_at_be = (realSL >= beSL && realSL > 0);
         
         if(sl_already_at_be)
         {
            if(be_already_count < 100)
            {
               be_already_set[be_already_count] = ticket;
               be_already_count++;
            }
            continue;
         }

         // Only apply BE if profit threshold met AND current SL is below entry
         if(profit >= beDist && realSL < openPrice && !sl_already_at_be)
         {
            if(beSL < realSL && realSL > 0)
            {
               if((bid - beSL) >= minStop)
               {
                  bool success = false;
                  if(useStealth)
                  {
                     UpdateStealthSL(ticket, beSL, stealth_arr);
                     success = true;
                  }
                  else
                  {
                     success = tradeObj.PositionModify(ticket, beSL, PositionGetDouble(POSITION_TP));
                  }
                  
                  if(success)
                  {
                     if(be_already_count < 100)
                     {
                        be_already_set[be_already_count] = ticket;
                        be_already_count++;
                     }
                     
                     // Throttled print
                     int print_idx = -1;
                     for(int p = 0; p < last_be_print_count; p++)
                     {
                        if(last_be_print_ticket[p] == ticket)
                        {
                           print_idx = p;
                           break;
                        }
                     }
                     
                     if(print_idx == -1)
                     {
                        print_idx = last_be_print_count;
                        if(print_idx >= 100)
                        {
                           for(int p = 0; p < 99; p++)
                           {
                              last_be_print_ticket[p] = last_be_print_ticket[p+1];
                              last_be_print_time[p] = last_be_print_time[p+1];
                           }
                           print_idx = 99;
                           last_be_print_count = 100;
                        }
                        else
                        {
                           last_be_print_count++;
                        }
                        last_be_print_ticket[print_idx] = ticket;
                        last_be_print_time[print_idx] = 0;
                     }
                     
                     if(TimeCurrent() - last_be_print_time[print_idx] >= 30)
                     {
                        if(G_DebugMode)Print("✅ Break-Even SET | BUY #", ticket, " | Entry:", DoubleToString(openPrice, _Digits),
                              " | New SL:", DoubleToString(beSL, _Digits));
                        last_be_print_time[print_idx] = TimeCurrent();
                     }
                  }
                  else
                  {
                     Print("⚠️ BE Modify Failed | Ticket:", ticket, " | Error:", GetLastError());
                  }
               }
            }
         }
      }

      if(posType == POSITION_TYPE_SELL)
      {
         double ask    = SymbolInfoDouble(symbol, SYMBOL_ASK);
         double profit = openPrice - ask;
         double beSL   = openPrice - point;
         
         bool sl_already_at_be = (realSL <= beSL && realSL > 0);
         
         if(sl_already_at_be)
         {
            if(be_already_count < 100)
            {
               be_already_set[be_already_count] = ticket;
               be_already_count++;
            }
            continue;
         }

         // Only apply BE if profit threshold met
         if(profit >= beDist && (realSL > openPrice || realSL == 0) && !sl_already_at_be)
         {
            if(realSL > beSL && realSL > 0)
            {
               if((beSL - ask) >= minStop)
               {
                  bool success = false;
                  if(useStealth)
                  {
                     UpdateStealthSL(ticket, beSL, stealth_arr);
                     success = true;
                  }
                  else
                  {
                     success = tradeObj.PositionModify(ticket, beSL, PositionGetDouble(POSITION_TP));
                  }
                  
                  if(success)
                  {
                     if(be_already_count < 100)
                     {
                        be_already_set[be_already_count] = ticket;
                        be_already_count++;
                     }
                     
                     // Throttled print
                     int print_idx = -1;
                     for(int p = 0; p < last_be_print_count; p++)
                     {
                        if(last_be_print_ticket[p] == ticket)
                        {
                           print_idx = p;
                           break;
                        }
                     }
                     
                     if(print_idx == -1)
                     {
                        print_idx = last_be_print_count;
                        if(print_idx >= 100)
                        {
                           for(int p = 0; p < 99; p++)
                           {
                              last_be_print_ticket[p] = last_be_print_ticket[p+1];
                              last_be_print_time[p] = last_be_print_time[p+1];
                           }
                           print_idx = 99;
                           last_be_print_count = 100;
                        }
                        else
                        {
                           last_be_print_count++;
                        }
                        last_be_print_ticket[print_idx] = ticket;
                        last_be_print_time[print_idx] = 0;
                     }
                     
                     if(TimeCurrent() - last_be_print_time[print_idx] >= 30)
                     {
                        Print("✅ Break-Even SET | SELL #", ticket, " | Entry:", DoubleToString(openPrice, _Digits),
                              " | New SL:", DoubleToString(beSL, _Digits));
                        last_be_print_time[print_idx] = TimeCurrent();
                     }
                  }
                  else
                  {
                     Print("⚠️ BE Modify Failed | Ticket:", ticket, " | Error:", GetLastError());
                  }
               }
            }
         }
      }
   }
}

