//+------------------------------------------------------------------+
//| Per‑ticket strategy storage (shared by both EAs)                 |
//+------------------------------------------------------------------+
struct TradeRecord {
   ulong  ticket;
   string strategyName;
};
TradeRecord g_tradeMap[200];
int        g_tradeMapCount = 0;

void StoreTradeStrategy(ulong ticket, string name) {
   if(g_tradeMapCount < 200) {
      g_tradeMap[g_tradeMapCount].ticket = ticket;
      g_tradeMap[g_tradeMapCount].strategyName = name;
      g_tradeMapCount++;
   }
}

string GetStoredStrategy(ulong ticket) {
   for(int i = 0; i < g_tradeMapCount; i++)
      if(g_tradeMap[i].ticket == ticket)
         return g_tradeMap[i].strategyName;
   return "";
}

void RemoveStoredStrategy(ulong ticket) {
   for(int i = 0; i < g_tradeMapCount; i++) {
      if(g_tradeMap[i].ticket == ticket) {
         for(int j = i; j < g_tradeMapCount - 1; j++)
            g_tradeMap[j] = g_tradeMap[j+1];
         g_tradeMapCount--;
         break;
      }
   }
}

