void SaveDNAToFile(int idx)
{
   if(idx < 0 || idx >= G_DNA_Count) return;

   string filename = DNA_FileName(G_DNA_Symbol[idx]);
   int fh = FileOpen(filename, FILE_WRITE|FILE_CSV|FILE_COMMON, ',');
   if(fh == INVALID_HANDLE) { Print("🧬: Cannot write: ", filename); return; }

   FileWrite(fh, "TYPE", "IDX", "WINS", "LOSSES", "PROFIT", "LOSS");

   for(int i = 0; i < DNA_SESSIONS; i++)
   {
      int k = idx * DNA_SESSIONS + i;
      FileWrite(fh, "S", i, G_DNA_SessWins[k], G_DNA_SessLosses[k],
                G_DNA_SessProfit[k], G_DNA_SessLoss[k]);
   }
   for(int i = 0; i < DNA_REGIMES; i++)
   {
      int k = idx * DNA_REGIMES + i;
      FileWrite(fh, "R", i, G_DNA_RegWins[k], G_DNA_RegLosses[k],
                G_DNA_RegProfit[k], G_DNA_RegLoss[k]);
   }
   for(int i = 0; i < DNA_STRATEGIES; i++)
   {
      int k = idx * DNA_STRATEGIES + i;
      FileWrite(fh, "ST", i, G_DNA_StrWins[k], G_DNA_StrLosses[k],
                G_DNA_StrProfit[k], G_DNA_StrLoss[k]);
   }
   for(int i = 0; i < DNA_HOURS; i++)
   {
      int k = idx * DNA_HOURS + i;
      FileWrite(fh, "H", i, G_DNA_HrWins[k], G_DNA_HrLosses[k],
                G_DNA_HrProfit[k], G_DNA_HrLoss[k]);
   }
   FileWrite(fh, "TOT", 0,
             G_DNA_TotalTrades[idx], G_DNA_TotalWins[idx],
             G_DNA_TotalLosses[idx], G_DNA_TotalPnL[idx]);

   FileClose(fh);
}

void LoadDNAFromFile(int idx)
{
   if(idx < 0 || idx >= G_DNA_Count) return;

   string filename = DNA_FileName(G_DNA_Symbol[idx]);
   if(!FileIsExist(filename, FILE_COMMON)) return;

   int fh = FileOpen(filename, FILE_READ|FILE_CSV|FILE_COMMON, ',');
   if(fh == INVALID_HANDLE) return;

   // Skip header row
   for(int c = 0; c < 6; c++) FileReadString(fh);

   while(!FileIsEnding(fh))
   {
      string type = FileReadString(fh);
      int    i    = (int)StringToInteger(FileReadString(fh));
      int    w    = (int)StringToInteger(FileReadString(fh));
      int    l    = (int)StringToInteger(FileReadString(fh));
      double tp   = StringToDouble(FileReadString(fh));
      double tl   = StringToDouble(FileReadString(fh));

      if(type == "S"  && i >= 0 && i < DNA_SESSIONS)
      {
         int k = idx * DNA_SESSIONS + i;
         G_DNA_SessWins[k]=w; G_DNA_SessLosses[k]=l;
         G_DNA_SessProfit[k]=tp; G_DNA_SessLoss[k]=tl;
      }
      else if(type == "R"  && i >= 0 && i < DNA_REGIMES)
      {
         int k = idx * DNA_REGIMES + i;
         G_DNA_RegWins[k]=w; G_DNA_RegLosses[k]=l;
         G_DNA_RegProfit[k]=tp; G_DNA_RegLoss[k]=tl;
      }
      else if(type == "ST" && i >= 0 && i < DNA_STRATEGIES)
      {
         int k = idx * DNA_STRATEGIES + i;
         G_DNA_StrWins[k]=w; G_DNA_StrLosses[k]=l;
         G_DNA_StrProfit[k]=tp; G_DNA_StrLoss[k]=tl;
      }
      else if(type == "H"  && i >= 0 && i < DNA_HOURS)
      {
         int k = idx * DNA_HOURS + i;
         G_DNA_HrWins[k]=w; G_DNA_HrLosses[k]=l;
         G_DNA_HrProfit[k]=tp; G_DNA_HrLoss[k]=tl;
      }
      else if(type == "TOT")
      {
         G_DNA_TotalTrades[idx]  = w;
         G_DNA_TotalWins[idx]    = l;
         G_DNA_TotalLosses[idx]  = (int)tp;
         G_DNA_TotalPnL[idx]     = tl;
      }
   }

   FileClose(fh);
   G_DNA_Loaded[idx] = true;
}

