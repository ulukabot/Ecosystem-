//| BILLING SYNC — BUG-G + BUG-D Fix                                 |
//| Sends balance to GAS (fixes column D = 0) and reads pause status  |
//+------------------------------------------------------------------+
void SendBillingSync()
{
   if(!Enable_Cloud_Reporting) return;
   if(RAILWAY_URL == "")        return;
   if(MQLInfoInteger(MQL_TESTER) && Test_Skip_Cloud) return;

   string payload = "{";
   payload += "\"type\":\"BILLING_SYNC\",";
   payload += "\"account\":\"" + IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN)) + "\",";
   payload += "\"account_id\":\"" + IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN)) + "\",";
   payload += "\"balance\":" + DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2) + ",";
   payload += "\"equity\":" + DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY), 2) + ",";
   payload += "\"client\":\"" + g_client_name + "\",";
   payload += "\"broker\":\"" + AccountInfoString(ACCOUNT_COMPANY) + "\"";
   payload += "}";

   char data[], result[]; string res_headers;
   int len = StringToCharArray(payload, data, 0, WHOLE_ARRAY, CP_UTF8);
   if(len > 0) ArrayResize(data, len - 1);

   int res = WebRequest("POST", RAILWAY_URL, "Content-Type: application/json\r\n",
                        10000, data, result, res_headers);

   if(res == 200)
   {
      string response = CharArrayToString(result, 0, WHOLE_ARRAY, CP_UTF8);
      string clean    = response;
      StringToLower(clean);

      bool wasPaused = g_ea_paused;
      if(StringFind(clean, "paused") >= 0 || StringFind(clean, "blocked") >= 0 || StringFind(clean, "limit_block") >= 0)
      {
         g_ea_paused = true;
         if(!wasPaused) Print("⏸ CLIENT EA PAUSED via cloud command");
      }
      else
      {
         g_ea_paused = false;
         if(wasPaused) Print("▶️ CLIENT EA RESUMED via cloud");
      }
      if(G_DebugMode) Print("☁️ BillingSync | Bal: $", DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2),
            " | Status: ", response);
   }
   else
      Print("❌ BillingSync failed: HTTP ", res);
}


