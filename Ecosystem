void SendOpenPositions()
{
   if(Test_Skip_Cloud || !Enable_Cloud_Reporting) return;
   if(!g_licence_valid) return;

   string rows = "[";
   bool   first = true;
   int    total = PositionsTotal();

   for(int i = 0; i < total; i++)
   {
      ulong ticket = PositionGetTicket(i);
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;

      string sym       = PositionGetString(POSITION_SYMBOL);
      int    posType   = (int)PositionGetInteger(POSITION_TYPE);
      string direction = (posType == POSITION_TYPE_BUY) ? "BUY" : "SELL";
      double lot       = PositionGetDouble(POSITION_VOLUME);
      double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      double floatPnl  = PositionGetDouble(POSITION_PROFIT);
      double currPrice = (posType == POSITION_TYPE_BUY)
                         ? SymbolInfoDouble(sym, SYMBOL_BID)
                         : SymbolInfoDouble(sym, SYMBOL_ASK);
      double point     = SymbolInfoDouble(sym, SYMBOL_POINT);
      double pips      = (point > 0)
                         ? ((posType == POSITION_TYPE_BUY)
                            ? (currPrice - openPrice) / (point * 10)
                            : (openPrice - currPrice) / (point * 10))
                         : 0;
      string strategy = GetStoredStrategy(ticket);
if(strategy == "")
{
   strategy = GetStrategyName(GetRecommendedStrategy(sym, (ENUM_ORDER_TYPE)posType));
   if(strategy == "") strategy = "Unknown";
}

      if(!first) rows += ",";
      rows += "{\"symbol\":\"" + sym + "\"," 
            + "\"direction\":\"" + direction + "\"," 
            + "\"lot\":" + DoubleToString(lot, 2) + ","
            + "\"open_price\":" + DoubleToString(openPrice, _Digits) + ","
            + "\"pips\":" + DoubleToString(pips, 1) + ","
            + "\"floating_pnl\":" + DoubleToString(floatPnl, 2) + ","
            + "\"strategy\":\"" + strategy + "\"," 
            + "\"ticket\":" + IntegerToString((int)ticket) + "}";
      first = false;
   }
   rows += "]";

   string account_id = IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN));
   string payload = "{\"type\":\"OPEN_POSITIONS\","
                  + "\"account_id\":\"" + account_id + "\","
                  + "\"positions\":" + rows + "}";

   char data[], result[];
   int len = StringToCharArray(payload, data, 0, WHOLE_ARRAY, CP_UTF8);
   if(len > 0) ArrayResize(data, len - 1);

   string res_headers;
   int res = WebRequest("POST", RAILWAY_URL,
                        "Content-Type: application/json\r\n",
                        10000, data, result, res_headers);
}

