// =============================================================

FVGZone GetNearestFVG(string symbol, ENUM_TIMEFRAMES tf, ENUM_ORDER_TYPE tradeType)
{
   FVGZone fvg;
   fvg.valid    = false;
   fvg.top      = 0;
   fvg.bottom   = 0;
   fvg.isBullish = false;

   double highs[], lows[], closes[];
   ArraySetAsSeries(highs,  true);
   ArraySetAsSeries(lows,   true);
   ArraySetAsSeries(closes, true);

   if(CopyHigh(symbol,  tf, 0, 30, highs)  < 30) return fvg;
   if(CopyLow(symbol,   tf, 0, 30, lows)   < 30) return fvg;
   if(CopyClose(symbol, tf, 0, 30, closes) < 30) return fvg;

   double currentPrice = (tradeType == ORDER_TYPE_BUY) ?
                         SymbolInfoDouble(symbol, SYMBOL_ASK) :
                         SymbolInfoDouble(symbol, SYMBOL_BID);

   double minGapSize = SymbolInfoDouble(symbol, SYMBOL_POINT) * 50; // Min 50 points gap

   // Scan for FVG patterns (3-candle formation)
   for(int i = 2; i < 25; i++)
   {
      // Bullish FVG: candle[i+1] high < candle[i-1] low (gap upward)
      // i+1 = oldest, i = middle impulse, i-1 = newest
      if(tradeType == ORDER_TYPE_BUY)
      {
         double gapBottom = highs[i+1];   // Top of older candle
         double gapTop    = lows[i-1];    // Bottom of newer candle

         if(gapTop > gapBottom && (gapTop - gapBottom) >= minGapSize)
         {
            // Price approaching FVG from above (retest)
            if(currentPrice >= gapBottom && currentPrice <= gapTop)
            {
               fvg.top      = gapTop;
               fvg.bottom   = gapBottom;
               fvg.isBullish = true;
               fvg.valid    = true;
               static datetime last_bull_fvg_print = 0;
if(TimeCurrent() - last_bull_fvg_print >= PeriodSeconds(PERIOD_CURRENT))
{
  if(G_DebugMode) Print("🦉 Bullish FVG on ", symbol, ": ", DoubleToString(gapBottom, _Digits), " – ", DoubleToString(gapTop, _Digits));
   last_bull_fvg_print = TimeCurrent();
}
               return fvg;
            }
         }
      }

      // Bearish FVG: candle[i+1] low > candle[i-1] high (gap downward)
      if(tradeType == ORDER_TYPE_SELL)
      {
         double gapTop    = lows[i+1];    // Bottom of older candle
         double gapBottom = highs[i-1];   // Top of newer candle

         if(gapTop > gapBottom && (gapTop - gapBottom) >= minGapSize)
         {
            // Price approaching FVG from below (retest)
            if(currentPrice >= gapBottom && currentPrice <= gapTop)
            {
               fvg.top       = gapTop;
               fvg.bottom    = gapBottom;
               fvg.isBullish = false;
               fvg.valid     = true;
               static datetime last_fvg_print = 0;
if(TimeCurrent() - last_fvg_print >= PeriodSeconds(PERIOD_CURRENT))
{
  if(G_DebugMode)  Print("🦉 Bearish FVG on ", symbol, ": ", DoubleToString(gapBottom, _Digits), " – ", DoubleToString(gapTop, _Digits));
   last_fvg_print = TimeCurrent();
}
               return fvg;
            }
         }
      }
   }

   return fvg;
}


