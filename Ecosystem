string DNA_SampleConfidence(int totalTrades)
{
   if(totalTrades < 5) return "BUILDING";
   
   // Logarithmic scaling - mathematically optimal
   // Each additional trade adds diminishing returns
   double confidence = MathMin(100.0, (MathLog10(totalTrades) / MathLog10(100)) * 100);
   
   if(confidence >= 80) return "HIGH";
   if(confidence >= 50) return "MEDIUM";
   if(confidence >= 25) return "LOW";
   return "LEARNING";
}


// Win rate for a session/regime/strategy cell
double DNA_CellWinRate(int wins, int losses)
{
   int total = wins + losses;
   return (total > 0) ? wins * 100.0 / total : 0.0;
}

// Expected value for a cell
double DNA_CellEV(int wins, int losses, double totalProfit, double totalLoss)
{
   int total = wins + losses;
   if(total < 2) return 0.0;
   double avgW = (wins   > 0) ? totalProfit / wins   : 0.0;
   double avgL = (losses > 0) ? totalLoss   / losses : 0.0;
   double wr   = wins * 1.0 / total;
   return (wr * avgW) - ((1.0 - wr) * avgL);
}

// Find best index in a breakdown dimension
int DNA_BestDimIndex(int symIdx, string dim, int dimSize)
{
   int    best_i  = 0;
   double best_ev = -999999;

   for(int i = 0; i < dimSize; i++)
   {
      int    w, l; double tp, tl;
      int    k;

      if(dim == "session")
      {
         k = symIdx * DNA_SESSIONS + i;
         w = G_DNA_SessWins[k]; l = G_DNA_SessLosses[k];
         tp = G_DNA_SessProfit[k]; tl = G_DNA_SessLoss[k];
      }
      else if(dim == "regime")
      {
         k = symIdx * DNA_REGIMES + i;
         w = G_DNA_RegWins[k]; l = G_DNA_RegLosses[k];
         tp = G_DNA_RegProfit[k]; tl = G_DNA_RegLoss[k];
      }
      else if(dim == "strategy")
      {
         k = symIdx * DNA_STRATEGIES + i;
         w = G_DNA_StrWins[k]; l = G_DNA_StrLosses[k];
         tp = G_DNA_StrProfit[k]; tl = G_DNA_StrLoss[k];
      }
      else // hour
      {
         k = symIdx * DNA_HOURS + i;
         w = G_DNA_HrWins[k]; l = G_DNA_HrLosses[k];
         tp = G_DNA_HrProfit[k]; tl = G_DNA_HrLoss[k];
      }

      if(w + l < 2) continue;
      double ev = DNA_CellEV(w, l, tp, tl);
      if(ev > best_ev) { best_ev = ev; best_i = i; }
   }
   return best_i;
}

int DNA_WorstDimIndex(int symIdx, string dim, int dimSize)
{
   int    worst_i  = dimSize - 1;
   double worst_ev = 999999;

   for(int i = 0; i < dimSize; i++)
   {
      int    w, l; double tp, tl; int k;

      if(dim == "session")
      {
         k = symIdx * DNA_SESSIONS + i;
         w = G_DNA_SessWins[k]; l = G_DNA_SessLosses[k];
         tp = G_DNA_SessProfit[k]; tl = G_DNA_SessLoss[k];
      }
      else
      {
         k = symIdx * DNA_REGIMES + i;
         w = G_DNA_RegWins[k]; l = G_DNA_RegLosses[k];
         tp = G_DNA_RegProfit[k]; tl = G_DNA_RegLoss[k];
      }

      if(w + l < 2) continue;
      double ev = DNA_CellEV(w, l, tp, tl);
      if(ev < worst_ev) { worst_ev = ev; worst_i = i; }
   }
   return worst_i;
}

