// SECTION 6 — CLOUD SYNC (FIXED — Real WebRequest)
// =============================================================

void SyncWithCloud(string server_url)
{
   if(server_url == "" || MQLInfoInteger(MQL_TESTER)) return;

   string full_url = server_url + "?type=get_config"
                   + "&account=" + IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN));

   char   post_data[], result[];
   string res_headers;

   ResetLastError();
   int res = WebRequest("GET", full_url, NULL, 8000, post_data, result, res_headers);

   if(res != 200)
   {
      Print("⚠ Cloud Sync Failed: HTTP ", res, " | Error: ", GetLastError());
      return;
   }

   string response = CharArrayToString(result, 0, WHOLE_ARRAY, CP_UTF8);
   if(StringLen(response) < 5) return;

 
   // Kill Switch
   if(StringFind(response, "\"kill_switch\":\"ON\"")  >= 0 ||
      StringFind(response, "\"kill_switch\": \"ON\"") >= 0)
   {
      if(!G_Global_Kill_Switch)
      {
         G_Global_Kill_Switch = true;
         Print("☁️ CLOUD: Kill Switch ACTIVATED by admin.");
      }
   }
   else
   {
      G_Global_Kill_Switch = false;
   }

   // Risk Multiplier
   int mStart = StringFind(response, "\"multiplier\":\"");
   if(mStart >= 0)
   {
      mStart += 14;
      int mEnd = StringFind(response, "\"", mStart);
      if(mEnd > mStart)
      {
         double val = StringToDouble(StringSubstr(response, mStart, mEnd - mStart));
         if(val > 0.0 && val <= 3.0)
         {
            G_CloudRiskMultiplier = val;
         }
      }
   }

   // Min Confidence
   int cStart = StringFind(response, "\"min_confidence\":\"");
   if(cStart >= 0)
   {
      cStart += 18;
      int cEnd = StringFind(response, "\"", cStart);
      if(cEnd > cStart)
      {
         double val = StringToDouble(StringSubstr(response, cStart, cEnd - cStart));
         if(val >= 30.0 && val <= 100.0)
         {
            G_CloudMinConfidence = val;
         }
      }
   }

   // News Filter
   if(StringFind(response, "\"news_filter\":\"OFF\"") >= 0)
      G_CloudNewsFilter = false;
   else
      G_CloudNewsFilter = true;

 if(G_DebugMode)  Print("☁️ Cloud Sync OK | KillSwitch:", G_Global_Kill_Switch,
         " | Multiplier:", G_CloudRiskMultiplier,
         " | MinConf:", G_CloudMinConfidence);
}


