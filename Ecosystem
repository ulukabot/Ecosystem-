//+------------------------------------------------------------------+
bool ValidateLicence()
{
   if(MQLInfoInteger(MQL_TESTER) && Test_Bypass) return true;
   if(RAILWAY_URL == "") { Alert("🦉 No server URL configured."); return false; }

   g_instance_id = GetInstanceID();

   string account_id  = IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN));
   string company     = AccountInfoString(ACCOUNT_COMPANY);
   string hwid_str    = account_id + "_" + company;

   // ─── Build JSON payload ───
   string payload = "{";
   payload += "\"type\":\"validate\",";
   payload += "\"key\":\""     + Licence_Key + "\",";
   payload += "\"account\":\"" + account_id + "\",";
   payload += "\"balance\":\"" + DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2) + "\",";
   payload += "\"equity\":\""  + DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY), 2) + "\",";
   payload += "\"instance\":\"" + g_instance_id + "\",";
   payload += "\"broker\":\""  + company + "\",";
   payload += "\"hwid\":\""    + hwid_str + "\",";
   payload += "\"ip\":\""      + getClientIp() + "\"";
   payload += "}";

   char post_data[], result[];
   string res_headers;
   int len = StringToCharArray(payload, post_data, 0, WHOLE_ARRAY, CP_UTF8);
   if(len > 0) ArrayResize(post_data, len - 1);

   string url = RAILWAY_URL + "/validate";   // POST to /validate

   ResetLastError();
   int res = WebRequest("POST", url, "Content-Type: application/json\r\n", 15000, post_data, result, res_headers);

   if(res != 200)
   {
      Print("⚠️ Licence check HTTP: ", res);
      Alert("🦉 CONNECTION ERROR - HTTP " + IntegerToString(res));
      return false;
   }

   string response_body = CharArrayToString(result, 0, WHOLE_ARRAY, CP_UTF8);
   string clean = response_body;
   StringToLower(clean);

   if(StringFind(clean, "authorized") >= 0 || StringFind(clean, "uluka_master") >= 0)
   {
      if(Enable_Sound_Notifications) if(g_sound_enabled) PlaySound("::Files\\hoot.wav");

      string parts[];
      StringSplit(response_body, '|', parts);

      if(ArraySize(parts) >= 2)
      {
         // Parse expiry
         string expiry_str = parts[1];
         StringTrimRight(expiry_str);
         StringTrimLeft(expiry_str);
         if(ArraySize(parts) >= 3) g_client_name = parts[2];
         if(ArraySize(parts) >= 4 && StringToDouble(parts[3]) > 0)
         {
            g_cloud_tier_cap = StringToDouble(parts[3]);
         }

         string exp_parts[];
         int d = 0, m = 0, y = 0;

         // Try DD-MM-YYYY or DD/MM/YYYY first
         if(StringFind(expiry_str, "-") >= 0)      StringSplit(expiry_str, '-', exp_parts);
         else if(StringFind(expiry_str, "/") >= 0) StringSplit(expiry_str, '/', exp_parts);

         if(ArraySize(exp_parts) == 3)
         {
            d = (int)StringToInteger(exp_parts[0]);
            m = (int)StringToInteger(exp_parts[1]);
            y = (int)StringToInteger(exp_parts[2]);
         }
         else
         {
            // Fallback: parse JavaScript Date string
            string js_parts[];
            StringSplit(expiry_str, ' ', js_parts);
            if(ArraySize(js_parts) >= 4)
            {
               d = (int)StringToInteger(js_parts[2]);
               y = (int)StringToInteger(js_parts[3]);
               string mon = js_parts[1];
               if(mon=="Jan") m=1;  else if(mon=="Feb") m=2;
               else if(mon=="Mar") m=3;  else if(mon=="Apr") m=4;
               else if(mon=="May") m=5;  else if(mon=="Jun") m=6;
               else if(mon=="Jul") m=7;  else if(mon=="Aug") m=8;
               else if(mon=="Sep") m=9;  else if(mon=="Oct") m=10;
               else if(mon=="Nov") m=11; else if(mon=="Dec") m=12;
            }
         }

         if(d > 0 && m > 0 && y > 2000)
         {
            datetime expiry_date = StringToTime(StringFormat("%04d.%02d.%02d 23:59", y, m, d));
            MqlDateTime now_s;
            TimeToStruct(TimeCurrent(), now_s);
            datetime today = StringToTime(StringFormat("%04d.%02d.%02d 00:00:00",
                             now_s.year, now_s.mon, now_s.day));
            g_days_left    = (int)MathMax(0, (expiry_date - today) / 86400);
         }
      }

      static bool is_auth_printed = false;
      if(!is_auth_printed)
      {
         Alert("🦉 Client: Authorized - Welcome 💐 | " + g_client_name + " | " +
               IntegerToString(g_days_left) + " days left");
         is_auth_printed = true;
      }
      return true;
   }
   else
   {
      string raw = response_body;
      string reason = raw;
      StringToLower(raw);
      if(StringFind(raw, "not_found")       >= 0) reason = "Invalid key";
      else if(StringFind(raw, "expired")    >= 0) reason = "Licence expired";
      else if(StringFind(raw, "blacklisted")>= 0) reason = "Licence blacklisted";
      else if(StringFind(raw, "account_mismatch") >= 0) reason = "Wrong account (key locked to different account)";
      Alert("🦉 LICENCE REJECTED: " + reason);
      ExpertRemove();
      return false;
   }
}

