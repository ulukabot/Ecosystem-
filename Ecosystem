// | SECTION 29 — ATR ADAPTIVE TRAILING STOP (NEW) |
// +===============================================+

//+------------------------------------------------------------------+
//| ATR Adaptive Trailing Stop – works with stealth levels           |
//+------------------------------------------------------------------+


void ManageAdaptiveTrailing(string symbol, int magic, double atrMultiplier,
                             int startPoints, CTrade &tradeObj,
                             StealthLevels &stealth_arr[], bool useStealth)
{
   static ulong    last_ticket[100];
   static double   last_sl[100];
   static int      last_count = 0;

   int atrHandle = iATR(symbol, PERIOD_CURRENT, 14);
   if(atrHandle == INVALID_HANDLE) return;

   double atrBuf[];
   ArraySetAsSeries(atrBuf, true);
   if(CopyBuffer(atrHandle, 0, 0, 3, atrBuf) < 3)
   {
      IndicatorRelease(atrHandle);
      return;
   }
   double atr = atrBuf[0];
   IndicatorRelease(atrHandle);

   double point   = SymbolInfoDouble(symbol, SYMBOL_POINT);
   double minStop = (double)SymbolInfoInteger(symbol, SYMBOL_TRADE_STOPS_LEVEL) * point;
   double startD  = startPoints * point;   // threshold to begin trailing

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC)  != magic)   continue;
      if(PositionGetString(POSITION_SYMBOL) != symbol)  continue;

      double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      double currSL    = PositionGetDouble(POSITION_SL);
      double currTP    = PositionGetDouble(POSITION_TP);
      int    posType   = (int)PositionGetInteger(POSITION_TYPE);

      double effectiveSL = currSL;
      if(currSL == 0)
      {
         for(int k = 0; k < last_count; k++)
            if(last_ticket[k] == ticket) { effectiveSL = last_sl[k]; break; }
      }
      if(effectiveSL == 0) effectiveSL = openPrice;

      if(posType == POSITION_TYPE_BUY)
      {
         double bid    = SymbolInfoDouble(symbol, SYMBOL_BID);
         double profit = bid - openPrice;

         // --- Dynamic trailing: multiplier depends on profit relative to startD ---
         double dynamicMultiplier = 0.0;
         if(profit >= startD)
         {
            double profitRatio = profit / startD;   // how many times the start distance
            if(profitRatio < 2.0)
               dynamicMultiplier = 0.8;
            else if(profitRatio < 4.0)
               dynamicMultiplier = 1.0;
            else
               dynamicMultiplier = 1.5;
         }

         if(dynamicMultiplier > 0.0)
         {
            double trailD = atr * dynamicMultiplier;
            trailD = MathMax(trailD, minStop * 2);

            double newSL = bid - trailD;
            newSL = NormalizeDouble(newSL, (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS));

            // 🔥 MONOTONIC GUARD: never pull SL back (for BUY)
            if(effectiveSL != openPrice && newSL <= effectiveSL)
               continue;

            if(newSL > effectiveSL && (bid - newSL) >= minStop)
            {
               bool success = false;
               if(useStealth)
               {
                  UpdateStealthSL(ticket, newSL, stealth_arr);
                  success = true;
               }
               else
               {
                  success = tradeObj.PositionModify(ticket, newSL, currTP);
               }
               if(success)
               {
                  int idx = -1;
                  for(int k = 0; k < last_count; k++)
                     if(last_ticket[k] == ticket) { idx = k; break; }
                  if(idx == -1 && last_count < 100)
                  {
                     idx = last_count++;
                     last_ticket[idx] = ticket;
                  }
                  if(idx >= 0) last_sl[idx] = newSL;
               }
            }
         }
      }

      if(posType == POSITION_TYPE_SELL)
      {
         double ask    = SymbolInfoDouble(symbol, SYMBOL_ASK);
         double profit = openPrice - ask;

         double dynamicMultiplier = 0.0;
         if(profit >= startD)
         {
            double profitRatio = profit / startD;
            if(profitRatio < 2.0)
               dynamicMultiplier = 0.8;
            else if(profitRatio < 4.0)
               dynamicMultiplier = 1.0;
            else
               dynamicMultiplier = 1.5;
         }

         if(dynamicMultiplier > 0.0)
         {
            double trailD = atr * dynamicMultiplier;
            trailD = MathMax(trailD, minStop * 2);

            double newSL = ask + trailD;
            newSL = NormalizeDouble(newSL, (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS));

            // 🔥 MONOTONIC GUARD: never pull SL back (for SELL)
            if(effectiveSL != openPrice && newSL >= effectiveSL)
               continue;

            if((newSL < effectiveSL || effectiveSL == openPrice) && (newSL - ask) >= minStop)
            {
               bool success = false;
               if(useStealth)
               {
                  UpdateStealthSL(ticket, newSL, stealth_arr);
                  success = true;
               }
               else
               {
                  success = tradeObj.PositionModify(ticket, newSL, currTP);
               }
               if(success)
               {
                  int idx = -1;
                  for(int k = 0; k < last_count; k++)
                     if(last_ticket[k] == ticket) { idx = k; break; }
                  if(idx == -1 && last_count < 100)
                  {
                     idx = last_count++;
                     last_ticket[idx] = ticket;
                  }
                  if(idx >= 0) last_sl[idx] = newSL;
               }
            }
         }
      }
   }
}


// =============================================================
// SECTION 30 — PARTIAL CLOSE (TP1 / TP2 / TP3) (PRODUCTION FIX)
// =============================================================

void ManagePartialClose(string symbol, int magic, CTrade &tradeObj,
                        double tp1Ratio, double tp2Ratio, double tp3Ratio,
                        StealthLevels &stealth_arr[], bool useStealth)
{
   if(tp1Ratio <= 0 && tp2Ratio <= 0) return;

   static ulong    sl_moved_to_tp1[100];
   static int      sl_moved_tp1_count = 0;
   static ulong    sl_moved_to_tp2[100];
   static int      sl_moved_tp2_count = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(!PositionSelectByTicket(ticket))          continue;
      if(PositionGetInteger(POSITION_MAGIC)  != magic)  continue;
      if(PositionGetString(POSITION_SYMBOL) != symbol) continue;

      double openPrice   = PositionGetDouble(POSITION_PRICE_OPEN);
      double openSL      = PositionGetDouble(POSITION_SL);
      double openVolume  = PositionGetDouble(POSITION_VOLUME);
      int    posType     = (int)PositionGetInteger(POSITION_TYPE);
      string comment     = PositionGetString(POSITION_COMMENT);

      // --- Get current effective SL (respect stealth) ---
      double currentSL = openSL;
      if(useStealth && currentSL == 0)
      {
         for(int s=0; s<ArraySize(stealth_arr); s++)
            if(stealth_arr[s].ticket == ticket) { currentSL = stealth_arr[s].sl; break; }
      }
      if(currentSL == 0) currentSL = openPrice; // fallback

      double slDist = MathAbs(openPrice - currentSL);
      if(slDist <= 0) slDist = MathAbs(openPrice - openSL);
      if(slDist <= 0) continue;

      double minVol = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
      double step   = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);
      double point  = SymbolInfoDouble(symbol, SYMBOL_POINT);
      int    digits = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);

      // ==================== BUY ====================
      if(posType == POSITION_TYPE_BUY)
      {
         double bid    = SymbolInfoDouble(symbol, SYMBOL_BID);
         double profit = bid - openPrice;

         // ---- TP2 ----
         if(tp2Ratio > 0 && profit >= slDist * tp2Ratio && StringFind(comment, "_TP2") < 0)
         {
            if(!PositionSelectByTicket(ticket)) continue;
            double currentVol = PositionGetDouble(POSITION_VOLUME);
            double targetPct = 50.0;
            double closeVol = NormalizeDouble(MathMax(MathFloor(currentVol * (targetPct / 100.0) / step) * step, minVol), 2);
            // Safety: never close more than 90% of current (leaves at least 10% runner)
            if(closeVol >= currentVol) closeVol = NormalizeDouble(currentVol * 0.9, 2);
            if(closeVol < minVol) closeVol = minVol;

            if(closeVol < currentVol && tradeObj.PositionClosePartial(ticket, closeVol))
            {
               // --- LOG: read actual broker deal ---
               ulong dealTicket = tradeObj.ResultDeal();
               if(HistoryDealSelect(dealTicket))
               {
                  double actualClosed = HistoryDealGetDouble(dealTicket, DEAL_VOLUME);
                  double volBefore   = currentVol;
                  double remaining   = volBefore - actualClosed;
                  double actualPct    = (volBefore > 0) ? (actualClosed / volBefore) * 100.0 : 0.0;
                  Print("🦉 Partial TP2 | BUY #", ticket,
                        " | Closed: ", DoubleToString(actualClosed, 2),
                        " lots (", DoubleToString(actualPct, 1), "%)",
                        " | Remaining: ", DoubleToString(remaining, 2));
               }
               else
               {
                  Print("🦉 Partial TP2 | BUY #", ticket,
                        " | Closed: ", DoubleToString(closeVol, 2), " lots (approx)");
               }

               // Lock SL to TP1 (or BE)
               if(tp1Ratio > 0)
               {
                  double lockSL = openPrice + slDist * tp1Ratio - point;
                  if(bid - lockSL > (double)SymbolInfoInteger(symbol, SYMBOL_TRADE_STOPS_LEVEL) * point)
                  {
                     if(useStealth) UpdateStealthSL(ticket, lockSL, stealth_arr);
                     else tradeObj.PositionModify(ticket, lockSL, PositionGetDouble(POSITION_TP));
                  }
               }
               if(!useStealth)
   tradeObj.PositionModify(ticket, PositionGetDouble(POSITION_SL), PositionGetDouble(POSITION_TP));

               if(sl_moved_tp2_count < 100)
               {
                  sl_moved_to_tp2[sl_moved_tp2_count] = ticket;
                  sl_moved_tp2_count++;
               }
            }
            else if(closeVol >= currentVol) // Cannot partial close – move SL to TP2
            {
               double tp2Price = openPrice + slDist * tp2Ratio - point;
               if(currentSL < tp2Price && (tp2Price - currentSL) > point*2)
               {
                  bool alreadyMoved = false;
                  for(int m=0; m<sl_moved_tp2_count; m++)
                     if(sl_moved_to_tp2[m] == ticket) { alreadyMoved = true; break; }
                  if(!alreadyMoved)
                  {
                    if(G_DebugMode) Print("🔒 Min lot (", currentVol, ") | BUY #", ticket,
                           " | Moving SL to TP2: ", DoubleToString(tp2Price, digits));
                     if(useStealth) UpdateStealthSL(ticket, tp2Price, stealth_arr);
                     else tradeObj.PositionModify(ticket, tp2Price, PositionGetDouble(POSITION_TP));
                     if(sl_moved_tp2_count < 100) sl_moved_to_tp2[sl_moved_tp2_count++] = ticket;
                  }
               }
            }
         }

         // ---- TP1 ----
         else if(tp1Ratio > 0 && profit >= slDist * tp1Ratio &&
                 StringFind(comment, "_TP1") < 0 && StringFind(comment, "_TP2") < 0)
         {
            bool tp2AlreadyHit = false;
            for(int m=0; m<sl_moved_tp2_count; m++)
               if(sl_moved_to_tp2[m] == ticket) { tp2AlreadyHit = true; break; }
            if(!tp2AlreadyHit)
            {
               double targetPct = 70.0;
               double closeVol = NormalizeDouble(MathMax(MathFloor(openVolume * (targetPct / 100.0) / step) * step, minVol), 2);
               if(closeVol >= openVolume) closeVol = NormalizeDouble(openVolume * 0.9, 2);
               if(closeVol < minVol) closeVol = minVol;

               if(closeVol < openVolume && tradeObj.PositionClosePartial(ticket, closeVol))
               {
                  ulong dealTicket = tradeObj.ResultDeal();
                  if(HistoryDealSelect(dealTicket))
                  {
                     double actualClosed = HistoryDealGetDouble(dealTicket, DEAL_VOLUME);
                     double volBefore   = openVolume;
                     double remaining   = volBefore - actualClosed;
                     double actualPct    = (volBefore > 0) ? (actualClosed / volBefore) * 100.0 : 0.0;
                     Print("🦉 Partial TP1 | BUY #", ticket,
                           " | Closed: ", DoubleToString(actualClosed, 2),
                           " lots (", DoubleToString(actualPct, 1), "%)",
                           " | Remaining: ", DoubleToString(remaining, 2));
                  }
                  else
                  {
                     Print("🦉 Partial TP1 | BUY #", ticket,
                           " | Closed: ", DoubleToString(closeVol, 2), " lots (approx)");
                  }

                  double beSL = openPrice + point;
                  if(bid - beSL > (double)SymbolInfoInteger(symbol, SYMBOL_TRADE_STOPS_LEVEL) * point)
                  {
                     if(useStealth) UpdateStealthSL(ticket, beSL, stealth_arr);
                     else tradeObj.PositionModify(ticket, beSL, PositionGetDouble(POSITION_TP));
                  }
               }
               else if(closeVol >= openVolume) // Cannot partial close – move SL to TP1
               {
                  double tp1Price = openPrice + slDist * tp1Ratio - point;
                  if(currentSL < tp1Price && (tp1Price - currentSL) > point*2)
                  {
                     bool alreadyMoved = false;
                     for(int m=0; m<sl_moved_tp1_count; m++)
                        if(sl_moved_to_tp1[m] == ticket) { alreadyMoved = true; break; }
                     if(!alreadyMoved)
                     {
                        Print("🔒 Min lot (", openVolume, ") | BUY #", ticket,
                              " | Moving SL to TP1: ", DoubleToString(tp1Price, digits));
                        if(useStealth) UpdateStealthSL(ticket, tp1Price, stealth_arr);
                        else tradeObj.PositionModify(ticket, tp1Price, PositionGetDouble(POSITION_TP));
                        if(sl_moved_tp1_count < 100) sl_moved_to_tp1[sl_moved_tp1_count++] = ticket;
                     }
                  }
               }
            }
         }
      }

      // ==================== SELL ====================
      if(posType == POSITION_TYPE_SELL)
      {
         double ask    = SymbolInfoDouble(symbol, SYMBOL_ASK);
         double profit = openPrice - ask;

         // ---- TP2 ----
         if(tp2Ratio > 0 && profit >= slDist * tp2Ratio && StringFind(comment, "_TP2") < 0)
         {
            if(!PositionSelectByTicket(ticket)) continue;
            double currentVol = PositionGetDouble(POSITION_VOLUME);
            double targetPct = 50.0;
            double closeVol = NormalizeDouble(MathMax(MathFloor(currentVol * (targetPct / 100.0) / step) * step, minVol), 2);
            if(closeVol >= currentVol) closeVol = NormalizeDouble(currentVol * 0.9, 2);
            if(closeVol < minVol) closeVol = minVol;

            if(closeVol < currentVol && tradeObj.PositionClosePartial(ticket, closeVol))
            {
               ulong dealTicket = tradeObj.ResultDeal();
               if(HistoryDealSelect(dealTicket))
               {
                  double actualClosed = HistoryDealGetDouble(dealTicket, DEAL_VOLUME);
                  double volBefore   = currentVol;
                  double remaining   = volBefore - actualClosed;
                  double actualPct    = (volBefore > 0) ? (actualClosed / volBefore) * 100.0 : 0.0;
                  Print("🦉 Partial TP2 | SELL #", ticket,
                        " | Closed: ", DoubleToString(actualClosed, 2),
                        " lots (", DoubleToString(actualPct, 1), "%)",
                        " | Remaining: ", DoubleToString(remaining, 2));
               }
               else
               {
                  Print("🦉 Partial TP2 | SELL #", ticket,
                        " | Closed: ", DoubleToString(closeVol, 2), " lots (approx)");
               }

               if(tp1Ratio > 0)
               {
                  double lockSL = openPrice - slDist * tp1Ratio + point;
                  if(lockSL - ask > (double)SymbolInfoInteger(symbol, SYMBOL_TRADE_STOPS_LEVEL) * point)
                  {
                     if(useStealth) UpdateStealthSL(ticket, lockSL, stealth_arr);
                     else tradeObj.PositionModify(ticket, lockSL, PositionGetDouble(POSITION_TP));
                  }
               }
               if(!useStealth)
   tradeObj.PositionModify(ticket, PositionGetDouble(POSITION_SL), PositionGetDouble(POSITION_TP));

               if(sl_moved_tp2_count < 100)
               {
                  sl_moved_to_tp2[sl_moved_tp2_count] = ticket;
                  sl_moved_tp2_count++;
               }
            }
            else if(closeVol >= currentVol)
            {
               double tp2Price = openPrice - slDist * tp2Ratio + point;
               if(currentSL > tp2Price && (currentSL - tp2Price) > point*2)
               {
                  bool alreadyMoved = false;
                  for(int m=0; m<sl_moved_tp2_count; m++)
                     if(sl_moved_to_tp2[m] == ticket) { alreadyMoved = true; break; }
                  if(!alreadyMoved)
                  {
                     Print("🔒 Min lot (", currentVol, ") | SELL #", ticket,
                           " | Moving SL to TP2: ", DoubleToString(tp2Price, digits));
                     if(useStealth) UpdateStealthSL(ticket, tp2Price, stealth_arr);
                     else tradeObj.PositionModify(ticket, tp2Price, PositionGetDouble(POSITION_TP));
                     if(sl_moved_tp2_count < 100) sl_moved_to_tp2[sl_moved_tp2_count++] = ticket;
                  }
               }
            }
         }

         // ---- TP1 ----
         else if(tp1Ratio > 0 && profit >= slDist * tp1Ratio &&
                 StringFind(comment, "_TP1") < 0 && StringFind(comment, "_TP2") < 0)
         {
            bool tp2AlreadyHit = false;
            for(int m=0; m<sl_moved_tp2_count; m++)
               if(sl_moved_to_tp2[m] == ticket) { tp2AlreadyHit = true; break; }
            if(!tp2AlreadyHit)
            {
               double targetPct = 70.0;
               double closeVol = NormalizeDouble(MathMax(MathFloor(openVolume * (targetPct / 100.0) / step) * step, minVol), 2);
               if(closeVol >= openVolume) closeVol = NormalizeDouble(openVolume * 0.9, 2);
               if(closeVol < minVol) closeVol = minVol;

               if(closeVol < openVolume && tradeObj.PositionClosePartial(ticket, closeVol))
               {
                  ulong dealTicket = tradeObj.ResultDeal();
                  if(HistoryDealSelect(dealTicket))
                  {
                     double actualClosed = HistoryDealGetDouble(dealTicket, DEAL_VOLUME);
                     double volBefore   = openVolume;
                     double remaining   = volBefore - actualClosed;
                     double actualPct    = (volBefore > 0) ? (actualClosed / volBefore) * 100.0 : 0.0;
                     Print("🦉 Partial TP1 | SELL #", ticket,
                           " | Closed: ", DoubleToString(actualClosed, 2),
                           " lots (", DoubleToString(actualPct, 1), "%)",
                           " | Remaining: ", DoubleToString(remaining, 2));
                  }
                  else
                  {
                     Print("🦉 Partial TP1 | SELL #", ticket,
                           " | Closed: ", DoubleToString(closeVol, 2), " lots (approx)");
                  }

                  double beSL = openPrice - point;
                  if(beSL - ask > (double)SymbolInfoInteger(symbol, SYMBOL_TRADE_STOPS_LEVEL) * point)
                  {
                     if(useStealth) UpdateStealthSL(ticket, beSL, stealth_arr);
                     else tradeObj.PositionModify(ticket, beSL, PositionGetDouble(POSITION_TP));
                  }
               }
               else if(closeVol >= openVolume)
               {
                  double tp1Price = openPrice - slDist * tp1Ratio + point;
                  if(currentSL > tp1Price && (currentSL - tp1Price) > point*2)
                  {
                     bool alreadyMoved = false;
                     for(int m=0; m<sl_moved_tp1_count; m++)
                        if(sl_moved_to_tp1[m] == ticket) { alreadyMoved = true; break; }
                     if(!alreadyMoved)
                     {
                        Print("🔒 Min lot (", openVolume, ") | SELL #", ticket,
                              " | Moving SL to TP1: ", DoubleToString(tp1Price, digits));
                        if(useStealth) UpdateStealthSL(ticket, tp1Price, stealth_arr);
                        else tradeObj.PositionModify(ticket, tp1Price, PositionGetDouble(POSITION_TP));
                        if(sl_moved_tp1_count < 100) sl_moved_to_tp1[sl_moved_tp1_count++] = ticket;
                     }
                  }
               }
            }
         }
      }
   }
}


// =============================================================
// SECTION 31 — ACCOUNT HEALTH SCORE (NEW — Unique Feature)
// =============================================================

int CalculateHealthScore(double dailyPnL, double startEquity, int wins, int losses,
                         int consecutiveLosses, double floatingDDPercent,
                         double maxDDLimit, double riskPercent)
{
   int score = 100;

   // ?? Drawdown Penalty ??
   if(startEquity > 0)
   {
      double ddPercent = (dailyPnL < 0) ? MathAbs(dailyPnL / startEquity * 100) : 0;
      if(ddPercent >= maxDDLimit * 0.8)  score -= 40;  // Near limit
      else if(ddPercent >= maxDDLimit * 0.5) score -= 20;
      else if(ddPercent >= maxDDLimit * 0.3) score -= 10;
   }

   // ?? Floating DD Penalty ??
   if(floatingDDPercent > 2.0) score -= 20;
   else if(floatingDDPercent > 1.0) score -= 10;

   // ?? Win Rate Score ??
   int totalTrades = wins + losses;
   if(totalTrades >= 3)
   {
      double winRate = (double)wins / totalTrades * 100.0;
      if(winRate >= 70)      score += 10;
      else if(winRate >= 55) score += 5;
      else if(winRate < 40)  score -= 10;
      else if(winRate < 30)  score -= 20;
   }

   // ?? Consecutive Loss Penalty ??
   if(consecutiveLosses == 1)      score -= 5;
   else if(consecutiveLosses == 2) score -= 15;
   else if(consecutiveLosses == 3) score -= 25;
   else if(consecutiveLosses >= 4) score -= 40;

   // ?? Risk Compliance ??
   if(riskPercent <= 1.0)      score += 5;   // Conservative = healthy
   else if(riskPercent > 2.0)  score -= 10;  // High risk = less healthy

   // Clamp 0-100
   score = (int)MathMax(0, MathMin(100, score));
   G_HealthScore = score;

   return score;
}

string GetHealthScoreLabel(int score)
{
   if(score >= 85) return "🦉 EXCELLENT";
   if(score >= 70) return "🦉 GOOD";
   if(score >= 50) return "🦉 FAIR";
   if(score >= 30) return "🦉 POOR";
   return "? CRITICAL";
}

