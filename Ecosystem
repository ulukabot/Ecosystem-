OrderBlock GetNearestOrderBlock(string symbol, ENUM_TIMEFRAMES tf, ENUM_ORDER_TYPE tradeType)
{
   OrderBlock ob;
   ob.valid = false;
   ob.top   = 0;
   ob.bottom = 0;

   double opens[], closes[], highs[], lows[];
   ArraySetAsSeries(opens,  true);
   ArraySetAsSeries(closes, true);
   ArraySetAsSeries(highs,  true);
   ArraySetAsSeries(lows,   true);

   if(CopyOpen(symbol,  tf, 0, 30, opens)  < 30) return ob;
   if(CopyClose(symbol, tf, 0, 30, closes) < 30) return ob;
   if(CopyHigh(symbol,  tf, 0, 30, highs)  < 30) return ob;
   if(CopyLow(symbol,   tf, 0, 30, lows)   < 30) return ob;

   double currentPrice = (tradeType == ORDER_TYPE_BUY) ?
                         SymbolInfoDouble(symbol, SYMBOL_ASK) :
                         SymbolInfoDouble(symbol, SYMBOL_BID);

   // Bullish OB: last bearish candle before a strong bullish impulse
   if(tradeType == ORDER_TYPE_BUY)
   {
      for(int i = 3; i < 25; i++)
      {
         bool isBearish  = (closes[i] < opens[i]);
         bool nextBullish = (closes[i-1] > opens[i-1] && closes[i-2] > opens[i-2]);
         bool strongImpulse = (closes[i-1] - opens[i-1]) > (highs[i] - lows[i]) * 0.5;

         if(isBearish && nextBullish && strongImpulse)
         {
            // OB zone = the bearish candle's body
            double obTop    = MathMax(opens[i], closes[i]);
            double obBottom = MathMin(opens[i], closes[i]);

            // Only valid if current price is above OB (approaching for retest from above)
            if(currentPrice > obBottom && currentPrice < obTop * 1.002)
            {
               ob.top      = obTop;
               ob.bottom   = obBottom;
               ob.isBullish = true;
               ob.valid    = true;
               static datetime last_bearish_print = 0;
static string last_bearish_key = "";
string bearish_key = DoubleToString(obBottom, 5) + "_" + DoubleToString(obTop, 5);
if(TimeCurrent() - last_bearish_print >= 60 || last_bearish_key != bearish_key)
{
   static datetime last_bear_ob_print = 0;
   if(TimeCurrent() - last_bear_ob_print >= PeriodSeconds(PERIOD_CURRENT))
   {
      if(G_DebugMode) Print("📊 Bullish OB on ", symbol, ": ", DoubleToString(obBottom, _Digits), " – ", DoubleToString(obTop, _Digits));
      last_bear_ob_print = TimeCurrent();
   }
   last_bearish_print = TimeCurrent();
   last_bearish_key = bearish_key;
}
               return ob;
            }
         }
      }
   }

   // Bearish OB: last bullish candle before a strong bearish impulse
   if(tradeType == ORDER_TYPE_SELL)
   {
      for(int i = 3; i < 25; i++)
      {
         bool isBullish   = (closes[i] > opens[i]);
         bool nextBearish = (closes[i-1] < opens[i-1] && closes[i-2] < opens[i-2]);
         bool strongImpulse = (opens[i-1] - closes[i-1]) > (highs[i] - lows[i]) * 0.5;

         if(isBullish && nextBearish && strongImpulse)
         {
            double obTop    = MathMax(opens[i], closes[i]);
            double obBottom = MathMin(opens[i], closes[i]);

            if(currentPrice < obTop && currentPrice > obBottom * 0.998)
            {
               ob.top       = obTop;
               ob.bottom    = obBottom;
               ob.isBullish = false;
               ob.valid     = true;
               // Cooldown for Bearish OB
static datetime last_bearish_print = 0;
static string last_bearish_key = "";
string bearish_key = DoubleToString(obBottom, 5) + "_" + DoubleToString(obTop, 5);
if(TimeCurrent() - last_bearish_print >= 60 || last_bearish_key != bearish_key)
{
   static datetime last_bear_ob_print = 0;
   if(TimeCurrent() - last_bear_ob_print >= PeriodSeconds(PERIOD_CURRENT))
   {
    if(G_DebugMode) Print("📊 Bearish OB on ", symbol, ": ", DoubleToString(obBottom, _Digits), " – ", DoubleToString(obTop, _Digits));
      last_bear_ob_print = TimeCurrent();
   }
   last_bearish_print = TimeCurrent();
   last_bearish_key = bearish_key;
}
               return ob;
            }
         }
      }
   }

   return ob;
}

