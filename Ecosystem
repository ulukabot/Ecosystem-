// SECTION 14 — SMC: LIQUIDITY SWEEP DETECTION (NEW)
// =============================================================

bool IsLiquiditySweepPresent(string symbol, ENUM_TIMEFRAMES tf, ENUM_ORDER_TYPE tradeType)
{
   // Get last 50 candles
   double highs[], lows[], closes[], opens[];
   ArraySetAsSeries(highs,  true);
   ArraySetAsSeries(lows,   true);
   ArraySetAsSeries(closes, true);
   ArraySetAsSeries(opens,  true);

   if(CopyHigh(symbol,  tf, 0, 50, highs)  < 50) return false;
   if(CopyLow(symbol,   tf, 0, 50, lows)   < 50) return false;
   if(CopyClose(symbol, tf, 0, 50, closes) < 50) return false;
   if(CopyOpen(symbol,  tf, 0, 50, opens)  < 50) return false;

   // Find recent swing high/low as liquidity pool (bars 5-30, skip last 5)
   double swingHigh = 0, swingLow = 999999;
   for(int i = 5; i < 30; i++)
   {
      if(highs[i] > swingHigh) swingHigh = highs[i];
      if(lows[i]  < swingLow)  swingLow  = lows[i];
   }

   // THROTTLE: print only once per bar
   static datetime lastBarTime = 0;
   datetime currentBar = iTime(symbol, tf, 0);
   bool shouldPrint = (currentBar != lastBarTime);

   // For BUY: look for bullish sweep (price swept below swingLow and rejected back up)
   if(tradeType == ORDER_TYPE_BUY)
   {
      bool sweptLow = (lows[1] < swingLow);
      bool rejectedUp = (closes[1] > opens[1]);
      bool strongRejection = (closes[1] > (lows[1] + (highs[1] - lows[1]) * 0.5));

      if(sweptLow && rejectedUp && strongRejection)
      {
         if(shouldPrint)
{
  if(G_DebugMode) Print("📊 Liquidity Sweep (BULLISH) on ", symbol, ": Swept low at ", DoubleToString(swingLow, _Digits));
   lastBarTime = currentBar;
}
         return true;
      }
   }

   // For SELL: look for bearish sweep (price swept above swingHigh and rejected back down)
   if(tradeType == ORDER_TYPE_SELL)
   {
      bool sweptHigh = (highs[1] > swingHigh);
      bool rejectedDown = (closes[1] < opens[1]);
      bool strongRejection = (closes[1] < (highs[1] - (highs[1] - lows[1]) * 0.5));

      if(sweptHigh && rejectedDown && strongRejection)
      {
         if(shouldPrint)
{
   Print("📊 Liquidity Sweep (BEARISH) on ", symbol, ": Swept high at ", DoubleToString(swingHigh, _Digits));
   lastBarTime = currentBar;
}
         return true;
      }
   }

   return false;
}

