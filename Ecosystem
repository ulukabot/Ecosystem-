// SECTION 16 — SMC: CHoCH DETECTION (NEW)
// =============================================================

bool IsCHoCHPresent(string symbol, ENUM_TIMEFRAMES tf, ENUM_ORDER_TYPE tradeType)
{
   double highs[], lows[], closes[];
   ArraySetAsSeries(highs,  true);
   ArraySetAsSeries(lows,   true);
   ArraySetAsSeries(closes, true);

   if(CopyHigh(symbol,  tf, 0, 40, highs)  < 40) return false;
   if(CopyLow(symbol,   tf, 0, 40, lows)   < 40) return false;
   if(CopyClose(symbol, tf, 0, 40, closes) < 40) return false;

   // Identify the prior trend direction using Higher Highs / Lower Lows
   // Then detect the first opposing BOS (CHoCH)

   // Count HH/HL vs LH/LL in bars 10-35 to determine prior trend
   int bullCount = 0, bearCount = 0;
   double lastHigh = highs[35], lastLow = lows[35];

   for(int i = 34; i >= 10; i--)
   {
      if(highs[i] > lastHigh) { bullCount++; lastHigh = highs[i]; }
      if(lows[i]  < lastLow)  { bearCount++; lastLow  = lows[i];  }
   }

   // CHoCH BUY: Prior trend was BEARISH, now first BOS to the upside
   if(tradeType == ORDER_TYPE_BUY && bearCount > bullCount)
{
   double recentSwingHigh = 0;
   for(int i = 5; i < 20; i++) { if(highs[i] > recentSwingHigh) recentSwingHigh = highs[i]; }
   if(recentSwingHigh > 0 && closes[1] > recentSwingHigh)
   {
      static datetime last_choch_bull_print = 0;
if(TimeCurrent() - last_choch_bull_print >= PeriodSeconds(PERIOD_CURRENT))
{
  if(G_DebugMode) Print("📊 CHoCH BULLISH on ", symbol, ": Prior downtrend broken. Bearish → Bullish shift.");
   last_choch_bull_print = TimeCurrent();
}
      return true;
   }
}

   // CHoCH SELL: Prior trend was BULLISH, now first BOS to the downside
   if(tradeType == ORDER_TYPE_SELL && bullCount > bearCount)
   {
      double recentSwingLow = 999999;
      for(int i = 5; i < 20; i++)
      {
         if(lows[i] < recentSwingLow) recentSwingLow = lows[i];
      }
      if(recentSwingLow < 999999 && closes[1] < recentSwingLow)
      {
         static datetime last_choch_print = 0;
if(TimeCurrent() - last_choch_print >= PeriodSeconds(PERIOD_CURRENT))
{
   Print("📊 CHoCH BEARISH on ", symbol, ": Prior uptrend broken. Bullish → Bearish shift.");
   last_choch_print = TimeCurrent();
}
         return true;
      }
   }

   return false;
}

