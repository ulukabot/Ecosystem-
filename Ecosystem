//+------------------------------------------------------------------+
//| INDEPENDENT TRUE RANGE DETECTION (Used only by Shadow BR)       |
//+------------------------------------------------------------------+
bool IsTrueRange(double rangeHigh, double rangeLow, double atrVal,
                 const double &high[], const double &low[], const double &close[])
{
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   if(point <= 0) return false;
   
   // 🔥 Throttle static variable (once per bar)
   static datetime s_last_print_bar = 0;
   datetime current_bar = iTime(_Symbol, PERIOD_CURRENT, 0);
   
   double range = rangeHigh - rangeLow;
   if(range < atrVal * 0.5 || range > atrVal * 1.5) {
      if(G_DebugMode && current_bar != s_last_print_bar) {
         Print("⏳ BR Shadow: Range width not optimal (", DoubleToString(range/atrVal, 2), "x ATR)");
         s_last_print_bar = current_bar;
      }
      return false;
   }
   
   int highTouches = 0, lowTouches = 0;
   for(int i = 2; i < 20; i++) {
      if(high[i] >= rangeHigh - point * 2) highTouches++;
      if(low[i] <= rangeLow + point * 2) lowTouches++;
   }
   if(highTouches < 2 || lowTouches < 2) {
      if(G_DebugMode && current_bar != s_last_print_bar) {
         Print("⏳ BR Shadow: Not enough touches (H:", highTouches, " L:", lowTouches, ")");
         s_last_print_bar = current_bar;
      }
      return false;
   }
   
   int highRejections = 0, lowRejections = 0;
   for(int i = 2; i < 20; i++) {
      if(high[i] - close[i] > point * 5) highRejections++;
      if(close[i] - low[i] > point * 5) lowRejections++;
   }
   if(highRejections < 2 || lowRejections < 2) {
      if(G_DebugMode && current_bar != s_last_print_bar) {
         Print("⏳ BR Shadow: Not enough rejections (H:", highRejections, " L:", lowRejections, ")");
         s_last_print_bar = current_bar;
      }
      return false;
   }
   
   if(G_DebugMode && current_bar != s_last_print_bar) {
      Print("✅ BR Shadow: TRUE RANGE confirmed");
      s_last_print_bar = current_bar;
   }
   return true;
}

void RunBRShadow()
{
   if(!ENABLE_BREAK_RETEST) return;

   datetime currentBar = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(currentBar == 0) return;

   // --- Static throttling variables (one per print) ---
   static datetime s_last_timeout_print     = 0;
   static datetime s_last_true_range_print  = 0;
   static datetime s_last_not_true_print    = 0;
   static datetime s_last_bull_break_print  = 0;
   static datetime s_last_bear_break_print  = 0;
   static datetime s_last_bull_retest_print = 0;
   static datetime s_last_bear_retest_print = 0;
   static datetime s_last_bull_confirm_print= 0;
   static datetime s_last_bear_confirm_print= 0;

   if(currentBar != g_brShadowLastCandle) {
      g_brShadowLastCandle = currentBar;
      g_brShadowState.barsSinceBreak++;
      if(g_brShadowState.state == BR_BREAK_DETECTED && g_brShadowState.barsSinceBreak > BR_MAX_RETEST_BARS) {
         g_brShadowState.state = BR_INVALID;
         if(G_DebugMode && currentBar != s_last_timeout_print) {
            Print("⏳ BR Shadow: Retest timeout, invalidated");
            s_last_timeout_print = currentBar;
         }
      }
   }

   if(g_brShadowState.state == BR_CONFIRMED) {
      double atrVal = g_current_atr;
      if(atrVal <= 0) {
         double atrBuf[]; ArraySetAsSeries(atrBuf, true);
         int h = iATR(_Symbol, PERIOD_CURRENT, 14);
         if(CopyBuffer(h, 0, 0, 1, atrBuf) >= 1) atrVal = atrBuf[0];
         IndicatorRelease(h);
      }
      if(g_brPaperTradeCount < 200) {
         BRPaperTrade pt;
         pt.direction = g_brShadowState.direction;
         double price = (pt.direction == 1) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
         pt.entry = price;
         double slDist = atrVal * 1.5;
         if(pt.direction == 1) {
            pt.sl = pt.entry - slDist;
            pt.tp = pt.entry + slDist * 4.5;
         } else {
            pt.sl = pt.entry + slDist;
            pt.tp = pt.entry - slDist * 4.5;
         }
         pt.openTime = TimeCurrent();
         pt.isClosed = false;
         g_brPaperTrades[g_brPaperTradeCount] = pt;
         g_brPaperTradeCount++;
         Print("📝 BR SHADOW PAPER #", g_brPaperTradeCount, 
               " | ", (pt.direction == 1 ? "BUY" : "SELL"),
               " Entry: ", DoubleToString(pt.entry, _Digits),
               " SL: ", DoubleToString(pt.sl, _Digits),
               " TP: ", DoubleToString(pt.tp, _Digits));
      }
      g_brShadowState.state = BR_IDLE;
      return;
   }

   if(g_brShadowState.state == BR_INVALID) {
      g_brShadowState.state = BR_IDLE;
      return;
   }

   // Get price data
   double high[], low[], close[], openPrices[];
   ArraySetAsSeries(high, true); ArraySetAsSeries(low, true);
   ArraySetAsSeries(close, true); ArraySetAsSeries(openPrices, true);
   if(CopyHigh(_Symbol, PERIOD_CURRENT, 0, 30, high) < 30) return;
   if(CopyLow(_Symbol, PERIOD_CURRENT, 0, 30, low) < 30) return;
   if(CopyClose(_Symbol, PERIOD_CURRENT, 0, 30, close) < 30) return;
   if(CopyOpen(_Symbol, PERIOD_CURRENT, 0, 30, openPrices) < 30) return;

   double rangeHigh = 0, rangeLow = 0;
   bool rangeDefined = false;

   if(g_brShadowState.state == BR_IDLE) {
      rangeHigh = high[1];
      rangeLow = low[1];
      for(int i = 2; i < 21; i++) {
         if(high[i] > rangeHigh) rangeHigh = high[i];
         if(low[i] < rangeLow) rangeLow = low[i];
      }
      double atrVal = g_current_atr;
      if(atrVal <= 0) {
         double atrBuf[]; ArraySetAsSeries(atrBuf, true);
         int h = iATR(_Symbol, PERIOD_CURRENT, 14);
         if(CopyBuffer(h, 0, 0, 1, atrBuf) >= 1) atrVal = atrBuf[0];
         IndicatorRelease(h);
      }
      if(IsTrueRange(rangeHigh, rangeLow, atrVal, high, low, close)) {
         rangeDefined = true;
         if(G_DebugMode && currentBar != s_last_true_range_print) {
            Print("✅ BR Shadow: TRUE RANGE confirmed");
            s_last_true_range_print = currentBar;
         }
      } else {
         if(G_DebugMode && currentBar != s_last_not_true_print) {
            Print("⏳ BR Shadow: Not a true range – waiting");
            s_last_not_true_print = currentBar;
         }
         return;
      }
   } else {
      rangeHigh = g_brShadowState.rangeHigh;
      rangeLow = g_brShadowState.rangeLow;
      rangeDefined = (rangeHigh > 0 && rangeLow > 0);
   }

   if(!rangeDefined) return;

   double atrVal = g_current_atr;
   if(atrVal <= 0) {
      double atrBuf[]; ArraySetAsSeries(atrBuf, true);
      int h = iATR(_Symbol, PERIOD_CURRENT, 14);
      if(CopyBuffer(h, 0, 0, 1, atrBuf) >= 1) atrVal = atrBuf[0];
      IndicatorRelease(h);
   }
   double minBreakout = atrVal * BR_MIN_BREAKOUT_ATR;
   double tolerance = atrVal * BR_RETEST_TOLERANCE_ATR;

   switch(g_brShadowState.state) {
      case BR_IDLE: {
         if(close[1] > rangeHigh + minBreakout) {
            g_brShadowState.state = BR_BREAK_DETECTED;
            g_brShadowState.direction = 1;
            g_brShadowState.rangeHigh = rangeHigh;
            g_brShadowState.rangeLow = rangeLow;
            g_brShadowState.breakLevel = rangeHigh;
            g_brShadowState.barsSinceBreak = 0;
            g_brShadowState.retestTriggered = false;
            if(G_DebugMode && currentBar != s_last_bull_break_print) {
               Print("🔍 BR Shadow: Bullish breakout detected");
               s_last_bull_break_print = currentBar;
            }
         }
         else if(close[1] < rangeLow - minBreakout) {
            g_brShadowState.state = BR_BREAK_DETECTED;
            g_brShadowState.direction = -1;
            g_brShadowState.rangeHigh = rangeHigh;
            g_brShadowState.rangeLow = rangeLow;
            g_brShadowState.breakLevel = rangeLow;
            g_brShadowState.barsSinceBreak = 0;
            g_brShadowState.retestTriggered = false;
            if(G_DebugMode && currentBar != s_last_bear_break_print) {
               Print("🔍 BR Shadow: Bearish breakout detected");
               s_last_bear_break_print = currentBar;
            }
         }
         break;
      }
      case BR_BREAK_DETECTED: {
         double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         if(g_brShadowState.direction == 1) {
            if(!g_brShadowState.retestTriggered && ask <= g_brShadowState.breakLevel + tolerance) {
               g_brShadowState.retestTriggered = true;
               if(G_DebugMode && currentBar != s_last_bull_retest_print) {
                  Print("🔍 BR Shadow: Bullish retest triggered");
                  s_last_bull_retest_print = currentBar;
               }
            }
            if(g_brShadowState.retestTriggered && close[1] > openPrices[1] && close[1] > g_brShadowState.breakLevel) {
               g_brShadowState.state = BR_CONFIRMED;
               if(G_DebugMode && currentBar != s_last_bull_confirm_print) {
                  Print("✅ BR Shadow: BUY CONFIRMED (Paper Trade)");
                  s_last_bull_confirm_print = currentBar;
               }
            }
         } else {
            if(!g_brShadowState.retestTriggered && bid >= g_brShadowState.breakLevel - tolerance) {
               g_brShadowState.retestTriggered = true;
               if(G_DebugMode && currentBar != s_last_bear_retest_print) {
                  Print("🔍 BR Shadow: Bearish retest triggered");
                  s_last_bear_retest_print = currentBar;
               }
            }
            if(g_brShadowState.retestTriggered && close[1] < openPrices[1] && close[1] < g_brShadowState.breakLevel) {
               g_brShadowState.state = BR_CONFIRMED;
               if(G_DebugMode && currentBar != s_last_bear_confirm_print) {
                  Print("✅ BR Shadow: SELL CONFIRMED (Paper Trade)");
                  s_last_bear_confirm_print = currentBar;
               }
            }
         }
         break;
      }
   }
}

void MonitorBRPaperTrades()
{
   for(int i = 0; i < g_brPaperTradeCount; i++) {
      if(g_brPaperTrades[i].isClosed) continue;
      
      double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
      
      if(g_brPaperTrades[i].direction == 1) { // BUY
         if(bid <= g_brPaperTrades[i].sl) {
            g_brPaperTrades[i].isClosed = true;
            g_brPaperTrades[i].isWin = false;
            g_brPaperTrades[i].points = (g_brPaperTrades[i].sl - g_brPaperTrades[i].entry) / point;
            g_brPaperTrades[i].closeTime = TimeCurrent();
            Print("❌ BR PAPER SL #", i+1, " | Loss: ", DoubleToString(g_brPaperTrades[i].points, 1), " pts");
         }
         else if(bid >= g_brPaperTrades[i].tp) {
            g_brPaperTrades[i].isClosed = true;
            g_brPaperTrades[i].isWin = true;
            g_brPaperTrades[i].points = (g_brPaperTrades[i].tp - g_brPaperTrades[i].entry) / point;
            g_brPaperTrades[i].closeTime = TimeCurrent();
            Print("✅ BR PAPER TP #", i+1, " | Profit: ", DoubleToString(g_brPaperTrades[i].points, 1), " pts");
         }
      }
      else { // SELL
         if(ask >= g_brPaperTrades[i].sl) {
            g_brPaperTrades[i].isClosed = true;
            g_brPaperTrades[i].isWin = false;
            g_brPaperTrades[i].points = (g_brPaperTrades[i].entry - g_brPaperTrades[i].sl) / point;
            g_brPaperTrades[i].closeTime = TimeCurrent();
            Print("❌ BR PAPER SL #", i+1, " | Loss: ", DoubleToString(g_brPaperTrades[i].points, 1), " pts");
         }
         else if(ask <= g_brPaperTrades[i].tp) {
            g_brPaperTrades[i].isClosed = true;
            g_brPaperTrades[i].isWin = true;
            g_brPaperTrades[i].points = (g_brPaperTrades[i].entry - g_brPaperTrades[i].tp) / point;
            g_brPaperTrades[i].closeTime = TimeCurrent();
            Print("✅ BR PAPER TP #", i+1, " | Profit: ", DoubleToString(g_brPaperTrades[i].points, 1), " pts");
         }
      }
   }
}

