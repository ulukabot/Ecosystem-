     if(G_DebugMode) Print("✅ Telegram sent to ", chat_id);
   else
   {
      Print("❌ Telegram failed: HTTP ", res, " | Error: ", GetLastError());
      if(res == -1 && GetLastError() == 4060)
         Custom_Alert("TG_Error", "Add 'https://api.telegram.org' to MT5 Allowed URLs!");
