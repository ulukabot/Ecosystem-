// SECTION 23 — LOT ENGINE v5.7 — FORMULA CORRECTED
// =============================================================

double CalculateInstitutionalLot(string symbol, double stopPoints, double riskPercent, double profitScalingPct = 0.0, double maxLotCap = 0.0)
{
   double balance   = AccountInfoDouble(ACCOUNT_BALANCE);
   double tickValue = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize  = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
   double point     = SymbolInfoDouble(symbol, SYMBOL_POINT);
   double minL      = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
   double maxL      = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MAX);
   double step      = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);

   if(tickSize <= 0 || tickValue <= 0 || point <= 0 || stopPoints <= 0)
      return minL;

   // 1. Apply session/cloud/consecutive-loss multiplier
   double multiplier    = GetRiskMultiplier();
   double effectiveRisk = (riskPercent / 100.0) * multiplier;
   if(effectiveRisk <= 0) return 0.0;

   // v5.8: Today profit scaling - add X% of today booked profit to risk
   double profitBonus = 0.0;
   if(profitScalingPct > 0.0 && G_TodayRealizedProfit > 0.0)
   {
      profitBonus = G_TodayRealizedProfit * (profitScalingPct / 100.0);
      static datetime last_profit_scaling_print = 0;
if(TimeCurrent() - last_profit_scaling_print >= 60) // once per minute
{
  if(G_DebugMode) Print("📐 Profit Scaling: +$", DoubleToString(profitBonus, 2),
         " (", DoubleToString(profitScalingPct, 1), "% of $",
         DoubleToString(G_TodayRealizedProfit, 2), " today profit)");
   last_profit_scaling_print = TimeCurrent();
}
   }
   double riskMoney = balance * effectiveRisk + profitBonus;

   double costPerLot = (stopPoints * point / tickSize) * tickValue;
   if(costPerLot <= 0) return minL;

   // 3. Raw lot
   double lot = riskMoney / costPerLot;

   // 4. Normalize to broker rules
   lot = MathMax(lot, minL);
   lot = MathMin(lot, maxL);
   lot = MathFloor(lot / step) * step;
   
   
      // Apply user-defined max lot cap (if > 0)
   if(maxLotCap > 0 && lot > maxLotCap) {
      lot = maxLotCap;
     if(G_DebugMode) Print("📐 Lot capped to user-defined max: ", DoubleToString(lot, 2));
   }

   static datetime last_lot_print = 0;
if(TimeCurrent() - last_lot_print >= PeriodSeconds(PERIOD_CURRENT))
{
  if(G_DebugMode) Print("📐 LOT v5.7 | Bal: $", DoubleToString(balance, 2),
         " | Risk: ", DoubleToString(riskPercent, 2), "%",
         " | Mult: ",  DoubleToString(multiplier, 3),
         " | $Risk: $", DoubleToString(riskMoney, 2),
         " | SL: ", DoubleToString(stopPoints, 0), "pts",
         " | CostPerLot: $", DoubleToString(costPerLot, 2),
         " → Lot: ", DoubleToString(lot, 2));
   last_lot_print = TimeCurrent();
}

   return NormalizeDouble(lot, 2);
}


// ============================================================
// P8 — VOLATILITY ATR POSITION SIZING
// Returns a multiplier (0.5 - 1.5) based on current vs avg ATR
// Low volatility = larger position, High volatility = smaller
// ============================================================

double GetVolatilityATRMultiplier(string symbol, ENUM_TIMEFRAMES tf = PERIOD_H1)
{
   // Current ATR (14-period)
   int    hCurr = iATR(symbol, tf, 14);
   double currBuf[];
   ArraySetAsSeries(currBuf, true);
   if(hCurr == INVALID_HANDLE || CopyBuffer(hCurr, 0, 0, 1, currBuf) < 1)
   { IndicatorRelease(hCurr); return 1.0; }
   double currentATR = currBuf[0];
   IndicatorRelease(hCurr);

   // Historical ATR — average of last 20 periods
   int    hHist = iATR(symbol, tf, 14);
   double histBuf[];
   ArraySetAsSeries(histBuf, true);
   if(hHist == INVALID_HANDLE || CopyBuffer(hHist, 0, 1, 20, histBuf) < 20)
   { IndicatorRelease(hHist); return 1.0; }
   double sumATR = 0;
   for(int i = 0; i < 20; i++) sumATR += histBuf[i];
   double avgATR = sumATR / 20.0;
   IndicatorRelease(hHist);

   if(avgATR <= 0) return 1.0;

   double ratio = currentATR / avgATR;

   // Scale: high vol (ratio > 1.5) = reduce size; low vol (ratio < 0.7) = increase size
   double mult;
   if     (ratio > 2.0) mult = 0.5;   // Very high volatility — half size
   else if(ratio > 1.5) mult = 0.7;   // High volatility
   else if(ratio > 1.2) mult = 0.85;  // Slightly elevated
   else if(ratio < 0.5) mult = 1.5;   // Very low volatility — 1.5x size
   else if(ratio < 0.7) mult = 1.3;   // Low volatility
   else if(ratio < 0.9) mult = 1.1;   // Slightly low
   else                 mult = 1.0;   // Normal — no adjustment

   return NormalizeDouble(mult, 2);
}

// ============================================================
// P9 — 4-TIMEFRAME TREND STACK
// Returns confluence score 0-4 (how many TFs agree with direction)
// 4 = all TFs aligned, 0 = all opposed — use as confidence booster
// ============================================================

int GetTrendStackScore(string symbol, ENUM_ORDER_TYPE direction, ENUM_TIMEFRAMES baseTF)
{
   ENUM_TIMEFRAMES tfs[4];
   tfs[0] = baseTF;
   tfs[1] = GetHigherTF(baseTF);
   tfs[2] = GetHigherTF(tfs[1]);
   tfs[3] = GetHigherTF(tfs[2]);
   // Cap at W1
   for(int i=0; i<4; i++) if(tfs[i] > PERIOD_W1) tfs[i] = PERIOD_W1;

   int score = 0;
   for(int t = 0; t < 4; t++)
   {
      int hFast = iMA(symbol, tfs[t], 50,  0, MODE_EMA, PRICE_CLOSE);
      int hSlow = iMA(symbol, tfs[t], 200, 0, MODE_EMA, PRICE_CLOSE);
      double fast[], slow[];
      ArraySetAsSeries(fast, true);
      ArraySetAsSeries(slow, true);

      if(hFast == INVALID_HANDLE || hSlow == INVALID_HANDLE)
      { IndicatorRelease(hFast); IndicatorRelease(hSlow); continue; }

      if(CopyBuffer(hFast, 0, 0, 1, fast) < 1 || CopyBuffer(hSlow, 0, 0, 1, slow) < 1)
      { IndicatorRelease(hFast); IndicatorRelease(hSlow); continue; }

      bool tfBullish = (fast[0] > slow[0]);
      if(direction == ORDER_TYPE_BUY  && tfBullish)  score++;
      if(direction == ORDER_TYPE_SELL && !tfBullish)  score++;

      IndicatorRelease(hFast);
      IndicatorRelease(hSlow);
   }
   return score;
}

bool IsTrendStackAligned(string symbol, ENUM_ORDER_TYPE direction, int minScore, ENUM_TIMEFRAMES baseTF)
{
   return GetTrendStackScore(symbol, direction, baseTF) >= minScore;
}



