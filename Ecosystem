// SECTION 11 — MARKET REGIME DETECTION (UPGRADED — all 4 regimes)
// =============================================================

ENUM_MARKET_REGIME DetectMarketRegime(string symbol, ENUM_TIMEFRAMES tf)
{
   // ADX for trend strength
   int adxHandle = iADX(symbol, tf, 14);
   if(adxHandle == INVALID_HANDLE) return REGIME_RANGING;

   double adx[], diPlus[], diMinus[];
   ArraySetAsSeries(adx,     true);
   ArraySetAsSeries(diPlus,  true);
   ArraySetAsSeries(diMinus, true);

   if(CopyBuffer(adxHandle, 0, 0, 5, adx)     < 5 ||
      CopyBuffer(adxHandle, 1, 0, 5, diPlus)  < 5 ||
      CopyBuffer(adxHandle, 2, 0, 5, diMinus) < 5)
   {
      IndicatorRelease(adxHandle);
      return REGIME_RANGING;
   }
   IndicatorRelease(adxHandle);

   // ATR for volatility
   int atrHandle = iATR(symbol, tf, 14);
   double atrBuf[];
   ArraySetAsSeries(atrBuf, true);
   double atrRatio = 1.0;
   if(atrHandle != INVALID_HANDLE)
   {
      if(CopyBuffer(atrHandle, 0, 0, 50, atrBuf) >= 50)
      {
         double sumATR = 0;
         for(int k = 1; k < 50; k++) sumATR += atrBuf[k];
         double avgATR = sumATR / 49.0;
         if(avgATR > 0) atrRatio = atrBuf[0] / avgATR;
      }
      IndicatorRelease(atrHandle);
   }

   // Bollinger Band width
   int bbHandle = iBands(symbol, tf, 20, 0, 2.0, PRICE_CLOSE);
   double bbWidth = 0;
   if(bbHandle != INVALID_HANDLE)
   {
      double bbUp[], bbLo[], bbMid[];
      ArraySetAsSeries(bbUp,  true);
      ArraySetAsSeries(bbLo,  true);
      ArraySetAsSeries(bbMid, true);
      if(CopyBuffer(bbHandle, 1, 0, 3, bbUp)  >= 3 &&
         CopyBuffer(bbHandle, 2, 0, 3, bbLo)  >= 3 &&
         CopyBuffer(bbHandle, 0, 0, 3, bbMid) >= 3)
      {
         double mid = bbMid[0];
         if(mid > 0) bbWidth = (bbUp[0] - bbLo[0]) / mid * 100.0;
      }
      IndicatorRelease(bbHandle);
   }

   double adxVal = adx[0];

   if(adxVal > 30 && atrRatio > 2.0) return REGIME_CHAOTIC;
   if(adxVal > 25) return REGIME_TRENDING;
   if(adxVal < 15 && bbWidth < 0.3) return REGIME_LOW_VOL;
   
   return REGIME_RANGING;   // <- THE ORIGINAL CATCH-ALL
}

