if(symbol == "") symbol = _Symbol;
int defaultMins = GetMediumImpactBufferMins(symbol);
int bMins = (before_mins > 0) ? before_mins : defaultMins;
int aMins = (after_mins  > 0) ? after_mins  : defaultMins;
MqlCalendarValue values[];
datetime from = TimeCurrent() - bMins * 60;
datetime to   = TimeCurrent() + aMins * 60;;

   if(CalendarValueHistory(values, from, to))
