      string sl_str  = FileReadString(fh);
      string tp_str  = FileReadString(fh);
      ulong  tkt = (ulong)StringToInteger(tkt_str);
      double sl  = StringToDouble(sl_str);
      double tp  = StringToDouble(tp_str);
      if(tkt == 0) continue;

      ArrayResize(temp, tempCount + 1);
      temp[tempCount].ticket = tkt;
      temp[tempCount].sl     = sl;
      temp[tempCount].tp     = tp;
      tempCount++;
   }
   FileClose(fh);

   // Filter: keep only entries for positions that are STILL OPEN
   ArrayResize(levels, 0);
   int kept = 0;
   for(int i = 0; i < tempCount; i++)
   {
      ulong ticket = temp[i].ticket;
      if(PositionSelectByTicket(ticket))
      {
         if(PositionGetInteger(POSITION_MAGIC) == magic)
         {
            int idx = ArraySize(levels);
            ArrayResize(levels, idx + 1);
            levels[idx] = temp[i];
            kept++;
         }
      }
   }

   if(kept > 0)
     if(G_DebugMode) Print("✅ Stealth levels restored: ", kept, " active positions (pruned ", tempCount - kept, " closed trades)");
   else
      if(G_DebugMode) Print("ℹ️ No active stealth positions found (", tempCount, " closed trades ignored).");

   // Optional: rewrite the file with only active levels to keep it clean
   if(kept < tempCount && kept > 0)
   {
      SaveStealthLevels(levels, magic);
      if(G_DebugMode) Print("🗑️ Stealth file cleaned: removed ", tempCount - kept, " stale entries.");
   }
}

bool IsDailyProfitTargetHit(int    mode,
double realizedPnL,
double dayStartEquity,
double dollarTarget,
