//=== ROLLING STATISTICS BUFFERS ===
double g_rolling_wr[30];
double g_rolling_pf[30];
double g_rolling_dd[30];
double g_rolling_sharpe[30];
int    g_rolling_index = 0;
int    g_rolling_count = 0;

double g_global_avg_wr      = 0.50;
double g_global_std_wr      = 0.10;
double g_global_avg_pf      = 1.50;
double g_global_std_pf      = 0.50;
double g_global_avg_dd      = 5.00;
double g_global_std_dd      = 2.00;
double g_global_avg_sharpe  = 0.20;
double g_global_std_sharpe  = 0.30;

//=== LOSS STREAK TRACKING ===
int    g_current_loss_streak = 0;
int    g_streak_after_win[5];
int    g_streak_after_loss[5];
double g_streak_next_wr[5];
datetime g_last_trade_close_time = 0;

//=== Z-SCORE HEALTH FUNCTIONS ===
void UpdateRollingStats(double winRate, double profitFactor, double maxDD, double sharpe)
{
   g_rolling_wr[g_rolling_index]     = winRate;
   g_rolling_pf[g_rolling_index]     = profitFactor;
   g_rolling_dd[g_rolling_index]     = maxDD;
   g_rolling_sharpe[g_rolling_index] = sharpe;

   g_rolling_index = (g_rolling_index + 1) % 30;
   if(g_rolling_count < 30) g_rolling_count++;

   if(g_rolling_count >= 10)
   {
      double sum_wr = 0, sum_pf = 0, sum_dd = 0, sum_sharpe = 0;
      for(int i = 0; i < g_rolling_count; i++)
      {
         sum_wr      += g_rolling_wr[i];
         sum_pf      += g_rolling_pf[i];
         sum_dd      += g_rolling_dd[i];
         sum_sharpe  += g_rolling_sharpe[i];
      }
      g_global_avg_wr     = sum_wr / g_rolling_count;
      g_global_avg_pf     = sum_pf / g_rolling_count;
      g_global_avg_dd     = sum_dd / g_rolling_count;
      g_global_avg_sharpe = sum_sharpe / g_rolling_count;

      double var_wr = 0, var_pf = 0, var_dd = 0, var_sharpe = 0;
      for(int i = 0; i < g_rolling_count; i++)
      {
         var_wr     += MathPow(g_rolling_wr[i] - g_global_avg_wr, 2);
         var_pf     += MathPow(g_rolling_pf[i] - g_global_avg_pf, 2);
         var_dd     += MathPow(g_rolling_dd[i] - g_global_avg_dd, 2);
         var_sharpe += MathPow(g_rolling_sharpe[i] - g_global_avg_sharpe, 2);
      }
      if(g_rolling_count > 1)
      {
         g_global_std_wr     = MathSqrt(var_wr / (g_rolling_count - 1));
         g_global_std_pf     = MathSqrt(var_pf / (g_rolling_count - 1));
         g_global_std_dd     = MathSqrt(var_dd / (g_rolling_count - 1));
         g_global_std_sharpe = MathSqrt(var_sharpe / (g_rolling_count - 1));
      }
   }
}

double GetZScoreHealth(double currentWR, double currentPF, double currentDD, double currentSharpe)
{
   if(g_rolling_count < 10) return 50.0;
   
   double wrZ     = (currentWR - g_global_avg_wr) / (g_global_std_wr != 0 ? g_global_std_wr : 0.1);
   double pfZ     = (currentPF - g_global_avg_pf) / (g_global_std_pf != 0 ? g_global_std_pf : 0.5);
   double ddZ     = (g_global_avg_dd - currentDD) / (g_global_std_dd != 0 ? g_global_std_dd : 2.0);
   double sharpeZ = (currentSharpe - g_global_avg_sharpe) / (g_global_std_sharpe != 0 ? g_global_std_sharpe : 0.3);

   double combinedZ = (wrZ + pfZ + ddZ + sharpeZ) / 4.0;
   double health = 50.0 + (combinedZ * 10.0);
   return MathMin(100.0, MathMax(0.0, health));
}

double GetRollingWinRate(int lookback)
{
   if(g_rolling_count < lookback) lookback = g_rolling_count;
   if(lookback == 0) return 0.50;
   int start = (g_rolling_index - lookback + 30) % 30;
   double wins = 0;
   for(int i = 0; i < lookback; i++)
   {
      int idx = (start + i) % 30;
      if(g_rolling_wr[idx] > 0.5) wins++;
   }
   return wins / lookback;
}

double GetRollingProfitFactor(int lookback)
{
   if(g_rolling_count < lookback) lookback = g_rolling_count;
   if(lookback == 0) return 1.0;
   int start = (g_rolling_index - lookback + 30) % 30;
   double grossProfit = 0, grossLoss = 0;
   for(int i = 0; i < lookback; i++)
   {
      int idx = (start + i) % 30;
      double pf = g_rolling_pf[idx];
      if(pf > 1.0) grossProfit += pf;
      else grossLoss += pf;
   }
   if(grossLoss == 0) return 99.0;
   return grossProfit / grossLoss;
}

double GetRollingMaxDrawdown(int lookback)
{
   if(g_rolling_count < lookback) lookback = g_rolling_count;
   if(lookback == 0) return 0.0;
   int start = (g_rolling_index - lookback + 30) % 30;
   double maxDD = 0;
   for(int i = 0; i < lookback; i++)
   {
      int idx = (start + i) % 30;
      if(g_rolling_dd[idx] > maxDD) maxDD = g_rolling_dd[idx];
   }
   return maxDD;
}

double GetRollingSharpe(int lookback)
{
   if(g_rolling_count < lookback) lookback = g_rolling_count;
   if(lookback == 0) return 0.0;
   int start = (g_rolling_index - lookback + 30) % 30;
   double sumRet = 0;
   for(int i = 0; i < lookback; i++)
   {
      int idx = (start + i) % 30;
      sumRet += g_rolling_sharpe[idx];
   }
   double avgRet = sumRet / lookback;
   double var = 0;
   for(int i = 0; i < lookback; i++)
   {
      int idx = (start + i) % 30;
      double diff = g_rolling_sharpe[idx] - avgRet;
      var += diff * diff;
   }
   double stdDev = MathSqrt(var / lookback);
   if(stdDev == 0) return 0;
   return avgRet / stdDev;
}

//=== ADAPTIVE LOSS COOLDOWN ===
void UpdateLossStreakAnalysis(double tradeProfit, double nextTradeResult)
{
   if(tradeProfit < 0)
   {
      g_current_loss_streak++;
   }
   else
   {
      if(g_current_loss_streak >= 1 && g_current_loss_streak <= 4)
      {
         int streak = g_current_loss_streak;
         g_streak_after_loss[streak]++;
         if(nextTradeResult > 0.5) g_streak_after_win[streak]++;
         if(g_streak_after_loss[streak] > 0)
            g_streak_next_wr[streak] = (double)g_streak_after_win[streak] / g_streak_after_loss[streak];
      }
      g_current_loss_streak = 0;
   }
   g_last_trade_close_time = TimeCurrent();
}

int GetAdaptiveCooldownMinutes()
{
   int streak = g_current_loss_streak;
   if(streak == 0) return 0;
   if(streak > 4) streak = 4;

   double nextWR = g_streak_next_wr[streak];
   if(g_streak_after_loss[streak] < 10)
   {
      if(streak >= 3) return 30;
      if(streak >= 2) return 15;
      return 0;
   }

   if(nextWR < 0.40) return 60;
   if(nextWR < 0.45) return 30;
   if(nextWR < 0.48) return 15;
   return 0;
}

bool IsCooldownActive()
{
   int cooldown = GetAdaptiveCooldownMinutes();
   if(cooldown == 0) return false;
   if(TimeCurrent() - g_last_trade_close_time < cooldown * 60)
   {
     if(G_DebugMode) Print("⏸ Adaptive cooldown: ", cooldown, " min after ", g_current_loss_streak, " loss(es)");
      return true;
   }
   return false;
}

int GetZScoreHealthScore()
{
   double winRate      = GetRollingWinRate(30);
   double profitFactor = GetRollingProfitFactor(30);
   double maxDD        = GetRollingMaxDrawdown(30);
   double sharpe       = GetRollingSharpe(30);
   double health       = GetZScoreHealth(winRate, profitFactor, maxDD, sharpe);
   return (int)MathRound(health);
}

