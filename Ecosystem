void SendDiscordSignal(string symbol, string direction, double entry, double sl, double tp, double lot, string strategy)
{

   if(MQLInfoInteger(MQL_TESTER)) return;
   if(!Enable_Discord_Hoots) return;
   
   // Daily limit check
   if(g_discord_hoots_today >= Max_Discord_Hoots)
      return;
   g_discord_hoots_today++;
   
   int digits = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
string message = "**🦉 NEW TRADE**\n"
                + "Symbol: " + symbol + "\n"
                + "Direction: " + direction + "\n"
                + "Entry: " + DoubleToString(entry, digits) + "\n"
                + "SL: " + DoubleToString(sl, digits) + "\n"
                + "TP: " + DoubleToString(tp, digits) + "\n"
                + "Lot: " + DoubleToString(lot, 2) + "\n"
                + "Strategy: " + strategy;
   
   StringReplace(message, "\"", "\\\"");
   StringReplace(message, "\n", "\\n");
   
   string payload = "{\"content\": \"" + message + "\"}";
   char data[], result[];
   string headers = "Content-Type: application/json\r\n";
   int len = StringToCharArray(payload, data, 0, WHOLE_ARRAY, CP_UTF8);
   if(len > 0) ArrayResize(data, len - 1);
   
   
   string res_headers;
   int res = WebRequest("POST", DISCORD_WEBHOOK, headers, 5000, data, result, res_headers);
   if(res == 200)
       if(G_DebugMode) Print("Discord signal sent");
   else
      Print("Discord send failed: HTTP ", res);
}

void SendDiscordClose(string symbol, string direction, double entry, double exit, double pnl, string result, string reason, double lot)
{
   if(!Enable_Discord_Hoots) return;
   if(g_discord_hoots_today >= Max_Discord_Hoots) return;

   int digits = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
   string message = "**✅ TRADE CLOSED**\n"
                  + "Symbol: " + symbol + "\n"
                  + "Direction: " + direction + "\n"
                  + "Entry: " + DoubleToString(entry, digits) + "\n"
                  + "Exit: " + DoubleToString(exit, digits) + "\n"
                  + "P&L: $" + DoubleToString(pnl, 2) + "\n"
                  + "Result: " + result + "\n"
                  + "Reason: " + reason + "\n"
                  + "Lot: " + DoubleToString(lot, 2);

   StringReplace(message, "\"", "\\\"");
   StringReplace(message, "\n", "\\n");
   string payload = "{\"content\": \"" + message + "\"}";
   char data[], res_data[];
   string headers = "Content-Type: application/json\r\n";
   int len = StringToCharArray(payload, data, 0, WHOLE_ARRAY, CP_UTF8);
   if(len > 0) ArrayResize(data, len - 1);
   string res_headers;
   int res = WebRequest("POST", DISCORD_WEBHOOK, headers, 5000, data, res_data, res_headers);
   if(res >= 200 && res <= 299)
{
   if(G_DebugMode) Print("Discord close signal sent");
   g_discord_hoots_today++;
}
else
   Print("Discord close send failed: HTTP ", res);
}
