int GetTradeTimeBuffer(ENUM_TIMEFRAMES tf, double multiplier = 1.0)
{
   int baseSeconds;
   switch(tf)
   {
      case PERIOD_M1:  baseSeconds = 60;    break;
      case PERIOD_M5:  baseSeconds = 300;   break;
      case PERIOD_M15: baseSeconds = 600;   break;
      case PERIOD_M30: baseSeconds = 1200;  break;
      case PERIOD_H1:  baseSeconds = 1800;  break;
      case PERIOD_H4:  baseSeconds = 3600;  break;
      case PERIOD_D1:  baseSeconds = 7200;  break;
      case PERIOD_W1:  baseSeconds = 14400; break;
      default:         baseSeconds = 300;   break;
   }
   return (int)(baseSeconds * MathMax(0.1, multiplier));
}
