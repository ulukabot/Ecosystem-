                    + "Balance: $" + DoubleToString(balance, 2) + "\n"
                    + "All positions closed. Trading locked.\n"
                    + "Time: " + TimeToString(TimeCurrent());

         string json = "{\"chat_id\":\"" + telegramChatId + "\","
                      + "\"text\":\"" + msg + "\","
                      + "\"parse_mode\":\"HTML\"}";
         char data[], result[];
         string req_headers = "Content-Type: application/json\r\n";
         string res_headers;
         StringToCharArray(json, data);
         string url = "https://api.telegram.org/bot" + tgApi + "/sendMessage";
