ENUM_TIMEFRAMES GetModeTimeframe(ENUM_TRADE_MODE mode)
{
   switch(mode)
   {
      case M1_MICRO_SCALPING:  return PERIOD_M1;
      case M5_MINI_SCALPING:   return PERIOD_M5;
      case M15_SCALPING:       return PERIOD_M15;
      case M30_RAPID_SCALPING: return PERIOD_M30;
      case H1_INTRADAY:        return PERIOD_H1;
      case H4_SWING:           return PERIOD_H4;
      case D1_POSITIONAL:      return PERIOD_D1;
      default:                 return PERIOD_M15;
   }
}

//+------------------------------------------------------------------+
//| Get higher timeframe for bias confirmation                       |
