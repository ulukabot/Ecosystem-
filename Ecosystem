bool IsNewsTime(string symbol = "", int before_mins = -1, int after_mins = -1)
{
   if(MQLInfoInteger(MQL_TESTER)) return false;
   // Add weekend check - no news on weekends
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   if(dt.day_of_week == 0 || dt.day_of_week == 6) return false;
   if(symbol == "") symbol = _Symbol;

   int defaultMins = GetHighImpactBufferMins(symbol);
   int bMins = (before_mins > 0) ? before_mins : defaultMins;
   int aMins = (after_mins  > 0) ? after_mins  : defaultMins;

   MqlCalendarValue values[];
   datetime from = TimeCurrent() - bMins * 60;
   datetime to   = TimeCurrent() + aMins * 60;

   if(CalendarValueHistory(values, from, to))
   {
      for(int i = 0; i < ArraySize(values); i++)
      {
         MqlCalendarEvent ev;
         if(CalendarEventById(values[i].event_id, ev))
         {
            if(ev.importance == CALENDAR_IMPORTANCE_HIGH)
            {
               // v5.8: Throttle — print once per candle, not every tick
               static datetime s_last_high_print = 0;
               if(TimeCurrent() - s_last_high_print >= PeriodSeconds())
               {
                  Print("⚠️ NEWS BLOCK HIGH: ", ev.name, " Before: ", bMins, " After: ", aMins, " Symbol: ", symbol);
                  s_last_high_print = TimeCurrent();
               }
               return true;
            }
         }
      }
   }
   return false;
}

