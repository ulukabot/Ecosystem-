// Call from OnTradeTransaction after every closed trade
void RecordDNATrade(string symbol,
                    double profit,
                    int    sessionIdx,
                    int    regimeIdx,
                    int    strategyIdx)
{
   int idx = DNA_GetOrCreate(symbol);
   if(idx < 0) return;

   MqlDateTime dt; TimeToStruct(TimeCurrent(), dt);
   int  hour  = dt.hour;
   bool isWin = (profit > 0.01);

   // ?? Session ??
   if(sessionIdx >= 0 && sessionIdx < DNA_SESSIONS)
   {
      int k = idx * DNA_SESSIONS + sessionIdx;
      if(isWin) { G_DNA_SessWins[k]++; G_DNA_SessProfit[k] += profit; }
      else      { G_DNA_SessLosses[k]++; G_DNA_SessLoss[k] += MathAbs(profit); }
   }

   // ?? Regime ??
   if(regimeIdx >= 0 && regimeIdx < DNA_REGIMES)
   {
      int k = idx * DNA_REGIMES + regimeIdx;
      if(isWin) { G_DNA_RegWins[k]++; G_DNA_RegProfit[k] += profit; }
      else      { G_DNA_RegLosses[k]++; G_DNA_RegLoss[k] += MathAbs(profit); }
   }

   // ?? Strategy ??
   if(strategyIdx >= 0 && strategyIdx < DNA_STRATEGIES)
   {
      int k = idx * DNA_STRATEGIES + strategyIdx;
      if(isWin) { G_DNA_StrWins[k]++; G_DNA_StrProfit[k] += profit; }
      else      { G_DNA_StrLosses[k]++; G_DNA_StrLoss[k] += MathAbs(profit); }
   }

   // ?? Hour ??
   if(hour >= 0 && hour < DNA_HOURS)
   {
      int k = idx * DNA_HOURS + hour;
      if(isWin) { G_DNA_HrWins[k]++; G_DNA_HrProfit[k] += profit; }
      else      { G_DNA_HrLosses[k]++; G_DNA_HrLoss[k] += MathAbs(profit); }
   }

   // ?? Totals ??
   G_DNA_TotalTrades[idx]++;
   if(isWin) G_DNA_TotalWins[idx]++;
   else      G_DNA_TotalLosses[idx]++;
   G_DNA_TotalPnL[idx] += profit;

   AnalyseDNA(idx);
   SaveDNAToFile(idx);

 if(G_DebugMode) Print("🧬 Trade #", G_DNA_TotalTrades[idx], " | ", symbol,
         " | ", isWin ? "WIN +$" : "LOSS -$", DoubleToString(MathAbs(profit), 2),
         " | Session: ", DNA_SessionName(sessionIdx),
         " | Confidence: ", DNA_SampleConfidence(G_DNA_TotalTrades[idx]));
}

// Rebuild from MT5 history on first load
void RebuildDNAFromHistory(string symbol)
{
   int idx = DNA_GetOrCreate(symbol);
   if(idx < 0) return;

   if(!HistorySelect(TimeCurrent() - 90 * 86400, TimeCurrent())) return;

   int total = HistoryDealsTotal();
   int count = 0;

   for(int i = 0; i < total; i++)
   {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      if(HistoryDealGetInteger(ticket, DEAL_ENTRY) != DEAL_ENTRY_OUT) continue;
      if(HistoryDealGetString(ticket, DEAL_SYMBOL) != symbol) continue;

      double profit = HistoryDealGetDouble(ticket, DEAL_PROFIT)
                    + HistoryDealGetDouble(ticket, DEAL_SWAP)
                    + HistoryDealGetDouble(ticket, DEAL_COMMISSION);
      if(MathAbs(profit) < 0.01) continue;

      datetime closeTime = (datetime)HistoryDealGetInteger(ticket, DEAL_TIME);
      MqlDateTime dt; TimeToStruct(closeTime, dt);
      int hour = dt.hour;

      // Determine session from hour
      // v5.8: Corrected session hour ranges (UTC)
      int sessIdx = 4; // CLOSED default
      if     (hour >= 12 && hour < 17) sessIdx = 3; // OVERLAP: London+NY 12:00-17:00 UTC
      else if(hour >= 7  && hour < 16) sessIdx = 1; // LONDON: 07:00-16:00 UTC
      else if(hour >= 13 && hour < 22) sessIdx = 2; // NEW YORK: 13:00-22:00 UTC
      else if(hour >= 0  && hour < 9)  sessIdx = 0; // ASIAN: 00:00-09:00 UTC
      // Note: Overlap checked first to take priority over London/NY overlap

      // Regime + strategy not known from history — skip (-1)
      RecordDNATrade(symbol, profit, sessIdx, -1, -1);
      count++;
   }

   if(count > 0)
{
   if(G_DebugMode) Print("🧬 from history: ", symbol, " | ", count, " trades loaded");
   AnalyseDNA(idx);
   SaveDNAToFile(idx);
}
else
   if(G_DebugMode) Print("🧬 for ", symbol, " — learning starts now");
}

