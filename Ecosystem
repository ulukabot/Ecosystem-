   double tp2;           // TP2 price (partial close level)
   double tp3;           // TP3 price (full exit / trail target)
   double tp1Lots;       // Lots to close at TP1 (default 50%)
   double tp2Lots;       // Lots to close at TP2 (default 30%)
                         // Remaining 20% trails to TP3
   bool   tp1Hit;        // Has TP1 been triggered?
   bool   tp2Hit;        // Has TP2 been triggered?
};

// Calculate multi-TP levels from entry, SL and RR ratios
MultiTPLevels GetMultiTPLevels(string symbol,
                                ENUM_ORDER_TYPE type,
                                double entry,
                                double sl,
                                double tp1Ratio,    // e.g. 1.5 = 1.5x SL dist
                                double tp2Ratio,    // e.g. 3.0 = 3x SL dist
                                double tp3Ratio,    // e.g. 5.0 = 5x SL dist
                                double totalLot)
{
   MultiTPLevels levels;
   double slDist = MathAbs(entry - sl);

   if(type == ORDER_TYPE_BUY)
   {
      levels.tp1 = entry + slDist * tp1Ratio;
      levels.tp2 = entry + slDist * tp2Ratio;
      levels.tp3 = entry + slDist * tp3Ratio;
   }
   else
   {
      levels.tp1 = entry - slDist * tp1Ratio;
      levels.tp2 = entry - slDist * tp2Ratio;
      levels.tp3 = entry - slDist * tp3Ratio;
   }

   double step    = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);
   double minVol  = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);

   // TP1: close 50% of position
   levels.tp1Lots = MathMax(MathFloor(totalLot * 0.5 / step) * step, minVol);
   // TP2: close 30% of position
   levels.tp2Lots = MathMax(MathFloor(totalLot * 0.3 / step) * step, minVol);
   // Remaining ~20% trails to TP3 (handled by trailing engine)

   levels.tp1Hit  = false;
   levels.tp2Hit  = false;

   return levels;
}

