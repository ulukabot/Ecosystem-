//+------------------------------------------------------------------+
//| SECTION 8 — Check if spread is safe (throttled: once per bar)    |
//| Input: maxSpread in pips (converted internally to points)       |
//+------------------------------------------------------------------+
bool IsSpreadSafe(string symbol, int maxSpread)
{
   long spreadPoints = SymbolInfoInteger(symbol, SYMBOL_SPREAD);
   int pipMultiplier = GetPipMultiplier(symbol);
   int maxSpreadPoints = maxSpread * pipMultiplier;
   
   if(spreadPoints > maxSpreadPoints)
   {
      static datetime last_warning_candle = 0;
      datetime current_candle = iTime(symbol, PERIOD_CURRENT, 0);
      if(current_candle != last_warning_candle)
      {
         Print("spread unsafe | ", symbol, " spread: ", spreadPoints, " pts (", 
               DoubleToString((double)spreadPoints / pipMultiplier, 1), " pips) > limit: ", 
               maxSpread, " pips");
         last_warning_candle = current_candle;
      }
      return false;
   }
   return true;
}

