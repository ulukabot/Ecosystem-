double GetRiskMultiplier()
{
   double multiplier = 1.0;

   // Cloud multiplier override
   multiplier *= G_CloudRiskMultiplier;

   // Session modifier
   multiplier *= GetSessionRiskModifier();

   // Consecutive loss scaling
   if(G_ConsecutiveLosses == 2)      multiplier *= 0.70;
   else if(G_ConsecutiveLosses == 3) multiplier *= 0.40;
   else if(G_ConsecutiveLosses >= 4) multiplier  = 0.0;

   // Capital Protection Mode: halve risk
   if(G_CapitalProtectionMode) multiplier *= 0.5;

   multiplier = MathMax(0.0, MathMin(3.0, multiplier));

   // Throttle: print once per candle only
   static datetime s_last_risk_bar = 0;
   datetime risk_bar = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(risk_bar != s_last_risk_bar)
   {
      if(G_DebugMode) Print("📊 Risk Multiplier: ", DoubleToString(multiplier, 2),
            " | ConsLosses:", G_ConsecutiveLosses,
            " | CapProt:", G_CapitalProtectionMode,
            " | Session:", GetSessionName());
      s_last_risk_bar = risk_bar;
   }

   return multiplier;
}

