bool IsVolumeSpikePresent(string symbol, ENUM_TIMEFRAMES tf)
{
   long volumes[];
   ArraySetAsSeries(volumes, true);

   if(CopyTickVolume(symbol, tf, 0, 25, volumes) < 25)
      return false;

   // Current bar volume vs 20-bar average
   long current = volumes[0];
   long sum     = 0;
   for(int i = 1; i <= 20; i++) sum += volumes[i];
   double avg = (double)sum / 20.0;

   if(avg <= 0) return false;

   bool spike = (current >= avg * 1.5);

   if(spike)
   if(G_DebugMode) Print("📊 Volume Spike: Current=", current, " | Avg=", avg, " | Ratio=", DoubleToString(current/avg, 2));

   return spike;
}

int GetVolumeConfidenceBonus(string symbol, ENUM_TIMEFRAMES tf)
{
   long volumes[];
   ArraySetAsSeries(volumes, true);
   if(CopyTickVolume(symbol, tf, 0, 25, volumes) < 25) return 0;

   long current = volumes[0];
   long sum     = 0;
   for(int i = 1; i <= 20; i++) sum += volumes[i];
   double avg = (double)sum / 20.0;
   if(avg <= 0) return 0;

   double ratio = current / avg;

   if(ratio >= 2.0)  return 15;   // Strong spike = high confidence
   if(ratio >= 1.5)  return 10;
   if(ratio >= 1.0)  return 5;
   if(ratio < 0.5)   return -10;  // Very low volume = low confidence

   return 0;
}

