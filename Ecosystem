// Call when stealth_levels[] changes (new trade, BE, trailing)
void MarkStealthDirty()
{
g_stealth_dirty = true;
}

void UpdateStealthSL(ulong ticket, double new_sl, StealthLevels &levels[])
{
   for(int i = 0; i < ArraySize(levels); i++)
   {
      if(levels[i].ticket == ticket)
      {
         levels[i].sl = new_sl;
         MarkStealthDirty();
         
         // === THROTTLED PRINT: once per 30 seconds per ticket ===
         static ulong    last_print_ticket[100];
         static datetime last_print_time[100];
         static int      last_print_count = 0;
         
         int idx = -1;
         for(int j = 0; j < last_print_count; j++)
         {
            if(last_print_ticket[j] == ticket)
            {
               idx = j;
               break;
            }
         }
         if(idx == -1 && last_print_count < 100)
         {
            idx = last_print_count++;
            last_print_ticket[idx] = ticket;
            last_print_time[idx] = 0;
         }
         
         if(idx >= 0 && (TimeCurrent() - last_print_time[idx] >= 30))
         {
           if(G_DebugMode) Print("🔒 Stealth SL updated internally to ", DoubleToString(new_sl, _Digits), " for ticket #", ticket);
            last_print_time[idx] = TimeCurrent();
         }
         return;
      }
   }
   // If not found, add new entry
   int idx = ArraySize(levels);
   ArrayResize(levels, idx + 1);
   levels[idx].ticket = ticket;
   levels[idx].sl = new_sl;
   levels[idx].tp = 0;
   MarkStealthDirty();
   if(G_DebugMode) Print("🔒 Stealth SL added (new entry) for ticket #", ticket, " to ", DoubleToString(new_sl, _Digits));
}

