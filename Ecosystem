//+------------------------------------------------------------------+
//| CHECK FLOATING DRAWDOWN (EA positions only)                       |
//+------------------------------------------------------------------+
void CheckFloatingDrawdown(double limitPercent, CTrade &tradeObj, int magic)
{
   static int last_reset_day = -1;
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);

   // --- 1. Original peak tracking (preserved) ---
   if(dt.day != last_reset_day)
   {
      G_TodayPeakEquity = AccountInfoDouble(ACCOUNT_EQUITY);
      G_FloatingDD_Lock = false;
      last_reset_day    = dt.day;
   }

   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   if(G_TodayPeakEquity <= 0.0) G_TodayPeakEquity = equity;
   if(equity > G_TodayPeakEquity) G_TodayPeakEquity = equity;

   // --- 2. Existing safety checks ---
   if(limitPercent <= 0 || MQLInfoInteger(MQL_TESTER)) return;
   if(G_FloatingDD_Lock) return;

   // --- 3. NEW: Only consider EA positions for trigger ---
   double eaFloating = GetCurrentFloatingPnL(magic);
   if(eaFloating >= 0) return; // no loss, ignore profits

   double loss = MathAbs(eaFloating);
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   if(balance <= 0) return;

   double ddPercent = loss / balance * 100.0;

   // --- 4. Trigger if EA loss exceeds limit ---
   if(ddPercent >= limitPercent)
   {
      G_FloatingDD_Lock = true;
      Print("⚠️ FLOATING DD LIMIT HIT — EA Floating Loss: $", DoubleToString(loss, 2),
            " (", DoubleToString(ddPercent, 2), "% of balance)");
      CloseAllEAOrders(tradeObj, magic);
   }
}

