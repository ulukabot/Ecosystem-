        + "<b>TP2:</b> <code>" + DoubleToString(levels.tp2, digits) + "</code> (close 30%)\n"
        + "<b>TP3:</b> <code>" + DoubleToString(levels.tp3, digits) + "</code> (trail 20%)\n";
}


