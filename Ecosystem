{
   ENUM_MARKET_REGIME regime = DetectMarketRegime(symbol, tf);
   ENUM_TREND_BIAS    htfBias = GetHTFBias(symbol, GetHigherTF(tf));

   // Hard block: chaotic market or dead session
   if(regime == REGIME_CHAOTIC)    return STRATEGY_STAY_OUT;
   if(regime == REGIME_LOW_VOL)    return STRATEGY_STAY_OUT;
   if(GetCurrentSession() == SESSION_CLOSED) return STRATEGY_STAY_OUT;

   // HTF bias filter: don't trade against HTF trend
   if(tradeType == ORDER_TYPE_BUY  && htfBias == BIAS_BEARISH) return STRATEGY_STAY_OUT;
   if(tradeType == ORDER_TYPE_SELL && htfBias == BIAS_BULLISH)  return STRATEGY_STAY_OUT;

   // SMC detection — check in priority order
   bool bosFound  = IsBOSPresent(symbol, tf, tradeType);
   bool chochFound = IsCHoCHPresent(symbol, tf, tradeType);
   FVGZone fvg    = GetNearestFVG(symbol, tf, tradeType);
   OrderBlock ob  = GetNearestOrderBlock(symbol, tf, tradeType);

   if(chochFound) return STRATEGY_CHOCH;
   if(IsLiquiditySweepPresent(symbol, tf, tradeType)) {
      ENUM_MARKET_PHASE phase = GetAMDPhase(symbol, tf);
      if(phase == PHASE_MANIPULATION || phase == PHASE_DISTRIBUTION || phase == PHASE_UNKNOWN)
         return STRATEGY_LIQUIDITY_SWEEP;
   }
   if(bosFound && regime == REGIME_TRENDING) return STRATEGY_BOS;
   if(fvg.valid) return STRATEGY_FVG;
   if(ob.valid) return STRATEGY_ORDER_BLOCK;

         if(regime == REGIME_TRENDING) return STRATEGY_FARSIGHT;
   if(regime == REGIME_RANGING)  return STRATEGY_CLOSE_VISION;
   return STRATEGY_STAY_OUT;
