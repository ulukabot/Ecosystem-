// SECTION 6b â?? SEND OPEN POSITIONS TO GAS
// Called from OnTimer() every 5 minutes
// =============================================================

void SendOpenPositions(string server_url, ulong magic)
{
   if(server_url == "" || MQLInfoInteger(MQL_TESTER)) return;

   string positions = "[";
   bool   first     = true;
   int    total     = PositionsTotal();

   for(int i = 0; i < total; i++)
   {
      ulong  tkt   = PositionGetTicket(i);
      if(!PositionSelectByTicket(tkt)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != (long)magic) continue;

      string sym   = PositionGetString(POSITION_SYMBOL);
      int    ptype = (int)PositionGetInteger(POSITION_TYPE);
      double vol   = PositionGetDouble(POSITION_VOLUME);
      double opx   = PositionGetDouble(POSITION_PRICE_OPEN);
      double cur   = PositionGetDouble(POSITION_PRICE_CURRENT);
      double profit= PositionGetDouble(POSITION_PROFIT);
      int    digs  = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);
      double pips  = (ptype == 0) ? (cur - opx) / _Point / 10.0
                                  : (opx - cur) / _Point / 10.0;
      string cmt   = PositionGetString(POSITION_COMMENT);
      string dirStr= (ptype == 0) ? "BUY" : "SELL";

      if(!first) positions += ",";
      positions += "{";
      positions += "\"symbol\":\"" + sym + "\",";
      positions += "\"direction\":\"" + dirStr + "\",";
      positions += "\"lot\":" + DoubleToString(vol, 2) + ",";
      positions += "\"open_price\":" + DoubleToString(opx, digs) + ",";
      positions += "\"pips\":" + DoubleToString(pips, 1) + ",";
      positions += "\"floating_pnl\":" + DoubleToString(profit, 2) + ",";
      positions += "\"strategy\":\"" + cmt + "\",";
      positions += "\"ticket\":\"" + IntegerToString(tkt) + "\"";
      positions += "}";
      first = false;
   }
   positions += "]";

   string accId   = IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN));
   string payload = "{";
   payload += "\"type\":\"OPEN_POSITIONS\",";
   payload += "\"source\":\"MASTER\",";
   payload += "\"account_id\":\"" + accId + "\",";
   payload += "\"positions\":" + positions;
   payload += "}";

   char   post_data[], result_data[];
   string result_headers;
   int    plen = StringToCharArray(payload, post_data, 0, WHOLE_ARRAY, CP_UTF8);
   if(plen > 0) ArrayResize(post_data, plen - 1);

   ResetLastError();
   int maxRetries = 3;
int res = 0;
for(int retry = 1; retry <= maxRetries; retry++)
{
   ResetLastError();
   res = WebRequest("POST", server_url, "Content-Type: application/json\r\n",
                    15000, post_data, result_data, result_headers);
   if(res == 200) break;
  if(G_DebugMode) Print("SendOpenPositions attempt ", retry, " failed. HTTP ", res, " | Err: ", GetLastError());
   if(retry < maxRetries) Sleep(1000);
}
if(res != 200)
   Print("SendOpenPositions failed after ", maxRetries, " attempts.");
}

