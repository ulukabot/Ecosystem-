//+------------------------------------------------------------------+
//| Convert deal comment (with emoji) back to ENUM_STRATEGY          |
//| Example: "🦉 Order Block" → STRATEGY_ORDER_BLOCK                |
//+------------------------------------------------------------------+
int StrategyNameToEnum(string comment)
{
   // Remove emoji prefix (e.g., "🦉 ", "🔵 ", "💥 ", etc.)
   string clean = comment;
   int spacePos = StringFind(clean, " ");
   if(spacePos > 0 && spacePos <= 5)   // emoji length 1-4 chars + space
      clean = StringSubstr(clean, spacePos + 1);

   // Match against known strategy names (case-insensitive)
   if(StringFind(clean, "Order Block")     >= 0) return (int)STRATEGY_ORDER_BLOCK;
   if(StringFind(clean, "CHoCH")           >= 0) return (int)STRATEGY_CHOCH;
   if(StringFind(clean, "BOS")             >= 0) return (int)STRATEGY_BOS;
   if(StringFind(clean, "FVG")             >= 0) return (int)STRATEGY_FVG;
   if(StringFind(clean, "Liquidity Sweep") >= 0) return (int)STRATEGY_LIQUIDITY_SWEEP;
   if(StringFind(clean, "Farsight")        >= 0) return (int)STRATEGY_FARSIGHT;
   if(StringFind(clean, "Close Vision")    >= 0) return (int)STRATEGY_CLOSE_VISION;

   // Safe fallback
   return (int)STRATEGY_FARSIGHT;
}


