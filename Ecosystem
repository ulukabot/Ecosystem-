bool IsBOSPresent(string symbol, ENUM_TIMEFRAMES tf, ENUM_ORDER_TYPE tradeType)
{
   double highs[], lows[], closes[];
   ArraySetAsSeries(highs,  true);
   ArraySetAsSeries(lows,   true);
   ArraySetAsSeries(closes, true);

   if(CopyHigh(symbol,  tf, 0, 30, highs)  < 30) return false;
   if(CopyLow(symbol,   tf, 0, 30, lows)   < 30) return false;
   if(CopyClose(symbol, tf, 0, 30, closes) < 30) return false;

   // Find previous significant swing level (bars 5-20)
   double prevSwingHigh = 0, prevSwingLow = 999999;
   int    swingHighBar  = 5,  swingLowBar  = 5;

   for(int i = 5; i < 20; i++)
   {
      // Swing high: higher than 2 bars each side
      if(highs[i] > highs[i+1] && highs[i] > highs[i+2] &&
         highs[i] > highs[i-1] && highs[i] > highs[i-2])
      {
         if(highs[i] > prevSwingHigh)
         {
            prevSwingHigh = highs[i];
            swingHighBar  = i;
         }
      }
      // Swing low
      if(lows[i] < lows[i+1] && lows[i] < lows[i+2] &&
         lows[i] < lows[i-1] && lows[i] < lows[i-2])
      {
         if(lows[i] < prevSwingLow)
         {
            prevSwingLow = lows[i];
            swingLowBar  = i;
         }
      }
   }

   // BOS Bullish: current close above previous swing high
   if(tradeType == ORDER_TYPE_BUY && prevSwingHigh > 0)
   {
      if(closes[1] > prevSwingHigh)
      {
         static datetime last_bos_bull_print = 0;
if(TimeCurrent() - last_bos_bull_print >= PeriodSeconds(PERIOD_CURRENT))
{
  if(G_DebugMode) Print("📊 BOS BULLISH detected on ", symbol);
   last_bos_bull_print = TimeCurrent();
}
         return true;
      }
   }

   // BOS Bearish: current close below previous swing low
   if(tradeType == ORDER_TYPE_SELL && prevSwingLow < 999999)
   {
      if(closes[1] < prevSwingLow)
      {
         static datetime last_bos_print = 0;
if(TimeCurrent() - last_bos_print >= PeriodSeconds(PERIOD_CURRENT))
{
   Print("📊 BOS BEARISH detected on ", symbol);
   last_bos_print = TimeCurrent();
}
         return true;
      }
   }

   return false;
}

