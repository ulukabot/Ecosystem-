// Simple static correlation check
// Returns true if opening tradeType on symbol would create dangerous correlation
//+------------------------------------------------------------------+
//| Dynamic correlation check using symbol-based grouping            |
//+------------------------------------------------------------------+
bool IsCorrelatedPositionOpen(string newSymbol, ENUM_ORDER_TYPE newType, int magic)
{
   // Get the correlation group of the new symbol
   string newGroup = GetCorrelationGroup(newSymbol);
   
   // Loop through all open positions
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != magic) continue;
      
      string openSymbol = PositionGetString(POSITION_SYMBOL);
      int    openType   = (int)PositionGetInteger(POSITION_TYPE);
      
      // Skip the same symbol (handled by Max_Open_Trades)
      if(openSymbol == newSymbol) continue;
      
      // Get the group of the open position
      string openGroup = GetCorrelationGroup(openSymbol);
      
      // If groups match and direction is the same → correlated
      if(newGroup == openGroup && newType == openType)
      {
         Print("⚠️ Correlation Block: ", newSymbol, " ", EnumToString(newType),
               " correlated with open ", openSymbol, " (group: ", newGroup, ")");
         return true;
      }
   }
   return false;
}

