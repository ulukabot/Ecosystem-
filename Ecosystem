//| Returns: 10 for 5-digit/3-digit/2-digit symbols, 1 for 4-digit  |
//+------------------------------------------------------------------+
int GetPipMultiplier(string symbol)
{
   int digits = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
   if(digits == 5 || digits == 3 || digits == 2)
      return 10;
   else if(digits == 4 || digits == 2)
      return 1;
   else
      return 10;   // Safe default
