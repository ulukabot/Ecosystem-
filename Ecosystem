//| Count Total Active Pairs (for scanner)                            |
//+------------------------------------------------------------------+
int CountTotalActivePairs()
{
   int count = 1; // always count chart symbol
   if(!Enable_Multi_Pair_Scanner) return count;
   if(StringLen(Scanner_Symbol_List) == 0) return count;
   string syms[];
   int scanCount = StringSplit(Scanner_Symbol_List, ',', syms);
   // Only count pairs that are actually selectable (available in broker)
   for(int _i = 0; _i < scanCount; _i++)
   {
      string s = syms[_i];
      StringTrimLeft(s); StringTrimRight(s);
      if(StringLen(s) > 0 && s != _Symbol) count++;
   }
   return MathMax(1, count);
}

//+------------------------------------------------------------------+
//| Get Points from Percent of SL Distance                            |
//+------------------------------------------------------------------+
int GetPointsFromPercent(string sym, double percent)
{
   double symPoint = SymbolInfoDouble(sym, SYMBOL_POINT);
   if(symPoint <= 0) return 50; // safe fallback
   for(int _pi = 0; _pi < PositionsTotal(); _pi++)
   {
      ulong _tk = PositionGetTicket(_pi);
      if(!PositionSelectByTicket(_tk)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      if(PositionGetString(POSITION_SYMBOL) != sym) continue;
      double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      double sl        = PositionGetDouble(POSITION_SL);
      
      // Use stealth SL if broker SL is 0 (stealth mode)
      if(sl <= 0)
      {
         for(int _si = 0; _si < ArraySize(stealth_levels); _si++)
            if(stealth_levels[_si].ticket == _tk)
               { sl = stealth_levels[_si].sl; break; }
      }
      
      if(sl <= 0) return 50; // no SL found — safe fallback
      
      double slDist  = MathAbs(openPrice - sl);
      double threshold = slDist * (percent / 100.0);
      return (int)MathMax(1, MathRound(threshold / symPoint));
   }
   return 50; // no positions found — safe fallback
}
