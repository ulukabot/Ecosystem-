//+------------------------------------------------------------------+
//| ONTICK                                                            |
//+------------------------------------------------------------------+
void OnTick()
{

// Candle gate — detect new bar once per tick cycle
   bool isNewCandle = (iTime(_Symbol, PERIOD_CURRENT, 0) != g_last_candle_time);
   if(isNewCandle) g_last_candle_time = iTime(_Symbol, PERIOD_CURRENT, 0);

   if(!g_licence_valid) return;
   if(!CheckTierCompliance()) return;


   // 1. Floating DD check (every tick — always runs)
   CheckFloatingDrawdown(Floating_DD_Limit, trade, Magic_Number);
   
   // Guardian Angel - check every 30 seconds (not every tick)
   if(Enable_Guardian_Angel && TimeCurrent() - g_last_guardian_check >= 30)
   {
      GuardianAngel(Magic_Number, Guardian_Emergency_DD, trade, MyPersonalChatID, TG_API);
      g_last_guardian_check = TimeCurrent();
   }

   // 2. Smart gate — only on new candle (spread, kill switch, session, cooldown)
   if(isNewCandle && !UlukaSmartDecision(_Symbol, Magic_Number, MaxSpread)) return;

   // 3. Hourly licence check
   if(TimeCurrent() - g_last_licence_check >= 3600)
   {
      if(!ValidateLicence()) { ExpertRemove(); return; }
      g_last_licence_check = TimeCurrent();
   }

   // 4. Daily reset
   MqlDateTime curr; TimeToStruct(TimeCurrent(), curr);
   if(curr.day != g_last_reset_day)
   {
      g_daily_trades        = 0;
      g_daily_wins          = 0;
      g_daily_losses        = 0;
      g_daily_profit        = 0;
      g_daily_realized_pnl  = 0;
      g_daily_trades_Count  = 0;
      g_daily_peak_profit = 0.0;
      g_day_start_equity    = AccountInfoDouble(ACCOUNT_EQUITY);
      g_last_reset_day      = curr.day;
      g_daily_limit_hit     = false;  // File auto-expires (date-stamped)
      g_tier_breach_alerted = false;
      g_spread_alert_logged = false;
      g_margin_alert_shown  = false;
      g_free_hoots_today    = 0;
      G_LastRiskResetDay    = 0;
      g_discord_hoots_today = 0;
      g_trading_days_count++;
      Print("🌅 New Day | Start Equity: $", DoubleToString(g_day_start_equity, 2),
            " | Trading Days: ", g_trading_days_count);
   }

   // 5. End-of-day report (23:59 server time)
   MqlDateTime now_dt; TimeToStruct(TimeCurrent(), now_dt);
   if(now_dt.hour == 23 && now_dt.min == 59 &&
      TimeCurrent() - g_last_report_time > 3600)
   {
      SendDailyEODReport();
      g_last_report_time = TimeCurrent();
   }

// ─── NEWS STATE MANAGEMENT (Stealth ↔ Physical SL) ──────────
bool current_news = IsNewsWindowActive();

// --- State Change: OFF → ON (News Started) ---
if(current_news && !g_news_prev_state)
{
   Print("📰 NEWS STARTED: Converting Stealth SL → Physical SL for all positions.");
   g_converted_count = 0;  // Reset tracking array
   
   for(int i = 0; i < ArraySize(stealth_levels); i++)
   {
      ulong ticket = stealth_levels[i].ticket;
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      
      double sl = stealth_levels[i].sl;
      if(sl > 0 && PositionGetDouble(POSITION_SL) <= 0)
      {
         if(trade.PositionModify(ticket, sl, 0))
         {
            Print("🛡️ Converted #", ticket, " to physical SL: ", DoubleToString(sl, _Digits));
            // Track converted ticket for later revert
            if(g_converted_count < 50)
            {
               g_converted_tickets[g_converted_count] = ticket;
               g_converted_count++;
            }
         }
         else
         {
            Print("❌ Conversion failed for #", ticket, " Error: ", trade.ResultRetcodeDescription());
         }
      }
   }
   g_news_change_time = TimeCurrent();
}

// --- State Change: ON → OFF (News Ended) ---
if(!current_news && g_news_prev_state)
{
   Print("📰 NEWS ENDED: Reverting Physical SL → Stealth (0) for converted positions.");
   
   for(int i = 0; i < g_converted_count; i++)
   {
      ulong ticket = g_converted_tickets[i];
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      
      double current_broker_sl = PositionGetDouble(POSITION_SL);
      if(current_broker_sl > 0)  // Only revert physical SLs
      {
         if(trade.PositionModify(ticket, 0, 0))
         {
            Print("🔄 Reverted #", ticket, " back to stealth (0)");
         }
         else
         {
            Print("❌ Revert failed for #", ticket, " Error: ", trade.ResultRetcodeDescription());
         }
      }
   }
   g_converted_count = 0;
   g_news_change_time = TimeCurrent();
}

g_news_prev_state = current_news;

   // 7. Session filter
   if(Enable_Session_Filter && !IsSessionAllowed())
   {
      Comment("🦉 Session Closed: ", GetSessionName(), "\nWaiting for active session...");
      return;
   }
   
   // v17.28: Daily profit target cap — soft stop, existing trades continue
if(IsDailyProfitTargetHit((int)Profit_Target_Mode, g_daily_realized_pnl,
g_day_start_equity, Daily_Profit_Target, Daily_Profit_Percent))
{
Comment("🎯 [ULUKA] Daily profit target reached — no new trades today");
return;
}

   // 8. Daily loss limit
   g_daily_profit = AccountInfoDouble(ACCOUNT_EQUITY) - g_day_start_equity;
   if(Daily_Loss_Limit > 0 && g_daily_profit < 0 &&
      MathAbs(g_daily_profit / g_day_start_equity * 100.0) >= Daily_Loss_Limit)
   {
      if(!g_daily_limit_hit)
      {
         Custom_Alert("DailyLoss", "CRITICAL: Daily Loss Limit Reached!");
         g_daily_limit_hit = true;
         
         // v17.22 ISSUE-5: Persist to disk — blocks trades even after restart
         SaveDailyLimitHit();
         Print("📀 Daily DD saved to disk — active until midnight");


         // S30 FIX: Close all open positions immediately when limit hits
         Print("💀 Daily limit hit — closing all open positions...");
         CloseAllEAOrders(trade, Magic_Number);

         // T-14: Telegram "why" message
         double pnl_pct = MathAbs(g_daily_profit / g_day_start_equity * 100.0);
         string dlMsg = "🦉 <b>DAILY LIMIT REACHED</b>\n"
                      + "Account: " + IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN)) + "\n"
                      + "P&L today: -$" + DoubleToString(MathAbs(g_daily_profit), 2)
                      + " (-" + DoubleToString(pnl_pct, 1) + "%)\n"
                      + "All positions closed. Resumes at midnight. 🦉";
         SendToTelegram(MyPersonalChatID, dlMsg);
      }
      return;
   }

   // 9. Prop Firm compliance check
   if(Prop_Firm_Mode != PROP_NONE && Prop_Block_At_80Percent)
   {
      double dailyLossPct = (g_daily_profit < 0 && g_day_start_equity > 0) ?
                            MathAbs(g_daily_profit / g_day_start_equity * 100.0) : 0;
      double totalDDPct   = (g_initial_deposit > 0) ?
                            MathAbs((AccountInfoDouble(ACCOUNT_EQUITY) - g_initial_deposit) / g_initial_deposit * 100.0) : 0;

      if(!IsPropFirmCompliant(dailyLossPct, totalDDPct)) return;
   }

   // 10. News filter
   if(Use_News_Filter)
   {
      if(Filter_High_Impact && IsNewsTime(_Symbol, Mins_Before_News, Mins_After_News)) return;
      // v17.29: Pass EA inputs to medium news filter — fully user controlled
if(Filter_Medium_Impact && IsMediumNewsTime(_Symbol, Mins_Before_News, Mins_After_News)) return;
   }

  
   // 11. Trade cooldown — v17.23: dynamic buffer scales with timeframe
if(TimeCurrent() - g_last_trade_time < GetTradeTimeBuffer(g_CurrentTimeframe, Buffer_Time_Multiplier)) return;

   // 12. Position management (BE + Trailing + Partial)
   ManageInternalLevels();

   // 13. Read indicators
   double up[], lo[], atr[];
   ArraySetAsSeries(up,  true);
   ArraySetAsSeries(lo,  true);
   ArraySetAsSeries(atr, true);

   if(CopyBuffer(handle_bb,  1, 0, 3, up)  < 3) return;
   if(CopyBuffer(handle_bb,  2, 0, 3, lo)  < 3) return;
   if(CopyBuffer(handle_atr, 0, 0, 3, atr) < 3) return;

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   g_current_atr = atr[0];

              // ─── Signal Detection & Vote-Count System ───
   bool buySignal  = false;
   bool sellSignal = false;

   // Get aggregated signal from MQH
   ScoreSignalResult signal = GetScoreSignal(_Symbol, PERIOD_CURRENT,
                                             SymbolInfoDouble(_Symbol, SYMBOL_BID),
                                             SymbolInfoDouble(_Symbol, SYMBOL_ASK),
                                             handle_bb, handle_maFast, handle_maSlow);


   // ─── If no signal or tie, skip ─────────────────────────────
   if(signal.signalType == 0) { return; }

   // ─── Count strategies on the dominant side ──────────────────
   int count = 0;
   if(signal.signalType == 1) // BUY
   {
      if(signal.obBuy)       count++;
      if(signal.fvgBuy)      count++;
      if(signal.bosBuy)      count++;
      if(signal.chochBuy)    count++;
      if(signal.farsightBuy) count++;
      if(signal.visionBuy)   count++;
      if(signal.brBuy)       count++;   // 🔥 ADD THIS
   }
   else // SELL
   {
      if(signal.obSell)      count++;
      if(signal.fvgSell)     count++;
      if(signal.bosSell)     count++;
      if(signal.chochSell)   count++;
      if(signal.farsightSell)count++;
      if(signal.visionSell)  count++;
      if(signal.brSell)      count++;   // 🔥 ADD THIS
   }

     // ─── Skip if less than 2 strategies agree ───────────────────
   if(count < 2)
   {
      static datetime last_skip_print = 0;
      if(TimeCurrent() - last_skip_print >= 60)  // Print once per minute
      {
         if(G_DebugMode)Print("📊 Vote: ", count, " strategy(ies) → skip (<2)");
         last_skip_print = TimeCurrent();
      }
      return;
   }

         // ─── Determine risk based on vote count ─────────────────────
   double finalRisk = 0.0;
   if(count == 1)      finalRisk = 0.75;
   else if(count == 2) finalRisk = 1.00;
   else if(count == 3) finalRisk = 1.25;
   else if(count == 4) finalRisk = 1.50;
   else if(count == 5) finalRisk = 1.75;
   else if(count >= 6) finalRisk = 2.00;

   // ─── Cap risk at 2.0x absolute maximum ─────────────────────
   finalRisk = MathMin(2.00, finalRisk);

   g_score_risk_multiplier = finalRisk;

   // ─── Set signal ─────────────────────────────────────────────
   if(signal.signalType == 1)  buySignal = true;
   if(signal.signalType == -1) sellSignal = true;

   // ─── AI trend confirmation (optional safety) ──────────────
   if(buySignal  && Internal_AI_Sensor && !ULUKA_AI_Trend_Sensor_Confirm(ORDER_TYPE_BUY))  buySignal  = false;
   if(sellSignal && Internal_AI_Sensor && !ULUKA_AI_Trend_Sensor_Confirm(ORDER_TYPE_SELL)) sellSignal = false;
   
   // ─── Log the vote (throttled to once per minute) ──────────
   static datetime last_vote_print = 0;
   if(TimeCurrent() - last_vote_print >= 60)
   {
     if(G_DebugMode) Print("📊 Vote: ", count, " strategies | Risk=", DoubleToString(finalRisk, 2), "x");
      last_vote_print = TimeCurrent();
   }
   

      // ─── AI trend confirmation (optional safety) ──────────────
   if(buySignal  && Internal_AI_Sensor && !ULUKA_AI_Trend_Sensor_Confirm(ORDER_TYPE_BUY))  buySignal  = false;
   if(sellSignal && Internal_AI_Sensor && !ULUKA_AI_Trend_Sensor_Confirm(ORDER_TYPE_SELL)) sellSignal = false;

   // ─── Store signal for ExecuteTrade ─────────────────────────
   g_last_signal = signal;
   
      // ─── RUN SHADOW BR (Paper Trading, No Real Trades) ──────────
   RunBRShadow();
   MonitorBRPaperTrades();

      // ─── ONE TRADE PER BAR (Hardcoded) ───
   static datetime last_bar_trade_time = 0;
   static datetime last_print_time = 0;       // Throttle spam
   datetime current_bar_time = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(current_bar_time == last_bar_trade_time)
   {
      if(current_bar_time != last_print_time)
      {
         Print("⏳ Already successfully traded on this bar – skipping");
         last_print_time = current_bar_time;
      }
      return;
   }

// ─── Execute with Hybrid Flip (HTF + 50% Loss) ──────────────────
bool tradeExecuted = false;

if(buySignal && HasOppositePosition(_Symbol, ORDER_TYPE_BUY, Magic_Number))
{
    ENUM_TREND_BIAS htf = GetHTFBias(_Symbol, g_HTFTimeframe);
    bool htfSupportsBuy = (htf == BIAS_BULLISH || htf == BIAS_NEUTRAL);
    double lossPct = GetOppositeLossPercent(_Symbol, Magic_Number);
    
    if(htfSupportsBuy || lossPct > 50.0)
    {
        CloseAllEAOrdersDirection(_Symbol, ORDER_TYPE_SELL, Magic_Number, trade);
        Print("🔄 HYBRID FLIP: Closing SELL | HTF: ", EnumToString(htf), " | Loss: ", DoubleToString(lossPct, 1), "%");
        // buySignal remains true → opens BUY
    }
    else
    {
        buySignal = false;
        Print("⏳ HYBRID SKIP: Keeping SELL | HTF: ", EnumToString(htf), " | Loss: ", DoubleToString(lossPct, 1), "%");
    }
}

if(sellSignal && HasOppositePosition(_Symbol, ORDER_TYPE_SELL, Magic_Number))
{
    ENUM_TREND_BIAS htf = GetHTFBias(_Symbol, g_HTFTimeframe);
    bool htfSupportsSell = (htf == BIAS_BEARISH || htf == BIAS_NEUTRAL);
    double lossPct = GetOppositeLossPercent(_Symbol, Magic_Number);
    
    if(htfSupportsSell || lossPct > 50.0)
    {
        CloseAllEAOrdersDirection(_Symbol, ORDER_TYPE_BUY, Magic_Number, trade);
        Print("🔄 HYBRID FLIP: Closing BUY | HTF: ", EnumToString(htf), " | Loss: ", DoubleToString(lossPct, 1), "%");
        // sellSignal remains true → opens SELL
    }
    else
    {
        sellSignal = false;
        Print("⏳ HYBRID SKIP: Keeping BUY | HTF: ", EnumToString(htf), " | Loss: ", DoubleToString(lossPct, 1), "%");
    }
}

if(buySignal)
{
    g_is_vote_trade = true;
    if(ExecuteTrade(ORDER_TYPE_BUY, atr[0]))   // Master uses atr[]
        tradeExecuted = true;
}

if(sellSignal)
{
    g_is_vote_trade = true;
    if(ExecuteTrade(ORDER_TYPE_SELL, atr[0]))  // Master uses atr[]
        tradeExecuted = true;
}

// Only lock the bar if a trade was successfully opened
if(tradeExecuted)
    last_bar_trade_time = current_bar_time;

   // 17. Dashboard update
   UpdateDashboard();
}

