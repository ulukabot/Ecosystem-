//| GET HEALTH BAR (visual progress indicator)                       |
//+------------------------------------------------------------------+
string GetHealthBar(int score)
{
   int filled = (int)MathRound(score / 10.0);
   string bar = "";
   for(int i = 0; i < 10; i++)
   {
      if(i < filled) bar += "█";
      else           bar += "░";
   }
   return bar;
}

