int CalculateConfidence(string symbol, bool dnaBoost = false, string comboName = "")
{
   int score = 0;

   // ?? FACTOR 1: Market Regime (Max 25 pts) ??
   ENUM_MARKET_REGIME regime = DetectMarketRegime(symbol, PERIOD_CURRENT);
         switch(regime)
   {
      case REGIME_TRENDING: score += 25; break;
      case REGIME_RANGING:  score += 15; break;
      case REGIME_LOW_VOL:  score += 5;  break;
      case REGIME_CHAOTIC:  score -= 20; break;
   }

   // ?? FACTOR 2: Session Quality (Max 20 pts) ??
   score += GetSessionConfidenceBonus();

   // ?? FACTOR 3: Volume (Max 15 pts) ??
   score += GetVolumeConfidenceBonus(symbol, PERIOD_CURRENT);

   // ?? FACTOR 4: ATR Volatility (Max 20 pts) ??
   int atrHandle = iATR(symbol, PERIOD_CURRENT, 14);
   if(atrHandle != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrHandle, 0, 0, 50, atrBuf) >= 50)
      {
         double sumA = 0;
         for(int k = 1; k < 50; k++) sumA += atrBuf[k];
         double avgA = sumA / 49.0;
         if(avgA > 0)
         {
            double ratio = atrBuf[0] / avgA;
            if(ratio >= 0.8 && ratio <= 1.5)  score += 20;  // Ideal volatility
            else if(ratio >= 0.5 && ratio < 0.8) score += 10;
            else if(ratio > 1.5 && ratio <= 2.0) score += 5;
            else score -= 10;  // Too quiet or too explosive
         }
      }
      IndicatorRelease(atrHandle);
   }

   // ?? FACTOR 5: HTF Bias Alignment (Max 20 pts) ??
   // This is bonus — checked separately in strategy router
   ENUM_TREND_BIAS htfBias = GetHTFBias(symbol);
   if(htfBias != BIAS_NEUTRAL) score += 20;

   // ?? Capital Protection Mode penalty ??
   if(G_CapitalProtectionMode) score -= 15;

   // ?? FACTOR 6: DNA / Combo Confidence Boost ??
if(dnaBoost)
{
   if(comboName != "")
   {
      // Use combo confidence bonus
      score += GetComboConfidenceBonus(comboName);
   }
   else
   {
      // Use single-strategy DNA confidence bonus (existing logic)
      ENUM_STRATEGY strat = GetRecommendedStrategy(symbol, ORDER_TYPE_BUY);
      score += GetDNATotalConfidenceBonus(symbol, (int)strat);
   }
}

   // Factor 7: Premium/Discount Matrix using VWAP
   double vwap = 0, totalVol = 0;
   for(int i = 1; i <= 50; i++) {
      double typical = (iHigh(symbol, PERIOD_CURRENT, i) + iLow(symbol, PERIOD_CURRENT, i) + iClose(symbol, PERIOD_CURRENT, i)) / 3.0;
      long volume = iTickVolume(symbol, PERIOD_CURRENT, i);
      if(volume > 0) {
         vwap += typical * volume;
         totalVol += (double)volume;
      }
   }
   if(totalVol > 0) vwap /= totalVol;

   double atrVal = iATR(symbol, PERIOD_CURRENT, 14);
   double currentPrice = SymbolInfoDouble(symbol, SYMBOL_BID);
   if(currentPrice < vwap - 1.5 * atrVal) score += 15;   // Discount zone – bullish
   if(currentPrice > vwap + 1.5 * atrVal) score += 15;   // Premium zone – bearish

   // Note: FVG confluence already considered in strategy router; we just add extra points if FVG aligns with zone.
   // (Optional: add +5 if a recent FVG is inside the discount/premium zone)

   // Clamp to 0-100
   score = (int)MathMax(0, MathMin(100, score));

   // Throttle: print once per candle only (not every tick)
   static datetime s_last_conf_bar = 0;
   datetime cur_bar = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(cur_bar != s_last_conf_bar)
   {
      if(G_DebugMode) Print("📊 Confidence Score: ", score, "% | Session:", GetSessionName(),
            " | Regime:", EnumToString(regime));
      s_last_conf_bar = cur_bar;
   }

   return score;
}

int GetAdaptiveMinConfidence()
{
