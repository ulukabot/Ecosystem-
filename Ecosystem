bool ULUKA_AI_Trend_Sensor_Confirm(ENUM_ORDER_TYPE type)
{
   if(!Internal_AI_Sensor) return true;

   if(handle_maFast == INVALID_HANDLE || handle_maSlow == INVALID_HANDLE) return true;

   double maFast[], maSlow[];
   ArraySetAsSeries(maFast, true); ArraySetAsSeries(maSlow, true);
   bool ok = (CopyBuffer(handle_maFast, 0, 0, 3, maFast) >= 3 &&
              CopyBuffer(handle_maSlow, 0, 0, 3, maSlow) >= 3);

